{% schema %}
{
  "name": "SNC Trust Badges",
  "class": "section--snc-trust-badges",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo de la sección",
      "default": "#F1F1F1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding superior",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding inferior",
      "default": 10
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espacio entre elementos",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "invert_icons",
      "label": "Invertir color de iconos",
      "default": false
    },
    {
      "type": "header",
      "content": "Estilos de contenido"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Ancho del icono",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Título"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#0d0d0d"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Tamaño fuente título",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "label": "Grosor fuente título",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 400
    },
    {
      "type": "header",
      "content": "Párrafo"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color del párrafo",
      "default": "#6C6C6C"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Tamaño fuente párrafo",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "description_font_weight",
      "label": "Grosor fuente párrafo",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 400
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Icono de confianza",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icono"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Título",
          "default": "Envío gratis"
        },
        {
          "type": "liquid",
          "id": "description",
          "label": "Párrafo (HTML/Liquid)",
          "info": "Permite HTML y Liquid. Para un salto de línea simple, usa <br>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNC Trust Badges",
      "blocks": [
        { "type": "trust_badge", "settings": { "text": "30 Días De Garantía" } },
        { "type": "trust_badge", "settings": { "text": "Hecho En México A Mano" } },
        { "type": "trust_badge", "settings": { "text": "Cambios Sin Costo" } }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}

<style>
  .snc-trust-badges-section {
    width: 100%;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
    letter-spacing: -0.04em;
  }
  
  .snc-trust-badges-section.full-width {
    padding-left: 0;
    padding-right: 0;
    display: grid;
    grid-template-columns: var(--content-grid);
  }
  
  .snc-trust-badges-section.full-width > .snc-trust-badges--container {
    grid-column: 1 / -1;
    padding-left: 20px;
    padding-right: 20px;
  }

  .snc-trust-badges--container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .snc-trust-badges--grid {
    width: 100%;
    background: #ffffff;
    border-radius: 10px;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: start;
    flex-wrap: nowrap;
    gap: var(--gap);
    overflow-x: auto;
    box-sizing: border-box;
  }

  .snc-trust-badges--item {
    display: flex;
    flex-direction: column;
    align-items: var(--alignment-items, center);
    text-align: var(--alignment-text, center);
    gap: 10px;
    justify-content: center;
  }

  .snc-trust-badges--icon {
    width: var(--icon-width, 32px);
    height: var(--icon-width, 32px);
    flex-shrink: 0;
  }

  .snc-trust-badges--icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: var(--icon-filter);
  }

  .snc-trust-badges--text {
    font-family: var(--font-nunito, 'NunitoSans', sans-serif);
    font-size: var(--title-size, 14px);
    font-weight: var(--title-weight, 400);
    color: var(--title-color, #0d0d0d);
    line-height: 1.2;
  }

  .snc-trust-badges--description {
    font-family: var(--font-nunito, 'NunitoSans', sans-serif);
    font-size: var(--desc-size, 12px);
    font-weight: var(--desc-weight, 400);
    color: var(--desc-color, #6C6C6C);
    line-height: 1.4;
    margin-top: -5px;
  }
  .snc-trust-badges--description p {
    margin: 0;
  }
  
  @media (max-width: 900px) {
    .snc-trust-badges--grid {
      justify-content: center;
      padding: 20px;
    }
    .snc-trust-badges--item {
      flex: 0 0 calc(50% - 10px);
    }
  }
  
  @media (max-width: 600px) {
    .snc-trust-badges-section {
        padding-left: 0;
        padding-right: 0;
    }
    .snc-trust-badges--container {
        padding-left: 15px;
        padding-right: 15px;
    }
    .snc-trust-badges--grid {
      flex-direction: column;
      gap: var(--gap);
      padding: 15px;
    }
    .snc-trust-badges--item {
      flex: 1 1 100%;
    }
    .snc-trust-badges--text {
      font-size: 13px;
    }
  }
</style>

<div class="snc-trust-badges-section {% if section.settings.full_width %}full-width{% endif %}"
     style="
       --icon-width: {{ section.settings.icon_width }}px;
       --title-color: {{ section.settings.title_color }};
       --title-size: {{ section.settings.title_font_size }}px;
       --title-weight: {{ section.settings.title_font_weight }};
       --desc-color: {{ section.settings.description_color }};
       --desc-size: {{ section.settings.description_font_size }}px;
       --desc-weight: {{ section.settings.description_font_weight }};
       --gap: {{ section.settings.gap }}px;
       --icon-filter: {% if section.settings.invert_icons %}invert(1){% else %}none{% endif %};
       {% case section.settings.alignment %}
         {% when 'left' %}--alignment-items: flex-start; --alignment-text: left;
         {% when 'right' %}--alignment-items: flex-end; --alignment-text: right;
         {% else %}--alignment-items: center; --alignment-text: center;
       {% endcase %}
     ">
  <div class="snc-trust-badges--container">
    <div class="snc-trust-badges--grid">
      {%- for block in section.blocks -%}
        <div class="snc-trust-badges--item" {{ block.shopify_attributes }}>
          <div class="snc-trust-badges--icon">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.text }}
            {%- else -%}
              <img src="{{ 'solar_shield-outline.svg' | asset_url }}" alt="" width="39" height="39" loading="lazy">
            {%- endif -%}
          </div>
          {%- if block.settings.text != blank -%}
            <span class="snc-trust-badges--text">{{ block.settings.text }}</span>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <div class="snc-trust-badges--description">{{ block.settings.description }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>