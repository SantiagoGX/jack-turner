{% javascript %}
  (function () {
    /* ─── Footer Legacy Club — Klaviyo Client API v3 subscribe ─────────────────
       Intercepts the footer signup form submit, calls Klaviyo directly to
       subscribe the email to list TWy4DM, then shows a success state.
       The native Shopify form is NOT submitted (no redirect; pure JS flow).
    ──────────────────────────────────────────────────────────────────────────── */

    var KLAVIYO_COMPANY_ID = 'X2CxYi';
    var KLAVIYO_LIST_ID    = 'TWy4DM';
    var KLAVIYO_ENDPOINT   =
      'https://a.klaviyo.com/client/subscriptions/?company_id=' + KLAVIYO_COMPANY_ID;

    /* Locate every footer Legacy Club form on the page (handles multi-section edge cases). */
    var forms = document.querySelectorAll('.snc-footer__legacy-club-form');
    if (!forms.length) return;

    forms.forEach(function (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var emailInput = form.querySelector('input[type="email"]');
        if (!emailInput || !emailInput.value.trim()) return;

        var email      = emailInput.value.trim();
        var nameInput  = form.querySelector('input[type="text"]');
        var firstName  = nameInput ? nameInput.value.trim() : '';
        var submitBtn  = form.querySelector('.snc-footer__legacy-submit');
        var fieldsDiv  = form.querySelector('.snc-footer__legacy-fields');

        /* Disable button while in-flight */
        if (submitBtn) {
          submitBtn.disabled    = true;
          submitBtn.style.opacity = '0.55';
        }

        fetch(KLAVIYO_ENDPOINT, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            'revision':      '2024-10-15'
          },
          body: JSON.stringify({
            data: {
              type: 'subscription',
              attributes: {
                profile: {
                  data: {
                    type: 'profile',
                    attributes: Object.assign({ email: email }, firstName ? { first_name: firstName } : {})
                  }
                }
              },
              relationships: {
                list: { data: { type: 'list', id: KLAVIYO_LIST_ID } }
              }
            }
          })
        })
        .then(function (res) {
          if (res.ok || res.status === 202) {
            /* Success — hide the fields, show success message */
            if (fieldsDiv) fieldsDiv.style.display = 'none';

            var successMsg = form.querySelector('.snc-footer__legacy-message');
            if (!successMsg) {
              successMsg = document.createElement('div');
              successMsg.className = 'snc-footer__legacy-message';
              form.appendChild(successMsg);
            }
            successMsg.textContent = 'Thank you — you\'ve joined the Legacy Club.';
            successMsg.style.display = 'block';
          } else {
            /* Non-2xx response: re-enable button, silent fail */
            if (submitBtn) {
              submitBtn.disabled    = false;
              submitBtn.style.opacity = '';
            }
          }
        })
        .catch(function () {
          /* Network error: re-enable button, silent fail */
          if (submitBtn) {
            submitBtn.disabled    = false;
            submitBtn.style.opacity = '';
          }
        });
      });
    });
  })();
{% endjavascript %}

{%- if section.settings.brand_logo_lightbox and section.settings.brand_logo_image != blank -%}
<script>
document.addEventListener('DOMContentLoaded', function () {
  var lightbox = document.getElementById('snc-logo-lightbox-{{ section.id }}');
  var trigger  = document.querySelector('#shopify-section-{{ section.id }} [data-logo-lightbox-trigger]');
  if (!lightbox || !trigger) return;

  function openLogo() {
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    var stage = lightbox.querySelector('.snc-footer__logo-lightbox-stage');
    if (stage) {
      stage.style.animation = 'none';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { stage.style.animation = ''; });
      });
    }
  }

  function closeLogo() {
    lightbox.hidden = true;
    document.body.style.overflow = '';
  }

  trigger.addEventListener('click', openLogo);

  lightbox.querySelectorAll('[data-logo-lightbox-close]').forEach(function (el) {
    el.addEventListener('click', closeLogo);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !lightbox.hidden) closeLogo();
  });
});
</script>
{%- endif -%}

