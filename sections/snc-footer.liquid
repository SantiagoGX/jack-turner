<style>
  /* NOTA: Si 'Futura PT' no está cargada en el tema, pega aquí el @import de Adobe Fonts/Typekit */
  /* Estilos Estructurales Base */
  .snc-footer {
    width: 100%;
    height: auto;
    padding: 20px 0;
    display: flex;
    justify-content: center;
  }

  .snc-footer--container {
    width: 100%;
    max-width: 1512px;
    height: auto;
    padding: 20px;
    background-color: #ffffff;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  /* Estilos Marquee Estático (Fila 1) */
  .snc-footer__marquee-static {
    width: 100vw; /* Fuerza ancho completo de pantalla */
    margin-left: calc(50% - 50vw); /* Centra y rompe el contenedor padre */
    overflow: hidden;
    display: flex;
    justify-content: flex-start;
    
    /* Estilos Dinámicos */
    background-color: {{ section.settings.marquee_bg_color }};
    padding: {{ section.settings.marquee_padding_vertical }}px 0;
    margin-top: {{ section.settings.marquee_margin_top }}px;
    margin-bottom: {{ section.settings.marquee_margin_bottom }}px;
  }

  .snc-footer__marquee-track {
    display: flex;
    width: max-content;
    animation: snc-marquee-scroll {{ section.settings.marquee_speed }}s linear infinite;
  }

  .snc-footer__marquee-item {
    display: block;
    height: {{ section.settings.marquee_image_height }}px;
    width: auto;
    object-fit: contain;
    margin-right: {{ section.settings.marquee_gap }}px;
  }

  @keyframes snc-marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Estilos Info Row (Fila 2) */
  .snc-footer__info-row {
    width: 100%;
    max-width: 1372px;
    margin: 0 auto;
    min-height: 220px; /* Hug 220px */
    padding: 40px 0 20px 0;
    display: flex;
    justify-content: flex-start;
  }

  .snc-footer__info-row-inner {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: clamp(28px, 4vw, 56px);
  }

  .snc-footer__info-wrapper {
    width: 100%;
    max-width: 1130px;
    margin: 0;
    min-height: 100px;
    display: flex;
    justify-content: flex-start;
    gap: {{ section.settings.info_columns_gap }}px;
    flex: 1 1 auto;
    min-width: 0;
  }

  .snc-footer__legacy-club {
    flex: 0 0 auto;
    width: 100%;
    max-width: {{ section.settings.legacy_club_max_width }}px;
    padding-left: clamp(20px, 3vw, 36px);
    border-left: {{ section.settings.legacy_club_border_width }}px solid {{ section.settings.legacy_club_border_color }};
  }

  /* ── Logo de Marca ────────────────────────────────────── */
  .snc-footer__brand-logo {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 clamp(12px, 2vw, 28px);
  }

  .snc-footer__brand-logo-link {
    display: block;
    line-height: 0;
    cursor: pointer;
    text-decoration: none;
  }

  .snc-footer__brand-logo-link[href='']:not(.snc-footer__brand-logo--lightbox),
  .snc-footer__brand-logo-link:not([href]):not(.snc-footer__brand-logo--lightbox) {
    cursor: default;
    pointer-events: none;
  }

  button.snc-footer__brand-logo-link {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    -webkit-appearance: none;
    appearance: none;
  }

  .snc-footer__brand-logo--lightbox {
    cursor: pointer;
  }

  .snc-footer__brand-logo-img {
    display: block;
    width: {{ section.settings.brand_logo_size }}px;
    height: {{ section.settings.brand_logo_size }}px;
    object-fit: cover;
    border: 1px solid {{ section.settings.brand_logo_border_color | default: '#c9b99a' }};
    border-radius: {% if section.settings.brand_logo_shape == 'circle' %}50%{% else %}0{% endif %};
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.28s ease;
  }

  .snc-footer__brand-logo-link:hover .snc-footer__brand-logo-img {
    transform: scale(1.03);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.14);
  }

  /* Placeholder shown when no image is uploaded */
  .snc-footer__brand-logo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.brand_logo_size }}px;
    height: {{ section.settings.brand_logo_size }}px;
    border: 1px dashed {{ section.settings.brand_logo_border_color | default: '#c9b99a' }};
    border-radius: {% if section.settings.brand_logo_shape == 'circle' %}50%{% else %}0{% endif %};
    opacity: 0.45;
  }

  .snc-footer__brand-logo-placeholder::before {
    content: '';
    display: block;
    width: 18px;
    height: 1px;
    background: currentColor;
    position: absolute;
  }

  .snc-footer__brand-logo-placeholder::after {
    content: '';
    display: block;
    width: 1px;
    height: 18px;
    background: currentColor;
    position: absolute;
  }

  @media (max-width: 768px) {
    .snc-footer__brand-logo {
      padding: 0;
      justify-content: flex-start;
    }
  }

  .snc-footer__legacy-club-heading {
    margin: 0 0 10px;
    font-family: var(--font-heading-family, 'Futura PT', Futura, sans-serif);
    font-size: {{ section.settings.legacy_club_title_size }}px;
    font-weight: {{ section.settings.legacy_club_title_weight }};
    letter-spacing: 0.18em;
    line-height: 1.25;
    text-transform: uppercase;
    color: {{ section.settings.legacy_club_title_color }};
  }

  .snc-footer__legacy-club-sub {
    margin: 0 0 14px;
    font-family: var(--font-body-family, 'Futura PT', Futura, sans-serif);
    font-size: {{ section.settings.legacy_club_sub_size }}px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.legacy_club_sub_color }};
    opacity: 0.88;
  }

  .snc-footer__legacy-club-intro {
    margin: 0 0 10px;
    font-size: {{ section.settings.legacy_club_body_size }}px;
    font-weight: {{ section.settings.legacy_club_body_weight }};
    line-height: 1.55;
    color: {{ section.settings.legacy_club_body_color }};
  }

  .snc-footer__legacy-club-list {
    margin: 0 0 14px;
    padding-left: 1rem;
    font-size: {{ section.settings.legacy_club_body_size }}px;
    font-weight: {{ section.settings.legacy_club_body_weight }};
    line-height: 1.5;
    color: {{ section.settings.legacy_club_body_color }};
  }

  .snc-footer__legacy-club-list li {
    margin-bottom: 6px;
  }

  .snc-footer__legacy-club-closing {
    margin: 0 0 18px;
    font-size: {{ section.settings.legacy_club_closing_size }}px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.legacy_club_closing_color }};
    opacity: 0.85;
  }

  .snc-footer__legacy-club-form .snc-footer__legacy-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .snc-footer__legacy-input {
    min-width: 0;
    padding: 12px 14px;
    border: 1px solid {{ section.settings.legacy_club_input_border }};
    border-radius: 0;
    background: {{ section.settings.legacy_club_input_bg }};
    color: {{ section.settings.legacy_club_input_text }};
    font-family: var(--font-body-family, 'Futura PT', Futura, sans-serif);
    font-size: 14px;
    letter-spacing: 0.03em;
  }

  .snc-footer__legacy-input::placeholder {
    color: {{ section.settings.legacy_club_input_text }};
    opacity: 0.4;
  }

  .snc-footer__legacy-submit {
    grid-column: 1 / -1;
    padding: 12px 18px;
    border: 1px solid {{ section.settings.legacy_club_btn_border }};
    border-radius: 0;
    background: {{ section.settings.legacy_club_btn_bg }};
    color: {{ section.settings.legacy_club_btn_text }};
    font-family: var(--font-heading-family, 'Futura PT', Futura, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .snc-footer__legacy-submit:hover {
    opacity: 0.88;
  }

  .snc-footer__legacy-message {
    margin-top: 10px;
    font-size: 13px;
    color: {{ section.settings.legacy_club_body_color }};
  }

  .snc-footer__legacy-message--error {
    color: #b00020;
  }

  .snc-footer__legacy-visually-hidden {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }

  .snc-footer__column {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .snc-footer__column-title {
    font-family: 'Futura PT', 'Futura', sans-serif;
    margin: 0;
    line-height: 1.2;
  }

  .snc-footer__column-title a {
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .snc-footer__column-title a:hover {
    opacity: 0.7;
  }

  .snc-footer__column-content ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .snc-footer__column-content a {
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .snc-footer__column-content a:hover {
    opacity: 0.7;
  }

  /* Estilos Legal Row (Fila 3) */
  .snc-footer__legal-row {
    width: calc(100% + 40px);
    margin-left: -20px;
    margin-right: -20px;
    min-height: 72px; /* Hug 72px */
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: {{ section.settings.legal_rows_gap }}px;
  }

  .snc-footer__legal-top {
    width: 100%;
    padding-bottom: 0;
    padding-top: 30px;
    border-top: {{ section.settings.divider_thickness }}px solid {{ section.settings.divider_color }};
  }

  .snc-footer__legal-bottom {
    width: 100%;
    padding-top: 30px;
    border-top: {{ section.settings.divider_thickness }}px solid {{ section.settings.divider_color }};
  }

  .snc-footer__legal-inner {
    width: 100%;
    max-width: 1372px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .snc-footer__social-icons {
    display: flex;
    gap: 15px;
    align-items: center;
  }

  .snc-footer__social-icon-img {
    width: 24px;
    height: 24px;
    display: block;
    object-fit: contain;
  }

  .snc-footer__brand-name {
    color: {{ section.settings.legal_brand_color }};
    font-size: {{ section.settings.legal_brand_size }}px;
    font-weight: {{ section.settings.legal_brand_weight }};
  }

  .snc-footer__legal-links {
    display: flex;
    gap: 20px;
  }

  .snc-footer__legal-links a {
    text-decoration: none;
    color: {{ section.settings.legal_links_color }};
    font-size: {{ section.settings.legal_links_size }}px;
    font-weight: {{ section.settings.legal_links_weight }};
  }

  .snc-footer__copyright {
    color: {{ section.settings.legal_copyright_color }};
    font-size: {{ section.settings.legal_copyright_size }}px;
    font-weight: {{ section.settings.legal_copyright_weight }};
  }

  @media (max-width: 768px) {
    .snc-footer__info-row {
      height: auto;
      padding: 20px;
    }
    .snc-footer__info-row-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 36px;
    }

    .snc-footer__legacy-club {
      max-width: none;
      padding-left: 0;
      border-left: none;
      padding-top: 28px;
      border-top: {{ section.settings.legacy_club_border_width }}px solid {{ section.settings.legacy_club_border_color }};
    }

    .snc-footer__info-wrapper {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 20px;
    }
    .snc-footer__legal-row {
      flex-direction: column;
      height: auto;
      gap: 20px;
    }
    .snc-footer__legal-inner {
      flex-direction: column;
      gap: 15px;
      text-align: center;
    }
    .snc-footer__legal-links {
      flex-direction: column;
      gap: 10px;
    }
  }

  /* ── Logo Lightbox ───────────────────────────────────── */
  .snc-footer__logo-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9990;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .snc-footer__logo-lightbox[hidden] {
    display: none;
  }

  .snc-footer__logo-lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(13, 13, 13, 0.96);
    cursor: pointer;
  }

  .snc-footer__logo-lightbox-stage {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 0 24px;
    animation: snc-logo-lightbox-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes snc-logo-lightbox-in {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .snc-footer__logo-lightbox-close {
    position: static;
    align-self: flex-end;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    padding: 0 0 18px 0;
    cursor: pointer;
    color: rgba(244, 242, 239, 0.4);
    transition: color 0.25s ease;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 10px;
    font-family: var(--font-heading-family);
    line-height: 1;
  }

  .snc-footer__logo-lightbox-close:hover {
    color: rgba(244, 242, 239, 0.88);
  }

  .snc-footer__logo-lightbox-close::before {
    content: '';
    display: block;
    width: 18px;
    height: 1px;
    background: currentColor;
  }

  .snc-footer__logo-lightbox-close-x {
    display: none;
  }

  .snc-footer__logo-lightbox-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .snc-footer__logo-lightbox-img {
    display: block;
    max-width: min(480px, 90vw);
    max-height: 80vh;
    width: auto;
    height: auto;
    border: 1px solid rgba(201, 196, 188, 0.2);
    box-shadow:
      0 0 60px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(139, 115, 85, 0.1);
  }

  .snc-footer__logo-lightbox-caption {
    font-family: var(--font-heading-family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: rgba(201, 196, 188, 0.45);
    margin: 0;
  }
</style>

<footer class="snc-footer">
  <div class="snc-footer--container">
    <div class="snc-footer__marquee-static">
      <div class="snc-footer__marquee-track">
        {%- comment -%} Repetimos la imagen suficientes veces para cubrir pantallas grandes y permitir el loop (2 sets de 15) {%- endcomment -%}
        {%- for i in (1..30) -%}
          {%- if section.settings.marquee_image != blank -%}
            {{ section.settings.marquee_image | image_url: height: 200 | image_tag: class: 'snc-footer__marquee-item', loading: 'lazy' }}
          {%- else -%}
            <div class="snc-footer__marquee-item" style="background-color: #e0e0e0; height: 50px; display: flex; align-items: center; justify-content: center; color: #999;">IMG</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="snc-footer__info-row">
      <div class="snc-footer__info-row-inner">
        <div class="snc-footer__info-wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign column_title = block.settings.title
              assign column_title_url = block.settings.title_url
              assign column_content = block.settings.content

              if block.type == 'menu_column'
                assign menu_handle = block.settings.menu
                assign menu_obj = linklists[menu_handle]

                assign column_title = block.settings.title_override
                if column_title == blank and menu_obj != blank
                  assign column_title = menu_obj.title
                endif
              endif
            -%}
            <div class="snc-footer__column" {{ block.shopify_attributes }} style="
              margin-top: {{ block.settings.margin_top }}px;
              margin-bottom: {{ block.settings.margin_bottom }}px;
              margin-left: {{ block.settings.margin_left }}px;
              margin-right: {{ block.settings.margin_right }}px;
            ">
              {%- if column_title != blank -%}
                <h3 class="snc-footer__column-title" style="
                  color: {{ block.settings.title_color }};
                  font-size: {{ block.settings.title_size }}px;
                  font-weight: {{ block.settings.title_weight }};
                  margin-bottom: {{ block.settings.title_margin_bottom }}px;
                ">
                  {%- if column_title_url != blank -%}
                    <a href="{{ column_title_url }}">{{ column_title }}</a>
                  {%- else -%}
                    {{ column_title }}
                  {%- endif -%}
                </h3>
              {%- endif -%}
              <div class="snc-footer__column-content" style="
                color: {{ block.settings.link_color }};
                font-size: {{ block.settings.link_size }}px;
                font-weight: {{ block.settings.link_weight }};
              ">
                {%- if block.type == 'menu_column' -%}
                  {%- if menu_obj != blank and menu_obj.links.size > 0 -%}
                    <ul>
                      {%- for link in menu_obj.links -%}
                        <li>
                          <a href="{{ link.url }}">{{ link.title | escape }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    {{ column_content }}
                  {%- endif -%}
                {%- else -%}
                  {{ column_content }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_brand_logo -%}
          <div class="snc-footer__brand-logo">
            {%- assign logo_tag = 'span' -%}
            {%- if section.settings.brand_logo_lightbox and section.settings.brand_logo_image != blank -%}
              {%- assign logo_tag = 'button' -%}
            {%- elsif section.settings.brand_logo_url != blank -%}
              {%- assign logo_tag = 'a' -%}
            {%- endif -%}

            {%- if section.settings.brand_logo_image != blank -%}
              <{{ logo_tag }}
                class="snc-footer__brand-logo-link{% if section.settings.brand_logo_lightbox and section.settings.brand_logo_image != blank %} snc-footer__brand-logo--lightbox{% endif %}"
                {%- if logo_tag == 'a' -%}
                  href="{{ section.settings.brand_logo_url }}"
                {%- endif -%}
                {%- if logo_tag == 'button' -%}
                  type="button"
                  data-logo-lightbox-trigger
                  aria-label="Ver imagen completa"
                {%- endif -%}
              >
                {{
                  section.settings.brand_logo_image
                  | image_url: width: 400
                  | image_tag:
                    class: 'snc-footer__brand-logo-img',
                    loading: 'lazy',
                    alt: section.settings.brand_logo_alt | default: 'Jack Turner',
                    widths: '100, 120, 140, 160, 200, 240, 300, 400'
                }}
              </{{ logo_tag }}>

              {%- if section.settings.brand_logo_lightbox -%}
                <div
                  class="snc-footer__logo-lightbox"
                  id="snc-logo-lightbox-{{ section.id }}"
                  role="dialog"
                  aria-modal="true"
                  aria-label="{{ section.settings.brand_logo_alt | default: 'Jack Turner' }}"
                  hidden
                >
                  <div class="snc-footer__logo-lightbox-backdrop" data-logo-lightbox-close></div>
                  <div class="snc-footer__logo-lightbox-stage">
                    <button
                      class="snc-footer__logo-lightbox-close"
                      data-logo-lightbox-close
                      aria-label="Cerrar"
                      type="button"
                    >
                      <span class="snc-footer__logo-lightbox-close-x" aria-hidden="true">&#x2715;</span>
                      <span>Close</span>
                    </button>
                    <figure class="snc-footer__logo-lightbox-figure">
                      {{
                        section.settings.brand_logo_image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'snc-footer__logo-lightbox-img',
                          loading: 'lazy',
                          alt: section.settings.brand_logo_alt | default: 'Jack Turner',
                          widths: '400, 600, 800, 1000, 1200'
                      }}
                      <figcaption class="snc-footer__logo-lightbox-caption">Jack Turner</figcaption>
                    </figure>
                  </div>
                </div>
              {%- endif -%}
            {%- else -%}
              {%- comment -%} Placeholder visible solo en el editor de Shopify {%- endcomment -%}
              {%- if request.design_mode -%}
                <span
                  class="snc-footer__brand-logo-placeholder"
                  title="Sube el logo del Footer en los ajustes de esta sección"
                  style="position:relative;"
                ></span>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_legacy_club -%}
          <aside class="snc-footer__legacy-club">
            <h3 class="snc-footer__legacy-club-heading">{{ 'legacy_club.title' | t }}</h3>
            <p class="snc-footer__legacy-club-sub">{{ 'legacy_club.subhead' | t }}</p>
            <p class="snc-footer__legacy-club-intro">{{ 'legacy_club.body_intro' | t }}</p>
            <ul class="snc-footer__legacy-club-list">
              <li>{{ 'legacy_club.bullet_1' | t }}</li>
              <li>{{ 'legacy_club.bullet_2' | t }}</li>
              <li>{{ 'legacy_club.bullet_3' | t }}</li>
            </ul>
            <p class="snc-footer__legacy-club-closing">{{ 'legacy_club.closing' | t }}</p>
            {%- assign footer_legacy_form_id = 'snc-legacy-footer-' | append: section.id -%}
            <form
              id="{{ footer_legacy_form_id }}"
              class="snc-footer__legacy-club-form"
              novalidate
            >
              <div class="snc-footer__legacy-fields">
                <label class="snc-footer__legacy-visually-hidden" for="snc-legacy-footer-name-{{ section.id }}">
                  First name
                </label>
                <input
                  type="text"
                  id="snc-legacy-footer-name-{{ section.id }}"
                  class="snc-footer__legacy-input"
                  autocomplete="given-name"
