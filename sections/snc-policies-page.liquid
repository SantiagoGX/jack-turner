{% comment %}
  Renders Shopify policy pages (privacy policy, terms of service, refund policy, etc.).
  Used by `templates/policy.liquid`.
{% endcomment %}

{%- liquid
  assign max_width = section.settings.max_width
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<section
  class="snc-policy"
  style="
    --snc-policy-max-width: {{ max_width }}px;
    --snc-policy-padding-top: {{ padding_top }}px;
    --snc-policy-padding-bottom: {{ padding_bottom }}px;
    --snc-policy-title-color: {{ section.settings.title_color }};
    --snc-policy-text-color: {{ section.settings.text_color }};
    --snc-policy-muted-color: {{ section.settings.muted_color }};
    --snc-policy-accent: {{ section.settings.accent_color }};
  "
>
  <div class="snc-policy__inner">
    <header class="snc-policy__header">
      <h1 class="snc-policy__title">{{ policy.title | default: page_title | escape }}</h1>
      {%- if section.settings.show_updated_at and policy.updated_at -%}
        <div class="snc-policy__meta">
          Last updated {{ policy.updated_at | date: '%b %d, %Y' }}
        </div>
      {%- endif -%}
    </header>

    <div class="snc-policy__content rte">
      {%- if policy.body != blank -%}
        {{ policy.body }}
      {%- else -%}
        <p>{{ section.settings.empty_text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .snc-policy {
    padding-top: calc(var(--snc-policy-padding-top) + var(--custom-header-total-height, 0px));
    padding-bottom: var(--snc-policy-padding-bottom);
  }

  .snc-policy__inner {
    max-width: var(--snc-policy-max-width);
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .snc-policy__header {
    text-align: center;
    margin-bottom: 34px;
  }

  .snc-policy__title {
    margin: 0 0 10px 0;
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 4vw, 40px);
    line-height: 1.15;
    font-weight: 500;
    color: var(--snc-policy-title-color);
  }

  .snc-policy__meta {
    font-family: var(--font-body-family);
    font-size: 13px;
    color: var(--snc-policy-muted-color);
  }

  .snc-policy__content {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 1.75;
    color: var(--snc-policy-text-color);
  }

  .snc-policy__content h2,
  .snc-policy__content h3,
  .snc-policy__content h4 {
    font-family: var(--font-heading-family);
    color: var(--snc-policy-title-color);
    font-weight: 500;
    line-height: 1.2;
    margin: 2em 0 0.8em;
  }

  .snc-policy__content p {
    margin: 0 0 1.2em;
  }

  .snc-policy__content a {
    color: var(--snc-policy-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .snc-policy__content ul,
  .snc-policy__content ol {
    padding-left: 1.2em;
    margin: 0 0 1.2em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SNC Policies Page",
  "class": "section--snc-policy",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 420,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Max width",
      "default": 760
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "show_updated_at",
      "label": "Show last updated date",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty policy text",
      "default": "This policy is not available."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Meta color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Link color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "SNC Policies Page"
    }
  ]
}
{% endschema %}

