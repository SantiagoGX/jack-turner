        <a href="{{ wishlist_url }}" class="custom-header--burger-icon-link custom-header--burger-wishlist" aria-label="Favorites">
          <img
            src="{% if drawer_icon_wishlist != blank %}{{ drawer_icon_wishlist | image_url: width: 46 }}{% else %}{{ 'favorite.svg' | asset_url }}{% endif %}"
            alt="Favorites"
            class="custom-header--burger-icon-img{% if drawer_icon_wishlist != blank %} no-filter{% endif %}"
            width="20"
            height="20"
            loading="eager"
          >
          <span class="custom-header--burger-wishlist-count" style="display: none;">0</span>
        </a>
      </div>
      
      <button 
        class="custom-header--burger-close"
        data-burger-close
        aria-label="Close menu"
        type="button"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="custom-header--burger-close-icon">
          <path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {%- assign search_placeholder = mobile_drawer_block.settings.search_placeholder | default: 'Search...' -%}
    <div class="custom-header--burger-search-container">
      <form action="{{ routes.search_url }}" method="get" class="custom-header--burger-search-form">
        <button type="submit" class="custom-header--burger-search-submit" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <input type="text" name="q" placeholder="{{ search_placeholder | escape }}" class="custom-header--burger-search-input">
      </form>
    </div>

    {%- comment -%} Contenido del menú {%- endcomment -%}
    <div class="custom-header--burger-content">
      {%- comment -%} Navegación principal configurable por menú {%- endcomment -%}
      <nav class="custom-header--burger-nav">
        <ul class="custom-header--burger-nav-list" style="gap: {{ mobile_drawer_menu_gap }}px;">
          {%- if overlay_menu != blank and overlay_menu.links.size > 0 -%}
            {%- assign enable_advanced_colors = false -%}
            {%- if mobile_drawer_block -%}
              {%- assign enable_advanced_colors = mobile_drawer_block.settings.enable_advanced_colors -%}
            {%- elsif burger_block -%}
              {%- assign enable_advanced_colors = burger_block.settings.enable_advanced_colors -%}
            {%- endif -%}
            {%- for link in overlay_menu.links -%}
              <li class="custom-header--burger-nav-item" data-burger-item>
                <a 
                  href="{{ link.url }}" 
                class="custom-header--burger-nav-link"
                  {% if link.links.size > 0 %}data-burger-submenu-trigger{% endif %}
              >
                  <span>
                    {%- if enable_advanced_colors -%}
                      {%- for i in (1..20) -%}
                        {%- assign name_key = 'color_name_' | append: i -%}
                        {%- assign hex_key = 'color_hex_' | append: i -%}
                        {%- assign setting_name = settings[name_key] | downcase | strip -%}
                        {%- assign link_title_lower = link.title | downcase | strip -%}
                        {%- if setting_name != blank and setting_name == link_title_lower -%}
                          <span class="snc-color-swatch" style="--swatch-color: {{ settings[hex_key] }};"></span>
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {{ link.title }}
                  </span>
                  {%- if link.links.size > 0 -%}
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" class="custom-header--burger-arrow">
                  <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
                </a>
                
                {%- if link.links.size > 0 -%}
                  <div class="custom-header--burger-submenu">
                  <div class="custom-header--burger-submenu-content">
                      <ul class="custom-header--burger-subnav">
                        {%- for child in link.links -%}
                          <li>
                            <a href="{{ child.url }}">
                              {%- if enable_advanced_colors -%}
                                {%- for i in (1..20) -%}
                                  {%- assign name_key = 'color_name_' | append: i -%}
                                  {%- assign hex_key = 'color_hex_' | append: i -%}
                                  {%- assign setting_name = settings[name_key] | downcase | strip -%}
                                  {%- assign child_title_lower = child.title | downcase | strip -%}
                                  {%- if setting_name != blank and setting_name == child_title_lower -%}
                                    <span class="snc-color-swatch" style="--swatch-color: {{ settings[hex_key] }};"></span>
                                    {%- break -%}
                                  {%- endif -%}
                                {%- endfor -%}
                              {%- endif -%}
                              {{ child.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                  </div>
                </div>
              {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="custom-header--burger-nav-item custom-header--burger-nav-item--empty">
              <span>Asigna un menú lateral desde la configuración de la sección.</span>
            </li>
          {%- endif -%}
        </ul>
      </nav>

      {%- assign show_footer_content = true -%}
      {%- if mobile_drawer_block -%}
        {%- assign show_footer_content = mobile_drawer_block.settings.show_footer_content -%}
      {%- endif -%}

      {%- if show_footer_content -%}
      {%- comment -%} Bloque editorial {%- endcomment -%}
      {%- if mobile_drawer_block -%}
        {%- assign final_editorial_text = mobile_drawer_block.settings.editorial_text -%}
      {%- else -%}
        {%- assign final_editorial_text = burger_block.settings.editorial_text -%}
      {%- endif -%}

      {%- if final_editorial_text != blank -%}
        <div class="custom-header--burger-editorial">
          <p class="custom-header--burger-editorial-text">{{ final_editorial_text }}</p>
        </div>
      {%- endif -%}

      {%- comment -%} Redes sociales {%- endcomment -%}
      <div class="custom-header--burger-social">
        {%- assign fb_url = settings.social_facebook_link -%}
        {%- assign fb_icon = settings.social_facebook_icon -%}
        {%- if fb_url != blank -%}
          <a 
            href="{{ fb_url }}" 
            target="_blank" 
            rel="noopener noreferrer"
            class="custom-header--burger-social-link"
            aria-label="Facebook"
          >
            {%- if fb_icon != blank -%}
            <img 
              src="{{ fb_icon | image_url: width: 60 }}" 
              alt="Facebook"
              class="custom-header--burger-social-icon-img"
              width="26"
              height="26"
              loading="eager"
            >
            {%- else -%}
              <img src="{{ 'ic_baseline-facebook.svg' | asset_url }}" alt="Facebook" class="custom-header--burger-social-icon-img" width="26" height="26">
            {%- endif -%}
          </a>
        {%- endif -%}
        {%- assign ig_url = settings.social_instagram_link -%}
        {%- assign ig_icon = settings.social_instagram_icon -%}
        {%- if ig_url != blank -%}
          <a 
            href="{{ ig_url }}" 
            target="_blank" 
            rel="noopener noreferrer"
            class="custom-header--burger-social-link"
            aria-label="Instagram"
          >
            {%- if ig_icon != blank -%}
            <img 
              src="{{ ig_icon | image_url: width: 60 }}" 
              alt="Instagram"
              class="custom-header--burger-social-icon-img"
              width="26"
              height="26"
              loading="eager"
            >
            {%- else -%}
              <img src="{{ 'mingcute_instagram-fill.svg' | asset_url }}" alt="Instagram" class="custom-header--burger-social-icon-img" width="26" height="26">
            {%- endif -%}
          </a>
        {%- endif -%}
        {%- assign tt_url = settings.social_tiktok_link -%}
        {%- assign tt_icon = settings.social_tiktok_icon -%}
        {%- if tt_url != blank -%}
          <a 
            href="{{ tt_url }}" 
            target="_blank" 
            rel="noopener noreferrer"
            class="custom-header--burger-social-link"
            aria-label="TikTok"
          >
            {%- if tt_icon != blank -%}
            <img 
              src="{{ tt_icon | image_url: width: 60 }}" 
              alt="TikTok"
              class="custom-header--burger-social-icon-img"
              width="26"
              height="26"
              loading="eager"
            >
            {%- else -%}
              <img src="{{ 'lineicons_tiktok-alt.svg' | asset_url }}" alt="TikTok" class="custom-header--burger-social-icon-img" width="26" height="26">
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} Barra de Búsqueda Overlay {%- endcomment -%}
{%- if search_block -%}
<div class="custom-header--search-overlay" data-search-overlay style="
  --search-result-title-color: {{ search_block.settings.result_title_color | default: '#0d0d0d' }};
  --search-result-title-size: {{ search_block.settings.result_title_size | default: 14 }}px;
  --search-result-title-weight: {{ search_block.settings.result_title_weight | default: 700 }};
  --search-result-price-size: {{ search_block.settings.result_price_size | default: 13 }}px;
  --search-result-price-weight: {{ search_block.settings.result_price_weight | default: 400 }};
  --search-result-image-width: {{ search_block.settings.result_image_width | default: 50 }}px;
  --search-result-image-brightness: {{ search_block.settings.result_image_brightness | default: 100 }}%;
  --search-view-all-color: {{ search_block.settings.view_all_color | default: '#0d0d0d' }};
  --search-view-all-weight: {{ search_block.settings.view_all_weight | default: 700 }};
  --search-input-weight: {{ search_block.settings.search_input_weight | default: 400 }};
  --search-bar-radius: {{ search_block.settings.search_bar_radius | default: 10 }}px;
  --search-results-radius: {{ search_block.settings.search_results_radius | default: 10 }}px;
">
  <div class="custom-header--search-backdrop" data-search-close></div>
  <div class="custom-header--search-wrapper">
    <div class="custom-header--search-bar-container">
    <form action="{{ routes.search_url }}" method="get" class="custom-header--search-form">
      <input
        type="text"
        name="q"
        placeholder="{{ search_block.settings.search_placeholder | default: 'Search' }}"
        class="custom-header--search-input"
        autocomplete="off"
        aria-label="{{ search_block.settings.search_placeholder | default: 'Search' }}"
      >
      <button
        type="submit"
        class="custom-header--search-submit"
        aria-label="Search"
      >
        {%- if icon_search != blank -%}
          {%- if icon_search.format == 'svg' or icon_search.src contains '.svg' -%}
            {%- assign icon_search_url = icon_search | image_url -%}
          {%- else -%}
            {%- assign icon_search_url = icon_search | image_url: width: 40 -%}
          {%- endif -%}
          <img 
            src="{{ icon_search_url }}" 
            alt=""
            class="custom-header--search-icon no-filter"
            width="20"
            height="20"
            loading="eager"
            aria-hidden="true"
          >
        {%- else -%}
          <img 
            src="{{ 'Search-header.svg' | asset_url }}" 
            alt=""
            class="custom-header--search-icon"
            width="20"
            height="20"
            loading="eager"
            aria-hidden="true"
          >
        {%- endif -%}
      </button>
    </form>
    </div>
    
    <div class="custom-header--search-results" data-search-results></div>
    
  </div>
</div>
{%- endif -%}

{%- comment -%} Carrito Lateral Overlay {%- endcomment -%}
{%- if cart_block -%}
<div class="custom-header--cart-overlay{% if cart_full_height %} custom-header--cart-overlay--full-height{% endif %}" data-cart-overlay>
  <div class="custom-header--cart-backdrop" data-cart-close></div>
  <div class="custom-header--cart-panel">
    {%- comment -%} Header del carrito {%- endcomment -%}
    <div class="custom-header--cart-header">
      <div class="custom-header--cart-switch">
        {%- if wishlist_block_count > 0 -%}
          <button type="button" class="custom-header--cart-switch-btn is-active" data-cart-view="cart">
            {{ cart_tab_label }}
          </button>
          <button type="button" class="custom-header--cart-switch-btn" data-cart-view="wishlist">
            {{ wishlist_tab_label }}
          </button>
        {%- else -%}
          <span class="custom-header--cart-title">{{ cart_title_fallback_text }}</span>
        {%- endif -%}
      </div>
      <button 
        class="custom-header--cart-close"
        data-cart-close
        aria-label="Close cart"
        type="button"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="custom-header--cart-close-icon">
          <path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {%- comment -%} Contenido del carrito {%- endcomment -%}
    <div class="custom-header--cart-body" data-lenis-prevent>
      <div id="custom-header--cart-view">
        {%- comment -%} Barra de progreso de envío gratis {%- endcomment -%}
      {%- assign free_shipping_threshold = free_shipping_threshold_val | times: 100 -%}
      {%- assign cart_total = cart.total_price -%}
      {%- assign remaining_amount = free_shipping_threshold | minus: cart_total -%}
      {%- if remaining_amount > 0 -%}
        {%- assign progress_percentage = cart_total | times: 100 | divided_by: free_shipping_threshold | at_least: 0 | at_most: 100 -%}
      {%- else -%}
        {%- assign progress_percentage = 100 -%}
        {%- assign remaining_amount = 0 -%}
      {%- endif -%}

      <div class="custom-header--cart-shipping-bar">
        {%- if cart_total >= free_shipping_threshold -%}
          <div class="custom-header--cart-shipping-text free-shipping-achieved">
            {{ free_shipping_success_message }}
          </div>
        {%- else -%}
        <div class="custom-header--cart-shipping-text">
            {{ free_shipping_text_before }} <strong class="custom-header--cart-shipping-amount">{{ remaining_amount | money_without_trailing_zeros }}</strong> {{ free_shipping_text_after }}
        </div>
        {%- endif -%}
        <div class="custom-header--cart-progress-container">
          <div class="custom-header--cart-progress-bar">
            <div 
              class="custom-header--cart-progress-fill"
              style="width: {{ progress_percentage }}%;"
            ></div>
          </div>
          <div class="custom-header--cart-progress-labels">
            <span class="custom-header--cart-progress-label">$0</span>
            <span class="custom-header--cart-progress-label">{{ free_shipping_threshold | money_without_trailing_zeros }}</span>
          </div>
        </div>
      </div>

      {%- comment -%} Lista de productos {%- endcomment -%}
      <div class="custom-header--cart-items">
        {%- if cart.item_count > 0 -%}
          {%- for item in cart.items -%}
          <div class="custom-header--cart-item" data-cart-item-key="{{ item.key }}">
            <div class="custom-header--cart-item-image-container">
              {%- if item.image -%}
            {%- if item.image -%}
              <div class="custom-header--cart-item-image-container">
                <a href="{{ item.url }}" style="display:block; height:100%;">
                  <img 
                    src="{{ item.image | image_url: width: 113 }}" 
                    alt="{{ item.image.alt | escape }}"
                    class="custom-header--cart-item-image"
                    width="113"
                    loading="lazy"
                  >
                </a>
              {%- else -%}
                <a href="{{ item.url }}" style="display:block; height:100%;">
                  <div class="custom-header--cart-item-image-placeholder"></div>
                </a>
              {%- endif -%}
            </div>
              </div>
            {%- endif -%}
            <div class="custom-header--cart-item-details">
              <div class="custom-header--cart-item-heading">
                <h3 class="custom-header--cart-item-title"><a href="{{ item.url }}" style="text-decoration: none; color: inherit;">{{ item.product.title }}</a></h3>
                <button
                  class="custom-header--cart-wishlist"
                  data-cart-wishlist="{{ item.product.handle }}"
                  data-handle="{{ item.product.handle }}"
                  aria-label="Favorites"
                  type="button"
                >
                  <img src="{{ cart_wishlist_icon_url }}" alt="Favorites">
                </button>
              </div>
              {%- if item.variant.title != 'Default Title' -%}
                <div class="custom-header--cart-item-variant">{{ item.variant.title }}</div>
              {%- endif -%}
              <div class="custom-header--cart-item-meta">
                <div class="custom-header--cart-item-price">
                  {%- if item.original_price != item.final_price -%}
                    <span class="custom-header--cart-item-price-original">{{ item.original_price | money }}</span>
                  {%- endif -%}
                  <span class="custom-header--cart-item-price-final">{{ item.final_price | money }}</span>
                </div>
                <div class="custom-header--cart-item-qty">
                  <div class="custom-header--cart-qty-selector">
                    <button type="button" class="custom-header--cart-qty-btn" data-qty-change="-1" data-key="{{ item.key }}" aria-label="Reducir cantidad">
                      <img src="{% if settings.global_icon_minus != blank %}{{ settings.global_icon_minus | image_url: width: 20 }}{% else %}{{ 'minus.svg' | asset_url }}{% endif %}" alt="" class="custom-header--cart-qty-icon" loading="lazy">
                    </button>
                    <input type="text" class="custom-header--cart-qty-input" value="{{ item.quantity }}" readonly>
                    <button type="button" class="custom-header--cart-qty-btn" data-qty-change="1" data-key="{{ item.key }}" aria-label="Incrementar cantidad">
                      <img src="{% if settings.global_icon_plus != blank %}{{ settings.global_icon_plus | image_url: width: 20 }}{% else %}{{ 'plus.svg' | asset_url }}{% endif %}" alt="" class="custom-header--cart-qty-icon" loading="lazy">
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {%- endfor -%}
        {%- else -%}
          <div class="custom-header--cart-empty" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; text-align: center; padding: 40px 20px;">
            {%- if cart_empty_image != blank -%}
              <img 
                src="{{ cart_empty_image | image_url: width: 400 }}" 
                alt="Empty cart" 
                class="custom-header--cart-empty-image"
                style="margin-bottom: 20px; opacity: 0.5;"
              >
            {%- endif -%}
            {%- if cart_empty_title != blank -%}
              <h3 class="custom-header--cart-empty-title {{ cart_empty_title_style }}" style="margin: 0 0 10px 0;">{{ cart_empty_title }}</h3>
            {%- endif -%}
            {%- if cart_empty_text != blank -%}
              <div class="custom-header--cart-empty-text {{ cart_empty_text_style }}" style="margin-bottom: 30px; color: #666;">{{ cart_empty_text }}</div>
            {%- endif -%}
            <div class="custom-header--cart-empty-buttons" style="display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 280px;">
              {%- if cart_empty_btn_1_text != blank -%}
                <a href="{{ cart_empty_btn_1_link }}" class="custom-header--cart-empty-btn" style="background-color: {{ cart_empty_btn_1_bg }}; color: {{ cart_empty_btn_1_text_color }} !important;">{{ cart_empty_btn_1_text }}</a>
              {%- endif -%}
              {%- if cart_empty_btn_2_text != blank -%}
                <a href="{{ cart_empty_btn_2_link }}" class="custom-header--cart-empty-btn secondary" style="background-color: {{ cart_empty_btn_2_bg }}; color: {{ cart_empty_btn_2_text_color }} !important; border-color: {{ cart_empty_btn_2_text_color }};">{{ cart_empty_btn_2_text }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
      
      {%- if upsell_collection != blank and collections[upsell_collection].products_count > 0 -%}
        <div class="custom-header--cart-upsell">
          <div class="custom-header--cart-upsell-header">
            <div>
              {%- if upsell_title != blank -%}
                <h4 class="custom-header--cart-upsell-title">{{ upsell_title }}</h4>
              {%- endif -%}
              {%- if upsell_text != blank -%}
                <p class="custom-header--cart-upsell-text">{{ upsell_text }}</p>
              {%- endif -%}
            </div>
            <div class="custom-header--cart-upsell-nav">
              <button type="button" class="custom-header--cart-upsell-arrow prev" aria-label="Previous"><svg width="6" height="10" viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9L1 5L5 1"/></svg></button>
              <button type="button" class="custom-header--cart-upsell-arrow next" aria-label="Next"><svg width="6" height="10" viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 9L5 5L1 1"/></svg></button>
            </div>
          </div>
          <div class="custom-header--cart-upsell-slider">
            {%- for product in collections[upsell_collection].products limit: upsell_limit -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              <div class="custom-header--cart-upsell-item">
                <div class="custom-header--cart-upsell-image-container"><img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title }}" loading="lazy"></div>
                <div class="custom-header--cart-upsell-details">
                  <h5 class="custom-header--cart-upsell-product-title">{{ product.title }}</h5>
                  <div class="custom-header--cart-upsell-meta">
                    <span class="custom-header--cart-upsell-price">{{ product.price | money }}</span>
                    <button
                      type="button"
                      class="custom-header--cart-upsell-add"
                      data-upsell-add="{{ variant.id }}"
                      aria-label="{{ upsell_add_button_text }} {{ product.title }}"
                    >
                      {{ upsell_add_button_text }}
                    </button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      
      <div class="custom-header--cart-summary" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
        <div class="custom-header--cart-summary-row">
          <span>Subtotal</span>
          <span class="custom-header--cart-subtotal-price">{{ cart.total_price | money }}</span>
        </div>
        <div class="custom-header--cart-summary-row">
          <span>Envío</span>
          <span class="custom-header--cart-shipping-value">Calculado al pagar</span>
        </div>
        <div class="custom-header--cart-summary-row total">
          <span>Total</span>
          <span class="custom-header--cart-total-price">{{ cart.total_price | money }}</span>
        </div>
      </div>
      </div>

      {%- if wishlist_block_count > 0 -%}
      <div id="custom-header--wishlist-view" style="display: none;">
        <div class="custom-header--wishlist-view-inner">
          <div class="custom-header--wishlist-header">
            <h3>{{ wishlist_title_text }}</h3>
            <p>{{ wishlist_description_text }}</p>
          </div>
          <div class="custom-header--wishlist-items custom-header--cart-items" data-wishlist-layout="{{ wishlist_layout }}">
            <!-- Items will be injected here via JS -->
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
    <div class="custom-header--cart-toast" aria-live="polite"></div>
    
    {%- comment -%} Footer del carrito {%- endcomment -%}
    <div class="custom-header--cart-footer">
      <a 
        href="/checkout" 
        class="custom-header--cart-checkout-button"
        {% if cart.item_count == 0 %}style="display: none;"{% endif %}
      >
        {{ cart_checkout_btn_label }}
      </a>
      <div class="custom-header--cart-payment-info">
        <div class="custom-header--cart-guarantee">
          {%- if cart_block.settings.cart-guarantee-icon != blank -%}
            <img 
              src="{{ cart_block.settings.cart-guarantee-icon | image_url: width: 20 }}" 
              alt=""
              class="custom-header--cart-guarantee-icon"
              width="20"
              height="20"
              loading="lazy"
              aria-hidden="true"
            >
          {%- endif -%}
          <p class="custom-header--cart-guarantee-text">
            {{ cart_block.settings.cart-guarantee-text | default: 'Tu compra está protegida por nuestra política de servicios' }}
          </p>
        </div>
        <div class="custom-header--cart-payment-icons">
          {%- assign payment_icons = cart_block.settings.cart_payment_icons | split: ',' -%}
          {%- for type in payment_icons -%}
            {{ type | strip | payment_type_svg_tag: class: 'icon icon--full-color' }}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{%- comment -%} Script para comportamiento del header {%- endcomment -%}
<script>
(() => {
  const sectionId = '{{ section.id }}';
  const registry = window.__sncHeaderLifecycle = window.__sncHeaderLifecycle || {};
  if (registry[sectionId]) {
    registry[sectionId].cleanup();
  }

  const instance = { listeners: [], intervals: [] };

  const on = (target, event, handler, options) => {
    if (!target) return;
    target.addEventListener(event, handler, options);
    instance.listeners.push({ target, event, handler, options });
  };

  const setIntervalTracked = (fn, delay) => {
    const id = setInterval(fn, delay);
    instance.intervals.push(id);
    return id;
  };

  instance.cleanup = () => {
    instance.listeners.forEach(({ target, event, handler, options }) => {
      target.removeEventListener(event, handler, options);
    });
    instance.intervals.forEach(clearInterval);
    instance.listeners = [];
    instance.intervals = [];
  };

  registry[sectionId] = instance;

  on(document, 'shopify:section:unload', function(event) {
    if (event.detail.sectionId === sectionId) {
      instance.cleanup();
    }
  });

  (function() {
    const sectionId = '{{ section.id }}';
    window.__customHeaderRegistry = window.__customHeaderRegistry || {};

    function cleanup() {
      const instance = window.__customHeaderRegistry[sectionId];
      if (!instance) return;

      if (instance.scrollHandler) {
        window.removeEventListener('scroll', instance.scrollHandler);
      }

      if (instance.scrollTimeout) {
        cancelAnimationFrame(instance.scrollTimeout);
      }

      if (instance.resizeObserver) {
        instance.resizeObserver.disconnect();
      }

      if (instance.resizeHandler) {
        window.removeEventListener('resize', instance.resizeHandler);
      }

      delete window.__customHeaderRegistry[sectionId];
    }

    function init() {
      cleanup();

      const section = document.getElementById(`shopify-section-${sectionId}`);
      if (!section) return;

      const header = section.querySelector('.custom-header--root');
      const announcementBar = section.querySelector('[data-announcement-bar]');
      const marquee = section.querySelector('[data-marquee="true"] .custom-header--announcement-marquee');
      const stickyEnabled = {{ sticky_enabled | json }};

      const getAnnouncementHeight = () => {
        if (!announcementBar) return 0;
        if (announcementBar.classList.contains('custom-header--announcement-hidden')) {
          return 0;
        }
        return announcementBar.offsetHeight;
      };

      const setHeaderOffset = () => {
        if (!header) return;
        const height = getAnnouncementHeight();
        const headerHeight = header.offsetHeight;
        const totalHeight = height + headerHeight;
        header.style.setProperty('--custom-header-announcement-height', `${height}px`);
        document.documentElement.style.setProperty('--custom-header-total-height', `${totalHeight}px`);
        // Aplicar también al body para que los backdrops se ajusten
        document.body.style.setProperty('--custom-header-total-height', `${totalHeight}px`);
        
        // El header es fixed, no necesitamos spacer
      };

      setHeaderOffset();

      let scrollHandler = null;
      let scrollTimeout = null;

      scrollHandler = () => {
        if (scrollTimeout) return;
        scrollTimeout = requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const scrolled = scrollY > 50;
          
          // Lógica barra de anuncios
          if (announcementBar && !{{ section.settings.announcement_sticky | default: false | json }}) {
            announcementBar.classList.toggle('custom-header--announcement-hidden', scrolled);
            setHeaderOffset();
          }

          // Lógica estilos sticky del header
          if (header && stickyEnabled) {
            header.classList.toggle('is-sticky', scrollY > 10);
          }

          scrollTimeout = null;
        });
      };

      scrollHandler();
      on(window, 'scroll', scrollHandler, { passive: true });

      let resizeObserver = null;
      let resizeHandler = null;

      if (announcementBar && 'ResizeObserver' in window) {
        resizeObserver = new ResizeObserver(setHeaderOffset);
        resizeObserver.observe(announcementBar);
      } else {
        resizeHandler = () => setHeaderOffset();
        on(window, 'resize', resizeHandler);
      }

      if (marquee) {
        marquee.style.setProperty('--custom-header-marquee-speed', '{{ announcement_speed }}s');
      }

      window.__customHeaderRegistry[sectionId] = {
        scrollHandler,
        scrollTimeout,
        resizeObserver,
        resizeHandler
      };
    }

    if (document.readyState === 'loading') {
      on(document, 'DOMContentLoaded', init);
    } else {
      init();
    }

    on(document, 'shopify:section:load', function(event) {
      if (event.detail.sectionId === sectionId) {
        init();
      }
    });

    on(document, 'shopify:section:unload', function(event) {
      if (event.detail.sectionId === sectionId) {
        cleanup();
      }
    });
  })();

  // Manejar mega menú (desktop)
  (function() {
    const sectionId = '{{ section.id }}';
    let section = document.getElementById(`shopify-section-${sectionId}`);
    if (!section) {
      const root = document.querySelector(`.custom-header--root[data-section-id="${sectionId}"]`);
      if (root) section = root.closest('.shopify-section') || root.parentElement;
    }
    if (!section) return;
    const header = section.querySelector('.custom-header--root');

    const nav = section.querySelector('[data-mega-nav]');
    const triggers = nav ? nav.querySelectorAll('[data-mega-trigger]') : [];
    const panels = section.querySelectorAll('[data-mega-panel]');
    const guard = section.querySelector('[data-mega-guard]');
    const overlay = section.querySelector('[data-mega-overlay]');
    if (panels.length === 0 || triggers.length === 0) return;

    // Delay más largo para hacer el hover menos sensible
    const closeDelay = 400;
    let hideTimeout = null;
    let isPanelOpen = false;

    function openPanel(blockId) {
      if (!blockId) return;
      
      // Close other panels
      panels.forEach(p => {
        if (p.dataset.megaPanel !== blockId) {
          p.classList.remove('custom-header--mega-panel-open');
        }
      });
      
      const targetPanel = section.querySelector(`[data-mega-panel="${blockId}"]`);
      if (!targetPanel) return;

      targetPanel.classList.add('is-initialized');
      void targetPanel.offsetWidth; // Force reflow
      targetPanel.classList.add('custom-header--mega-panel-open');
      
      if (isPanelOpen) return;
      isPanelOpen = true;
      if (guard) guard.classList.add('is-visible');
      if (overlay) {
        overlay.classList.add('is-initialized');
        void overlay.offsetWidth; // Force reflow
        overlay.classList.add('is-visible');
      }
      if (header) header.classList.add('is-modal-active');
    }

    function closePanel() {
      isPanelOpen = false;
      panels.forEach(p => p.classList.remove('custom-header--mega-panel-open'));
      if (guard) guard.classList.remove('is-visible');
      if (overlay) overlay.classList.remove('is-visible');
      if (header) header.classList.remove('is-modal-active');
    }

    function scheduleClose() {
      cancelClose();
      hideTimeout = setTimeout(closePanel, closeDelay);
    }

    function cancelClose() {
      if (hideTimeout) {
        clearTimeout(hideTimeout);
        hideTimeout = null;
      }
    }

    triggers.forEach(trigger => {
      trigger.addEventListener('mouseenter', () => {
        cancelClose();
        openPanel(trigger.dataset.megaTrigger);
      });
      trigger.addEventListener('focus', () => {
        cancelClose();
        openPanel(trigger.dataset.megaTrigger);
      });
    });

    if (nav) {
      nav.addEventListener('mouseenter', cancelClose);
      nav.addEventListener('mouseleave', scheduleClose);
      nav.addEventListener('focusin', cancelClose);
      nav.addEventListener('focusout', (event) => {
        const nextTarget = event.relatedTarget;
        const isInsideAnyPanel = Array.from(panels).some(p => p.contains(nextTarget));
        if (!nav.contains(nextTarget) && !isInsideAnyPanel) {
          scheduleClose();
        }
      });
    }

    panels.forEach(p => {
      p.addEventListener('mouseenter', cancelClose);
      p.addEventListener('mouseleave', scheduleClose);
    });

    if (guard) {
      guard.addEventListener('mouseenter', cancelClose);
      guard.addEventListener('mouseleave', scheduleClose);
    }

    // Click en el overlay cierra el menú inmediatamente
    if (overlay) {
      overlay.addEventListener('click', () => {
        cancelClose();
        closePanel();
      });
    }

    on(document, 'keydown', function(event) {
      if (event.key === 'Escape') {
        cancelClose();
        closePanel();
      }
    });

    window.__customHeaderMega = window.__customHeaderMega || {};
    window.__customHeaderMega[sectionId] = {
      close: closePanel
    };

    on(document, 'shopify:section:unload', function(event) {
      if (event.detail.sectionId === sectionId && window.__customHeaderMega) {
        closePanel();
        delete window.__customHeaderMega[sectionId];
      }
    });
  })();

  // Manejar burger menu
  (function() {
    const sectionId = '{{ section.id }}';
    let section = document.getElementById(`shopify-section-${sectionId}`);
    if (!section) {
      const root = document.querySelector(`.custom-header--root[data-section-id="${sectionId}"]`);
      if (root) section = root.closest('.shopify-section') || root.parentElement;
    }
    const container = section || document;
    const header = container.querySelector('.custom-header--root');

    const menuToggle = container.querySelector('.custom-header--menu-toggle');
    const overlay = container.querySelector('[data-burger-overlay]');
    const closeButtons = container.querySelectorAll('[data-burger-close]');
    const backdrop = container.querySelector('.custom-header--burger-backdrop');
    const submenuTriggers = container.querySelectorAll('[data-burger-submenu-trigger]');

    if (!menuToggle || !overlay) return;

    function closeMegaPanel() {
      if (window.__customHeaderMega && window.__customHeaderMega[sectionId]) {
        window.__customHeaderMega[sectionId].close();
      }
    }

    function openMenu() {
      overlay.classList.add('is-initialized');
      void overlay.offsetWidth; // Force reflow
      overlay.classList.add('custom-header--burger-overlay-open');
      document.body.style.overflow = 'hidden';
      // Cerrar mega panel si estuviera abierto
      closeMegaPanel();
      // Cerrar barra de búsqueda y carrito si están abiertos
      const searchOverlay = container.querySelector('[data-search-overlay]');
      if (searchOverlay && searchOverlay.classList.contains('custom-header--search-overlay-open')) {
        searchOverlay.classList.remove('custom-header--search-overlay-open');
      }
        const cartOverlay = document.querySelector('[data-cart-overlay]');
      if (cartOverlay && cartOverlay.classList.contains('custom-header--cart-overlay-open')) {
        cartOverlay.classList.remove('custom-header--cart-overlay-open');
      }
      if (header) header.classList.add('is-modal-active');
    }

    function closeMenu() {
      console.log('Closing burger menu');
      overlay.classList.remove('custom-header--burger-overlay-open');
      document.body.style.overflow = '';
      document.body.classList.remove('menu-open');
      // Cerrar todos los submenús
      const openSubmenus = overlay.querySelectorAll('.custom-header--burger-submenu-open');
      openSubmenus.forEach(item => item.classList.remove('custom-header--burger-submenu-open'));
      if (header) header.classList.remove('is-modal-active');
    }

    menuToggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (this.hasAttribute('data-burger-inactive')) {
        // No hacer nada si el menú lateral móvil no está configurado.
        return;
      }
      openMenu();
    });

    closeButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        closeMenu();
      });
    });

    // Cerrar al hacer clic en el backdrop (área oscura fuera del panel)
    if (backdrop) {
      backdrop.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        closeMenu();
      });
    }
    
    // También cerrar si se hace clic en el overlay pero fuera del panel
    overlay.addEventListener('click', function(e) {
      // Solo cerrar si el clic fue directamente en el overlay, no en sus hijos
      if (e.target === overlay || e.target === backdrop) {
        closeMenu();
      }
    });

    // Manejar submenús
    submenuTriggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        const navItem = trigger.closest('.custom-header--burger-nav-item');
        if (!navItem) return;
        
        e.preventDefault();

        const isOpen = navItem.classList.contains('custom-header--burger-submenu-open');
        if (isOpen) {
          navItem.classList.remove('custom-header--burger-submenu-open');
        } else {
          const allItems = overlay.querySelectorAll('.custom-header--burger-nav-item');
          allItems.forEach(item => item.classList.remove('custom-header--burger-submenu-open'));
          navItem.classList.add('custom-header--burger-submenu-open');
        }
      });
    });

    // Cerrar con ESC
    on(document, 'keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('custom-header--burger-overlay-open')) {
        closeMenu();
      }
    });
  })();

  // Manejar barra de búsqueda
  (function() {
    const sectionId = '{{ section.id }}';
    let section = document.getElementById(`shopify-section-${sectionId}`);
    if (!section) {
      const root = document.querySelector(`.custom-header--root[data-section-id="${sectionId}"]`);
      if (root) section = root.closest('.shopify-section') || root.parentElement;
    }
    const container = section || document;
    const header = container.querySelector('.custom-header--root');

    const searchToggles = container.querySelectorAll('[data-search-toggle]');
    const searchOverlay = container.querySelector('[data-search-overlay]');
    const searchBackdrop = container.querySelector('.custom-header--search-backdrop');
    const searchInput = container.querySelector('.custom-header--search-input');
    const searchResults = container.querySelector('[data-search-results]');
    const searchTrending = container.querySelector('.custom-header--search-trending');

    if (searchToggles.length === 0 || !searchOverlay) return;

    function closeMegaPanel() {
      if (window.__customHeaderMega && window.__customHeaderMega[sectionId]) {
        window.__customHeaderMega[sectionId].close();
      }
    }

    function openSearch() {
      searchOverlay.classList.add('is-initialized');
      void searchOverlay.offsetWidth; // Force reflow
      searchOverlay.classList.add('custom-header--search-overlay-open');
      document.body.style.overflow = 'hidden';
      // Cerrar burger menu y carrito si están abiertos
      const burgerOverlay = container.querySelector('[data-burger-overlay]');
      if (burgerOverlay && burgerOverlay.classList.contains('custom-header--burger-overlay-open')) {
        burgerOverlay.classList.remove('custom-header--burger-overlay-open');
      }
        const cartOverlay = document.querySelector('[data-cart-overlay]');
      if (cartOverlay && cartOverlay.classList.contains('custom-header--cart-overlay-open')) {
        cartOverlay.classList.remove('custom-header--cart-overlay-open');
      }
      closeMegaPanel();
      // Focus en el input después de la animación
      setTimeout(() => {
        if (searchInput) searchInput.focus();
      }, 300);
      if (header) header.classList.add('is-modal-active');
    }

    function closeSearch() {
      searchOverlay.classList.remove('custom-header--search-overlay-open');
      document.body.style.overflow = '';
      if (header) header.classList.remove('is-modal-active');
    }

    searchToggles.forEach(toggle => {
      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        openSearch();
      });
    });

    if (searchBackdrop) {
      searchBackdrop.addEventListener('click', closeSearch);
    }

    // Cerrar con ESC
    on(document, 'keydown', function(e) {
      if (e.key === 'Escape' && searchOverlay.classList.contains('custom-header--search-overlay-open')) {
        closeSearch();
      }
    });

    // Lógica de búsqueda predictiva
    let debounceTimer;
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const term = e.target.value.trim();
        clearTimeout(debounceTimer);

        if (term.length === 0) {
          if (searchResults) searchResults.innerHTML = '';
          if (searchTrending) searchTrending.style.display = 'block';
          return;
        }

        debounceTimer = setTimeout(() => {
          fetch(`/search/suggest.json?q=${encodeURIComponent(term)}&resources[type]=product,collection&resources[limit]=5`)
            .then(res => res.json())
            .then(data => {
              const products = data.resources.results.products || [];
              const collections = data.resources.results.collections || [];
              
              if (searchResults) {
                if (products.length > 0 || collections.length > 0) {
                  let html = '';
                  
                  if (collections.length > 0) {
                    html += '<div class="custom-header--search-section-title">Colecciones</div>';
                    collections.forEach(c => {
                      const img = c.image ? `<img src="${c.image}" alt="${c.title}" class="custom-header--search-result-image">` : `<div class="custom-header--search-result-image placeholder"></div>`;
                      html += `
                        <a href="${c.url}" class="custom-header--search-result-item">
                          ${img}
                          <div class="custom-header--search-result-info">
                            <p class="custom-header--search-result-title">${c.title}</p>
                          </div>
                        </a>
                      `;
                    });
                  }

                  if (products.length > 0) {
                    if (collections.length > 0) {
                      html += '<div class="custom-header--search-section-title">Productos</div>';
                    }
                  products.forEach(p => {
                    html += `
                      <a href="${p.url}" class="custom-header--search-result-item">
                        <img src="${p.image}" alt="${p.title}" class="custom-header--search-result-image">
                        <div class="custom-header--search-result-info">
                          <p class="custom-header--search-result-title">${p.title}</p>
                          <p class="custom-header--search-result-price">$${p.price}</p>
                        </div>
                      </a>
                    `;
                  });
                  }
                  
                  html += `
                    <a href="${window.routes ? window.routes.search_url : '/search'}?q=${encodeURIComponent(term)}" class="custom-header--search-view-all">
                      View all results 
                    </a>
                  `;
                  searchResults.innerHTML = html;
                  if (searchTrending) searchTrending.style.display = 'none';
                } else {
                  searchResults.innerHTML = `<p class="custom-header--search-no-results">No Results Found</p>`;
                  if (searchTrending) searchTrending.style.display = 'none';
                }
              }
            });
        }, 300);
      });
    }
  })();

  // Inicializar contador de wishlist en menú lateral
  (function() {
    const STORAGE_KEY = 'snc_favorites';
    
    function getFavorites() {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }
    
    function updateWishlistCounts() {
      const favs = getFavorites();
      const count = favs.length;
      
      // Actualizar badge en todos los iconos de favoritos (desktop y mobile)
      const wishlistLinks = document.querySelectorAll('.custom-header--wishlist');
      wishlistLinks.forEach(link => {
        let badge = link.querySelector('.custom-header--wishlist-count');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'custom-header--wishlist-count';
          link.appendChild(badge);
        }
        badge.textContent = count;
        badge.style.display = count > 0 ? 'flex' : 'none';
        if (count > 0) {
          badge.classList.remove('is-bumping');
          void badge.offsetWidth;
          badge.classList.add('is-bumping');
        }
      });
      
      // Actualizar badge en menú lateral móvil
      const burgerWishlistBadge = document.querySelector('.custom-header--burger-wishlist-count');
      if (burgerWishlistBadge) {
        burgerWishlistBadge.textContent = count;
        burgerWishlistBadge.style.display = count > 0 ? 'flex' : 'none';
      }
    }
    
    // Inicializar al cargar
    if (document.readyState === 'loading') {
      on(document, 'DOMContentLoaded', updateWishlistCounts);
    } else {
      updateWishlistCounts();
    }
    
    // Escuchar cambios en localStorage (para sincronizar entre pestañas)
    on(window, 'storage', function(e) {
      if (e.key === STORAGE_KEY) {
        updateWishlistCounts();
      }
    });
    
    // Escuchar evento personalizado para actualizaciones en la misma pestaña
    on(window, 'snc:wishlist-updated', updateWishlistCounts);
  })();

  // Manejar slider de anuncios
  (function() {
    const sectionId = '{{ section.id }}';
    const section = document.getElementById(`shopify-section-${sectionId}`);
    if (!section) return;

    const slider = section.querySelector('.custom-header--announcement-slider');
    if (!slider) return;

    const slides = slider.querySelectorAll('.custom-header--announcement-slide');
    if (slides.length < 2) return;

    const prevBtn = section.querySelector('.custom-header--announcement-arrow.prev');
    const nextBtn = section.querySelector('.custom-header--announcement-arrow.next');
    const playPauseBtn = section.querySelector('.custom-header--announcement-play-pause');
    const iconPause = playPauseBtn ? playPauseBtn.querySelector('.icon-pause') : null;
    const iconPlay = playPauseBtn ? playPauseBtn.querySelector('.icon-play') : null;
    
    let currentIndex = 0;
    let isPlaying = true;
    let interval;
    const speed = parseInt(slider.dataset.autoplaySpeed) || 5000;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index);
      });
      currentIndex = index;
    }

    function nextSlide() {
      let newIndex = currentIndex + 1;
      if (newIndex >= slides.length) newIndex = 0;
      showSlide(newIndex);
    }

    function prevSlide() {
      let newIndex = currentIndex - 1;
      if (newIndex < 0) newIndex = slides.length - 1;
      showSlide(newIndex);
    }

    function startAutoplay() {
      if (interval) clearInterval(interval);
      interval = setIntervalTracked(nextSlide, speed);
      isPlaying = true;
      if (playPauseBtn) playPauseBtn.dataset.state = 'playing';
      if (iconPause) iconPause.style.display = 'block';
      if (iconPlay) iconPlay.style.display = 'none';
    }

    function stopAutoplay() {
      if (interval) clearInterval(interval);
      isPlaying = false;
      if (playPauseBtn) playPauseBtn.dataset.state = 'paused';
      if (iconPause) iconPause.style.display = 'none';
      if (iconPlay) iconPlay.style.display = 'block';
    }

    if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); if (isPlaying) startAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); if (isPlaying) startAutoplay(); });

    if (playPauseBtn) {
      playPauseBtn.addEventListener('click', () => {
        isPlaying ? stopAutoplay() : startAutoplay();
      });
    }

    startAutoplay();
  })();
})();
</script>

{%- if smooth_scroll_enabled -%}
<script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>
<script>
  (function() {
    const initLenis = () => {
      if (window.Shopify && Shopify.designMode) return;
      if (window.__sncLenisInitialized) return;
      if (typeof Lenis !== 'undefined') {
        const lenis = new Lenis({
          duration: {{ smooth_scroll_duration }},
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smooth: true,
          mouseMultiplier: 1,
          smoothTouch: false,
          touchMultiplier: 2
        });

        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
        window.lenis = lenis;
        window.__sncLenisInitialized = true;
        console.log('SNC Smooth Scroll (Lenis) activado');
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLenis, { once: true });
    } else {
      initLenis();
    }
  })();
</script>
{%- endif -%}

