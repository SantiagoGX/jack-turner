{%- liquid
  assign announcement_enabled = section.settings.announcement-enabled
  assign announcement_blocks = section.blocks | where: 'type', 'announcement'
  assign logo_to_use = settings.logo_dark
  if section.settings.logo_version == 'light'
    assign logo_to_use = settings.logo_light
  endif
  assign logo_sticky = settings.logo_dark
  if section.settings.logo_version_sticky == 'light'
    assign logo_sticky = settings.logo_light
  endif
  assign locale_label = section.settings['locale-label'] | default: 'ES'
  assign currency_label = section.settings['currency-label'] | default: 'MEX$'
  assign sticky_enabled = section.settings.sticky-enabled
  assign force_sticky_style = false
  if section.settings.static_on_home_only and request.page_type != 'index'
    assign force_sticky_style = true
  endif
  assign smooth_scroll_enabled = section.settings.smooth_scroll_enabled
  assign smooth_scroll_duration = section.settings.smooth_scroll_duration | default: 1.5
  
  assign burger_block = section.blocks | where: 'type', 'burger_menu' | first
  assign burger_menu = blank
  if burger_block and burger_block.settings.menu != blank
    assign burger_menu = linklists[burger_block.settings.menu]
  endif

  assign has_mega_menu = false
  if burger_menu != blank and burger_menu.links.size > 0
    assign has_mega_menu = true
  endif
  
  assign burger_menu_gap = burger_block.settings.menu_gap | default: 10
  assign mobile_drawer_block = section.blocks | where: 'type', 'mobile_drawer' | first
  assign mobile_drawer_menu = blank
  if mobile_drawer_block and mobile_drawer_block.settings.mobile_menu != blank
    assign mobile_drawer_menu = linklists[mobile_drawer_block.settings.mobile_menu]
  endif
  assign mobile_drawer_menu_gap = 10
  if mobile_drawer_block
    assign mobile_drawer_menu_gap = mobile_drawer_block.settings.menu_gap | default: 10
  endif

  assign locale_enabled = false
  if section.settings.show-locale-selector and localization.available_languages.size > 1
    assign locale_enabled = true
  endif

  assign region_enabled = false
  if section.settings.show-region-selector and localization.available_countries.size > 1
    assign region_enabled = true
  endif

  assign cart_title_t = 'cart.title' | t
  assign search_t = 'general.search.search' | t
  assign account_t = 'layout.header.account_view_link' | t
 
  assign icon_version_setting = section.settings.icon_version | default: 'dark'
  assign icon_version_sticky_setting = section.settings.icon_version_sticky | default: 'dark'

  if icon_version_setting == 'light'
    assign icon_burger = settings.global_icon_burger_light
    assign icon_search = settings.global_icon_search_light
    assign icon_account = settings.global_icon_account_light
    assign icon_wishlist = settings.global_icon_wishlist_light
    assign icon_cart = settings.global_icon_cart_light
  else
    assign icon_burger = settings.global_icon_burger_dark
    assign icon_search = settings.global_icon_search_dark
    assign icon_account = settings.global_icon_account_dark
    assign icon_wishlist = settings.global_icon_wishlist_dark
    assign icon_cart = settings.global_icon_cart_dark
  endif

  if icon_version_sticky_setting == 'light'
    assign icon_burger_sticky = settings.global_icon_burger_light
    assign icon_search_sticky = settings.global_icon_search_light
    assign icon_account_sticky = settings.global_icon_account_light
    assign icon_wishlist_sticky = settings.global_icon_wishlist_light
    assign icon_cart_sticky = settings.global_icon_cart_light
  else
    assign icon_burger_sticky = settings.global_icon_burger_dark
    assign icon_search_sticky = settings.global_icon_search_dark
    assign icon_account_sticky = settings.global_icon_account_dark
    assign icon_wishlist_sticky = settings.global_icon_wishlist_dark
    assign icon_cart_sticky = settings.global_icon_cart_dark
  endif

  assign show_burger_desktop = section.settings.show_burger_desktop

  assign wishlist_url = section.settings.wishlist_url | default: '/pages/wishlist'

  if icon_wishlist != blank
    if icon_wishlist.format == 'svg' or icon_wishlist.src contains '.svg'
      assign cart_wishlist_icon_url = icon_wishlist | image_url
    else
      assign cart_wishlist_icon_url = icon_wishlist | image_url: width: 40
    endif
  else
    assign cart_wishlist_icon_url = 'favorite.svg' | asset_url
  endif

  assign search_block = section.blocks | where: 'type', 'search_overlay' | first

  assign wishlist_bg_enabled = settings.global_wishlist_bg_enabled
  assign wishlist_bg_color = settings.global_wishlist_bg_color | default: '#FFFFFF'
  assign wishlist_radius = settings.global_wishlist_radius | default: 0
  assign wishlist_padding = settings.global_wishlist_padding | default: 8
  assign wishlist_size = settings.global_wishlist_size | default: 40
-%}

{%- comment -%}
  Header Principal con Barra de Anuncio
{%- endcomment -%}
<div class="custom-header--announcement-section">
  {%- if announcement_enabled -%}
    <div 
      class="custom-header--announcement" 
      data-announcement-bar
      {% if announcement_marquee %}data-marquee="true"{% endif %}
    >
      <div class="custom-header--announcement-content">
        {%- if announcement_blocks.size > 0 -%}
          <div class="custom-header--announcement-slider-wrapper">
            {%- if announcement_blocks.size > 1 -%}
              <button class="custom-header--announcement-arrow prev" aria-label="Previous">
                <svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 9L1 5L5 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            {%- endif -%}
            
            <div class="custom-header--announcement-slider" data-autoplay-speed="5000">
              {%- for block in announcement_blocks -%}
                <div class="custom-header--announcement-slide {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
                  {%- else -%}
                    <p>{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>

            {%- if announcement_blocks.size > 1 -%}
              <button class="custom-header--announcement-arrow next" aria-label="Next">
                <svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 9L5 5L1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="custom-header--announcement-play-pause" aria-label="Pausar" data-state="playing">
                <svg class="icon-pause" width="8" height="10" viewBox="0 0 8 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1V9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M7 1V9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <svg class="icon-play" width="8" height="10" viewBox="0 0 8 10" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none;"><path d="M1 1L7 5L1 9V1Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <header 
    class="custom-header--root{% if force_sticky_style %} force-sticky-style{% endif %}"
    data-sticky="{{ sticky_enabled }}"
    data-section-id="{{ section.id }}"
  >
  <div class="custom-header--wrapper">
    
    {%- comment -%} Lado Izquierdo - Desktop {%- endcomment -%}
    <div class="custom-header--left">
      {%- comment -%} Menú Hamburguesa {%- endcomment -%}
      <button 
        class="custom-header--menu-toggle"
        {% unless show_burger_desktop %}style="display: none;"{% endunless %}
        aria-label="{{ 'layout.header.toggle_drawer' | t }}"
        aria-haspopup="menu"
        type="button"
        {% if mobile_drawer_block == blank %}data-burger-inactive="true"{% endif %}
      >
        {%- if icon_burger != blank -%}
          {%- if icon_burger.format == 'svg' or icon_burger.src contains '.svg' -%}
            {%- assign icon_burger_url = icon_burger | image_url -%}
          {%- else -%}
            {%- assign icon_burger_url = icon_burger | image_url: width: 44 -%}
          {%- endif -%}
          <img 
            src="{{ icon_burger_url }}" 
            alt="Menu" 
            class="custom-header--burger-icon no-filter icon-static"
            width="22"
            height="15"
            loading="eager"
          >
        {%- else -%}
          <img 
            src="{{ 'burguerkwara.svg' | asset_url }}" 
            alt="Menu" 
            class="custom-header--burger-icon icon-static"
            width="22"
            height="15"
            loading="eager"
          >
        {%- endif -%}
        {%- if icon_burger_sticky != blank -%}
          {%- if icon_burger_sticky.format == 'svg' or icon_burger_sticky.src contains '.svg' -%}
            {%- assign icon_burger_sticky_url = icon_burger_sticky | image_url -%}
          {%- else -%}
            {%- assign icon_burger_sticky_url = icon_burger_sticky | image_url: width: 44 -%}
          {%- endif -%}
          <img src="{{ icon_burger_sticky_url }}" alt="Menu" class="custom-header--burger-icon no-filter icon-sticky" width="22" height="15" loading="eager">
        {%- else -%}
          <img src="{{ 'burguerkwara.svg' | asset_url }}" alt="Menu" class="custom-header--burger-icon icon-sticky" width="22" height="15" loading="eager">
        {%- endif -%}
      </button>

      {%- comment -%} Navegación primaria - configurable desde el editor {%- endcomment -%}
      <div class="custom-header--nav-links custom-header--desktop-only" data-mega-nav>
        {%- assign header_items = section.blocks | where: 'type', 'header_item' -%}
        {%- if header_items.size > 0 -%}
          {%- for block in header_items -%}
            <div class="custom-header--nav-item" {{ block.shopify_attributes }}>
              <a 
                href="{{ block.settings.url }}" 
                class="custom-header--nav-link"
                {% if block.settings.enable_mega %}data-mega-trigger="{{ block.id }}"{% endif %}
              >
                <span>{{ block.settings.title | escape }}</span>
                {%- if block.settings.enable_mega -%}
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" class="custom-header--arrow-icon">
                    <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Centro - Logo {%- endcomment -%}
    <div class="custom-header--center">
      {%- if request.page_type == 'index' -%}
        <h1 class="custom-header--logo">
          <a href="{{ routes.root_url }}" style="text-decoration: none; color: inherit;">
            {%- if logo_to_use != blank -%}
              {%- assign logo_width_2x = settings.logo_width | times: 2 -%}
              {%- if logo_to_use.format == 'svg' or logo_to_use.src contains '.svg' -%}
                <img
                  src="{{ logo_to_use | image_url }}"
                  alt="{{ shop.name }}"
                  class="custom-header--logo-image logo-static"
                  loading="eager"
                  width="{{ settings.logo_width }}"
                >
              {%- else -%}
                <img
                  src="{{ logo_to_use | image_url: width: settings.logo_width }}"
                  srcset="{{ logo_to_use | image_url: width: settings.logo_width }} 1x, {{ logo_to_use | image_url: width: logo_width_2x }} 2x"
                  alt="{{ shop.name }}"
                  class="custom-header--logo-image logo-static"
                  loading="eager"
                  width="{{ settings.logo_width }}"
                  {% if logo_to_use.aspect_ratio != blank %}
                    height="{{ settings.logo_width | divided_by: logo_to_use.aspect_ratio | round }}"
                  {% endif %}
                >
              {%- endif -%}
            {%- else -%}
              <span class="custom-header--logo-text logo-static">{{ settings.logo_text | escape }}</span>
            {%- endif -%}

            {%- comment -%} Sticky Logo {%- endcomment -%}
            {%- if logo_sticky != blank -%}
              {%- assign logo_width_2x = settings.logo_width | times: 2 -%}
              {%- if logo_sticky.format == 'svg' or logo_sticky.src contains '.svg' -%}
                <img src="{{ logo_sticky | image_url }}" alt="{{ shop.name }}" class="custom-header--logo-image logo-sticky" loading="eager" width="{{ settings.logo_width }}">
              {%- else -%}
                <img src="{{ logo_sticky | image_url: width: settings.logo_width }}" srcset="{{ logo_sticky | image_url: width: settings.logo_width }} 1x, {{ logo_sticky | image_url: width: logo_width_2x }} 2x" alt="{{ shop.name }}" class="custom-header--logo-image logo-sticky" loading="eager" width="{{ settings.logo_width }}" {% if logo_sticky.aspect_ratio != blank %}height="{{ settings.logo_width | divided_by: logo_sticky.aspect_ratio | round }}"{% endif %}>
              {%- endif -%}
            {%- else -%}
              <span class="custom-header--logo-text logo-sticky">{{ settings.logo_text | escape }}</span>
            {%- endif -%}
          </a>
        </h1>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="custom-header--logo">
          {%- if logo_to_use != blank -%}
            {%- assign logo_width_2x = settings.logo_width | times: 2 -%}
            {%- if logo_to_use.format == 'svg' or logo_to_use.src contains '.svg' -%}
              <img
                src="{{ logo_to_use | image_url }}"
                alt="{{ shop.name }}"
                class="custom-header--logo-image logo-static"
                loading="eager"
                width="{{ settings.logo_width }}"
              >
            {%- else -%}
              <img
                src="{{ logo_to_use | image_url: width: settings.logo_width }}"
                srcset="{{ logo_to_use | image_url: width: settings.logo_width }} 1x, {{ logo_to_use | image_url: width: logo_width_2x }} 2x"
                alt="{{ shop.name }}"
                class="custom-header--logo-image logo-static"
                loading="eager"
                width="{{ settings.logo_width }}"
                {% if logo_to_use.aspect_ratio != blank %}
                  height="{{ settings.logo_width | divided_by: logo_to_use.aspect_ratio | round }}"
                {% endif %}
              >
            {%- endif -%}
          {%- else -%}
            <span class="custom-header--logo-text logo-static">{{ settings.logo_text | escape }}</span>
          {%- endif -%}

          {%- comment -%} Sticky Logo {%- endcomment -%}
          {%- if logo_sticky != blank -%}
            {%- assign logo_width_2x = settings.logo_width | times: 2 -%}
            {%- if logo_sticky.format == 'svg' or logo_sticky.src contains '.svg' -%}
              <img src="{{ logo_sticky | image_url }}" alt="{{ shop.name }}" class="custom-header--logo-image logo-sticky" loading="eager" width="{{ settings.logo_width }}">
            {%- else -%}
              <img src="{{ logo_sticky | image_url: width: settings.logo_width }}" srcset="{{ logo_sticky | image_url: width: settings.logo_width }} 1x, {{ logo_sticky | image_url: width: logo_width_2x }} 2x" alt="{{ shop.name }}" class="custom-header--logo-image logo-sticky" loading="eager" width="{{ settings.logo_width }}" {% if logo_sticky.aspect_ratio != blank %}height="{{ settings.logo_width | divided_by: logo_sticky.aspect_ratio | round }}"{% endif %}>
            {%- endif -%}
          {%- else -%}
            <span class="custom-header--logo-text logo-sticky">{{ settings.logo_text | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Lado Derecho {%- endcomment -%}
    <div class="custom-header--right">
      {%- comment -%} Contenido Desktop {%- endcomment -%}
      <div class="custom-header--desktop-only custom-header--right-desktop">
        {%- if section.settings['show-locale-selector'] or section.settings['show-region-selector'] -%}
          <div class="custom-header--right-meta">
            {%- if section.settings['show-locale-selector'] -%}
              <span class="custom-header--right-label">{{ locale_label }}</span>
            {%- endif -%}
            {%- if section.settings['show-region-selector'] -%}
              <span class="custom-header--right-label custom-header--right-currency">{{ currency_label }}</span>
            {%- endif -%}
          </div>
          <span class="custom-header--right-divider" aria-hidden="true"></span>
        {%- endif -%}
        <div class="custom-header--icons">
          {%- if search_block -%}
          <button
            class="custom-header--icon-button custom-header--search-toggle"
            data-search-toggle
            aria-label="{{ search_t }}"
            type="button"
          >
            {%- if icon_search != blank -%}
              {%- if icon_search.format == 'svg' or icon_search.src contains '.svg' -%}
                {%- assign icon_search_url = icon_search | image_url -%}
              {%- else -%}
                {%- assign icon_search_url = icon_search | image_url: width: 40 -%}
              {%- endif -%}
              <img 
                src="{{ icon_search_url }}" 
                alt=""
                class="custom-header--icon custom-header--icon-search no-filter icon-static"
                width="20"
                height="20"
                loading="eager"
                aria-hidden="true"
              >
            {%- else -%}
              <img 
                src="{{ 'Search-header.svg' | asset_url }}" 
                alt=""
                class="custom-header--icon custom-header--icon-search icon-static"
                width="20"
                height="20"
                loading="eager"
                aria-hidden="true"
              >
            {%- endif -%}
            {%- if icon_search_sticky != blank -%}
              {%- if icon_search_sticky.format == 'svg' or icon_search_sticky.src contains '.svg' -%}
                {%- assign icon_search_sticky_url = icon_search_sticky | image_url -%}
              {%- else -%}
                {%- assign icon_search_sticky_url = icon_search_sticky | image_url: width: 40 -%}
              {%- endif -%}
              <img src="{{ icon_search_sticky_url }}" alt="" class="custom-header--icon custom-header--icon-search no-filter icon-sticky" width="20" height="20" loading="eager" aria-hidden="true">
            {%- else -%}
              <img src="{{ 'Search-header.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-search icon-sticky" width="20" height="20" loading="eager" aria-hidden="true">
            {%- endif -%}
          </button>
          {%- else -%}
          <a
            class="custom-header--icon-button custom-header--search-toggle"
            href="{{ routes.search_url }}"
            aria-label="{{ search_t }}"
          >
            {%- if icon_search != blank -%}
              {%- if icon_search.format == 'svg' or icon_search.src contains '.svg' -%}
                {%- assign icon_search_url = icon_search | image_url -%}
              {%- else -%}
                {%- assign icon_search_url = icon_search | image_url: width: 40 -%}
              {%- endif -%}
              <img 
                src="{{ icon_search_url }}" 
                alt=""
                class="custom-header--icon custom-header--icon-search no-filter icon-static"
                width="20"
                height="20"
                loading="eager"
                aria-hidden="true"
              >
            {%- else -%}
              <img 
                src="{{ 'Search-header.svg' | asset_url }}" 
                alt=""
                class="custom-header--icon custom-header--icon-search icon-static"
                width="20"
                height="20"
                loading="eager"
                aria-hidden="true"
              >
            {%- endif -%}
            {%- if icon_search_sticky != blank -%}
              {%- if icon_search_sticky.format == 'svg' or icon_search_sticky.src contains '.svg' -%}
                {%- assign icon_search_sticky_url = icon_search_sticky | image_url -%}
              {%- else -%}
                {%- assign icon_search_sticky_url = icon_search_sticky | image_url: width: 40 -%}
              {%- endif -%}
              <img src="{{ icon_search_sticky_url }}" alt="" class="custom-header--icon custom-header--icon-search no-filter icon-sticky" width="20" height="20" loading="eager" aria-hidden="true">
            {%- else -%}
              <img src="{{ 'Search-header.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-search icon-sticky" width="20" height="20" loading="eager" aria-hidden="true">
            {%- endif -%}
          </a>
          {%- endif -%}

          {%- if shop.customer_accounts_enabled -%}
            <a 
              class="custom-header--icon-button"
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
              aria-label="{{ account_t }}"
            >
              {%- if icon_account != blank -%}
                {%- if icon_account.format == 'svg' or icon_account.src contains '.svg' -%}
                  {%- assign icon_account_url = icon_account | image_url -%}
                {%- else -%}
                  {%- assign icon_account_url = icon_account | image_url: width: 40 -%}
                {%- endif -%}
                <img 
                  src="{{ icon_account_url }}" 
                  alt=""
                  class="custom-header--icon custom-header--icon-account no-filter icon-static"
                  width="20"
                  height="23.53"
                  loading="eager"
                  aria-hidden="true"
                >
              {%- else -%}
                <img 
                  src="{{ 'Dashboard.svg' | asset_url }}" 
                  alt=""
                  class="custom-header--icon custom-header--icon-account icon-static"
                  width="20"
                  height="23.53"
                  loading="eager"
                  aria-hidden="true"
                >
              {%- endif -%}
              {%- if icon_account_sticky != blank -%}
                {%- if icon_account_sticky.format == 'svg' or icon_account_sticky.src contains '.svg' -%}
                  {%- assign icon_account_sticky_url = icon_account_sticky | image_url -%}
                {%- else -%}
                  {%- assign icon_account_sticky_url = icon_account_sticky | image_url: width: 40 -%}
                {%- endif -%}
                <img src="{{ icon_account_sticky_url }}" alt="" class="custom-header--icon custom-header--icon-account no-filter icon-sticky" width="20" height="23.53" loading="eager" aria-hidden="true">
              {%- else -%}
                <img src="{{ 'Dashboard.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-account icon-sticky" width="20" height="23.53" loading="eager" aria-hidden="true">
              {%- endif -%}
            </a>
          {%- endif -%}

          {%- if shop.customer_accounts_enabled -%}
            <a
              class="custom-header--icon-button custom-header--wishlist"
              href="{{ wishlist_url }}"
              aria-label="Favorites"
            >
              {%- if icon_wishlist != blank -%}
                {%- if icon_wishlist.format == 'svg' or icon_wishlist.src contains '.svg' -%}
                  {%- assign icon_wishlist_url = icon_wishlist | image_url -%}
                {%- else -%}
                  {%- assign icon_wishlist_url = icon_wishlist | image_url: width: 46 -%}
                {%- endif -%}
                <img 
                  src="{{ icon_wishlist_url }}" 
                  alt=""
                  class="custom-header--icon custom-header--icon-favorite no-filter icon-static"
                  width="23"
                  height="20"
                  loading="eager"
                  aria-hidden="true"
                >
              {%- else -%}
                <img 
                  src="{{ 'favorite.svg' | asset_url }}" 
                  alt=""
                  class="custom-header--icon custom-header--icon-favorite icon-static"
                  width="23"
                  height="20"
                  loading="eager"
                  aria-hidden="true"
                >
              {%- endif -%}
              {%- if icon_wishlist_sticky != blank -%}
                {%- if icon_wishlist_sticky.format == 'svg' or icon_wishlist_sticky.src contains '.svg' -%}
                  {%- assign icon_wishlist_sticky_url = icon_wishlist_sticky | image_url -%}
                {%- else -%}
                  {%- assign icon_wishlist_sticky_url = icon_wishlist_sticky | image_url: width: 46 -%}
                {%- endif -%}
                <img src="{{ icon_wishlist_sticky_url }}" alt="" class="custom-header--icon custom-header--icon-favorite no-filter icon-sticky" width="23" height="20" loading="eager" aria-hidden="true">
              {%- else -%}
                <img src="{{ 'favorite.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-favorite icon-sticky" width="23" height="20" loading="eager" aria-hidden="true">
              {%- endif -%}
            </a>
          {%- endif -%}

          <button
