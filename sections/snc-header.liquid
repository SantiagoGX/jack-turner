  border-radius: 999px;
  font-family: var(--font-main);
  font-size: 13px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease, transform 0.3s ease;
  z-index: 1010;
}

.custom-header--cart-toast.is-visible {
  opacity: 1;
  transform: translate(-50%, -10px);
}

/* Responsive - Burger Menu */
@media (max-width: 768px) {
  .custom-header--burger-panel {
    max-width: calc(100% - (var(--mobile-menu-side-offset, 10px) * 2));
  }
}

  .custom-header--wishlist-remove {
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: #999;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
    margin-left: 5px;
  }
  .custom-header--wishlist-remove:hover {
    color: #C0392B;
  }

  /* Estilos para tendencias de búsqueda */
  .custom-header--search-trending {
    margin-top: 30px;
    text-align: center;
    width: 100%;
    background: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    position: relative;
    z-index: 10;
  }
  .custom-header--search-trending-title {
    font-family: var(--font-main);
    font-size: 12px;
    text-transform: uppercase;
    color: #666;
    margin-bottom: 15px;
    letter-spacing: 1px;
    font-weight: 700;
  }
  .custom-header--search-trending-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .custom-header--search-trending-item {
    font-family: var(--font-main);
    font-size: 16px;
    color: #0d0d0d;
    text-decoration: none;
    padding: 8px 20px;
    background: #f5f5f5;
    border-radius: 30px;
    transition: all 0.3s ease;
  }
  .custom-header--search-trending-item:hover {
    background: #0d0d0d;
    color: #fff;
  }

  /* Estilos para resultados de búsqueda predictiva */
  .custom-header--search-results {
    width: 100%;
    margin-top: 10px;
    text-align: left;
    max-height: 60vh;
    overflow-y: auto;
    background: #fff;
  border-radius: var(--search-results-radius, 10px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    position: relative;
    z-index: 10;
  }
  .custom-header--search-results:empty {
    display: none;
  }
  .custom-header--search-result-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 10px;
    border-bottom: 1px solid #f0f0f0;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }
  .custom-header--search-result-item:hover {
    background: #f9f9f9;
  }
  .custom-header--search-result-image {
    width: var(--search-result-image-width, 50px);
    height: var(--search-result-image-width, 50px);
    object-fit: cover;
    border-radius: 5px;
    background: #f5f5f5;
    filter: brightness(var(--search-result-image-brightness, 100%));
  }
  .custom-header--search-result-info {
    flex: 1;
  }
  .custom-header--search-result-title {
    font-family: var(--font-main);
    font-size: var(--search-result-title-size, 14px);
    font-weight: var(--search-result-title-weight, 700);
    color: var(--search-result-title-color, #0d0d0d);
    margin: 0 0 4px 0;
  }
  .custom-header--search-section-title {
    font-family: var(--font-main);
    font-size: 11px;
    text-transform: uppercase;
    color: #999;
    padding: 10px 10px 5px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  .custom-header--search-result-image.placeholder {
    background-color: #f0f0f0;
  }
  .custom-header--search-result-price {
    font-family: var(--font-main);
    font-size: var(--search-result-price-size, 13px);
    font-weight: var(--search-result-price-weight, 400);
    color: #666;
    margin: 0;
  }
  .custom-header--search-view-all,
  .custom-header--search-no-results {
    display: block;
    text-align: center;
    padding: 15px;
    font-family: var(--font-main);
    font-size: 14px;
    color: var(--search-view-all-color, #0d0d0d);
    text-decoration: none;
    font-weight: var(--search-view-all-weight, 700);
  }
  .custom-header--search-view-all:hover {
    text-decoration: underline;
  }

  .custom-header--search-wrapper {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 20px;
    position: relative;
    z-index: 10;
    top: calc(var(--custom-header-total-height, 66.53px) + 10px);
  }
  .custom-header--search-bar-container {
    width: 100%;
    position: relative;
    z-index: 20;
  }
  
  /* Estilos para selectores de wishlist */
  .custom-header--wishlist-options {
    display: flex;
    gap: 5px;
    margin-top: 5px;
    flex-wrap: wrap;
  }
  .custom-header--wishlist-select {
    max-width: 100%;
