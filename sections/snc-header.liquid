/* ----------------------------------------
   BURGER MENU OVERLAY
   ---------------------------------------- */
.custom-header--burger-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1200;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
  display: none;
}

.custom-header--burger-overlay.is-initialized {
  display: block;
}

.custom-header--burger-overlay-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.custom-header--burger-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.52);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.custom-header--burger-panel {
  position: absolute;
  top: var(--mobile-menu-top-offset, calc(var(--custom-header-total-height, 66.53px) + 10px));
  bottom: var(--mobile-menu-bottom-offset, 20px);
  left: var(--mobile-menu-side-offset, 10px);
  right: var(--mobile-menu-side-offset, 10px);
  width: calc(100% - (var(--mobile-menu-side-offset, 10px) * 2));
  max-width: 480px;
  background-color: #ffffff;
  border-radius: var(--mobile-menu-border-radius, 10px);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  transform: translateX(-100%) translateY(-20px);
  opacity: 0;
  transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.custom-header--burger-overlay-open .custom-header--burger-panel {
  transform: translateX(0) translateY(0);
  opacity: 1;
}

/* Header del panel */
.custom-header--burger-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px;
  box-sizing: border-box;
  position: relative;
}

.custom-header--burger-title {
