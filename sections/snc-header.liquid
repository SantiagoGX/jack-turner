/* ----------------------------------------
   RESPONSIVE - MOBILE
   ---------------------------------------- */
@media (max-width: 768px) {
  /* Ocultar elementos de escritorio */
  .custom-header--desktop-only {
    display: none !important;
  }

  /* Mostrar elementos móviles */
  .custom-header--mobile-only {
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  /* Header principal - asegurar que quepa en pantalla */
  .custom-header--root {
    min-height: 56px;
    height: 56px;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
  }
  
  .custom-header--wrapper {
    padding: 10px 15px;
    min-height: 56px;
    height: 56px;
    gap: 15px;
    justify-content: space-between;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Lado izquierdo: hamburger visible */
  .custom-header--left {
    gap: 0;
    flex: 0 0 auto;
    min-width: 40px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .custom-header--menu-toggle {
    width: 40px;
    height: 40px;
    padding: 10px;
    display: flex !important;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
  }

  @media (min-width: 769px) {
    .custom-header--menu-toggle[style*="display: none"] {
      display: none !important;
    }
  }

  .custom-header--burger-icon {
    width: 20px;
    height: 14px;
  }

  /* Centro: logo pequeño y centrado */
  .custom-header--center {
    position: static;
    transform: none;
    flex: 1;
    justify-content: flex-start;
    display: flex;
    align-items: center;
  }

  .custom-header--logo-image {
    max-width: 100%;
    width: {{ settings.logo_width | times: 0.8 | round }}px;
    height: auto;
    object-fit: contain;
  }

  .custom-header--logo-text {
    font-size: 14px;
  }

  /* Lado derecho: solo carrito */
  .custom-header--right {
    gap: 0;
    flex: 0 0 auto;
    min-width: 40px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .custom-header--icon-button {
    width: 24px;
    height: 24px;
    padding: 0;
    margin: 0 !important;
  }

  .custom-header--icon {
    width: 20px;
    height: 20px;
  }

  .custom-header--cart-count,
  .custom-header--wishlist-count {
    width: 14px;
    height: 14px;
    font-size: 9px;
    top: -3px;
    right: -3px;
  }

  /* Announcement bar más compacto */
  .custom-header--announcement {
    height: auto;
    padding: 6px 10px;
    font-size: 11px;
  }

  /* Ocultar dropdowns y navegación */
  .custom-header--dropdown {
    display: none !important;
  }

  .custom-header--nav-links {
    display: none !important;
  }
}

