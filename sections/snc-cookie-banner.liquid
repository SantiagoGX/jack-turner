{% schema %}
{
  "name": "SNC Cookie Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable cookie banner",
      "default": true
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "We use cookies to enhance your browsing experience and analyse site traffic."
    },
    {
      "type": "url",
      "id": "policy_link",
      "label": "Privacy policy link"
    },
    {
      "type": "text",
      "id": "accept_label",
      "label": "Accept button",
      "default": "Accept"
    },
    {
      "type": "text",
      "id": "decline_label",
      "label": "Decline button",
      "default": "Decline"
    }
  ]
}
{% endschema %}

{%- if section.settings.enable -%}
<div id="snc-cookie-bar" class="snc-cookie-bar" aria-live="polite" aria-label="Cookie consent" hidden>
  <p class="snc-cookie-bar--text">
    {{ section.settings.message | escape }}
    {%- if section.settings.policy_link != blank -%}
      &ensp;<a href="{{ section.settings.policy_link }}">Privacy Policy</a>
    {%- endif -%}
  </p>
  <div class="snc-cookie-bar--actions">
    <button type="button" class="snc-cookie-bar--accept" data-cookie-accept>
      {{ section.settings.accept_label | escape }}
    </button>
    <button type="button" class="snc-cookie-bar--decline" data-cookie-decline>
      {{ section.settings.decline_label | escape }}
    </button>
  </div>
</div>

<style>
  .snc-cookie-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9998;
    background: #0d0d0d;
    border-top: 1px solid #8b7355;
    padding: 0 48px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    transform: translateY(100%);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .snc-cookie-bar.is-visible {
    transform: translateY(0);
  }

  .snc-cookie-bar--text {
    font-family: var(--font-main);
    font-size: 10px;
    color: #c9c4bc;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .snc-cookie-bar--text a {
    color: #8b7355;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .snc-cookie-bar--actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 0 0 auto;
  }

  .snc-cookie-bar--accept {
    font-family: var(--font-main);
    font-size: 10px;
    font-weight: 500;
    color: #0d0d0d;
    background: #f4f2ef;
    border: none;
    padding: 8px 22px;
    cursor: pointer;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 0;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .snc-cookie-bar--accept:hover { opacity: 0.75; }

  .snc-cookie-bar--decline {
    font-family: var(--font-main);
    font-size: 10px;
    color: #4a4a48;
    background: none;
    border: none;
    cursor: pointer;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .snc-cookie-bar--decline:hover { color: #c9c4bc; }

  @media (max-width: 767px) {
    .snc-cookie-bar {
      padding: 14px 20px;
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .snc-cookie-bar--text {
      font-size: 9px;
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
      letter-spacing: 0.08em;
    }
    .snc-cookie-bar--actions {
      gap: 18px;
    }
    .snc-cookie-bar--accept {
      padding: 7px 18px;
    }
  }
</style>

<script>
(function() {
  var KEY = 'snc_cookie_consent';
  if (localStorage.getItem(KEY)) return;

  var bar = document.getElementById('snc-cookie-bar');
  if (!bar) return;
  bar.removeAttribute('hidden');

  setTimeout(function() { bar.classList.add('is-visible'); }, 800);

  function dismiss(value) {
    localStorage.setItem(KEY, value);
    var exp = new Date(Date.now() + 365 * 864e5).toUTCString();
    document.cookie = KEY + '=' + value + '; expires=' + exp + '; path=/; SameSite=Lax';
    bar.classList.remove('is-visible');
    setTimeout(function() { bar.remove(); }, 500);
  }

  bar.querySelector('[data-cookie-accept]').addEventListener('click', function() { dismiss('accepted'); });
  bar.querySelector('[data-cookie-decline]').addEventListener('click', function() { dismiss('declined'); });
})();
</script>
{%- endif -%}
