          <div class="pdp-hero--payment-icons">
            {%- assign default_payment_types = 'visa,master,american_express,paypal,apple_pay,google_pay' | split: ',' -%}
            {%- for type in default_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            {%- endfor -%}
            {%- for type in shop.enabled_payment_types -%}
              {%- unless default_payment_types contains type -%}
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
