  <script>
  (() => {
    function initPdpAccordions(root) {
      if (!root) return;
      root.querySelectorAll('[data-accordion]').forEach((acc) => {
        // Guard against double-initialization
        if (acc.dataset.pdpAccordionInit) return;
        acc.dataset.pdpAccordionInit = '1';

        const toggle = acc.querySelector('[data-accordion-toggle]');
        const content = acc.querySelector('[data-accordion-content]');
        if (!toggle) return;

        const setOpen = (open) => {
          acc.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (content) {
            content.setAttribute('aria-hidden', open ? 'false' : 'true');
            content.style.maxHeight = open ? content.scrollHeight + 'px' : '0px';
          }
        };

        // Estado inicial
        setOpen(acc.classList.contains('is-open'));

        toggle.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopImmediatePropagation();
          setOpen(!acc.classList.contains('is-open'));
        }, true);

        // Close button at bottom of content
        if (content) {
          const closeBtn = document.createElement('button');
          closeBtn.type = 'button';
          closeBtn.className = 'pdp-hero--accordion-close-btn';
          closeBtn.setAttribute('aria-label', 'Collapse section');
          closeBtn.innerHTML = '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3.5 10.5L8 6l4.5 4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Close</span>';
          closeBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            setOpen(false);
            acc.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
          content.appendChild(closeBtn);
        }

      });

      // Recalcular alturas en resize (solo para los abiertos)
      window.addEventListener(
        'resize',
        () => {
          root.querySelectorAll('[data-accordion].is-open [data-accordion-content]').forEach((content) => {
            content.style.maxHeight = content.scrollHeight + 'px';
          });
        },
        { passive: true }
      );
    }

    function initPdpDescriptionToggles(root) {
      if (!root) return;
      const wraps = root.querySelectorAll('[data-pdp-description]');
      wraps.forEach((wrap) => {
        const excerpt = wrap.querySelector('[data-pdp-description-excerpt]');
        const full = wrap.querySelector('[data-pdp-description-full]');
        const toggle = wrap.querySelector('[data-pdp-description-toggle]');
        const fade = wrap.querySelector('.pdp-hero--description-fade');
        if (!excerpt || !full || !toggle) return;

        const setExpanded = (expanded) => {
          wrap.classList.toggle('is-expanded', expanded);
          toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
          toggle.textContent = expanded ? 'Read less' : 'Read more';
          if (fade) fade.style.display = expanded ? 'none' : '';
        };

        wrap.classList.remove('is-collapsible');
        setExpanded(true);

        const measure = () => {
          const isExpanded = wrap.classList.contains('is-expanded');
          if (isExpanded) return;

          const excerptText = (excerpt.textContent || '').trim();
          const fullText = (full.textContent || '').trim();
          const needsToggle =
            (fullText.length > excerptText.length + 5) ||
            (excerpt.scrollHeight > excerpt.clientHeight + 2);

          wrap.classList.toggle('is-collapsible', needsToggle);
          if (!needsToggle) {
            toggle.style.display = 'none';
            if (fade) fade.style.display = 'none';
          } else {
            toggle.style.display = '';
            if (fade) fade.style.display = '';
          }
        };

        toggle.addEventListener('click', () => {
          const expanded = wrap.classList.contains('is-expanded');
          setExpanded(!expanded);
        });

        measure();
        window.addEventListener('resize', measure, { passive: true });
      });
    }

    const rootSelector = '.pdp-hero--root[data-section-id="{{ section.id }}"]';
    const getRoot = () => document.querySelector(rootSelector);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initPdpDescriptionToggles(getRoot()), { once: true });
      document.addEventListener('DOMContentLoaded', () => initPdpAccordions(getRoot()), { once: true });
    } else {
      initPdpDescriptionToggles(getRoot());
      initPdpAccordions(getRoot());
    }
  })();

  // White Modal Gallery functionality (Luxury style with Pan/Drag)
  (function() {
    const modal = document.getElementById('pdp-hero-white-modal');
    if (!modal) return;
    
    const modalImg = document.getElementById('pdp-hero-white-modal-img');
    const currentSpan = document.getElementById('pdp-hero-white-modal-current');
    const totalSpan = document.getElementById('pdp-hero-white-modal-total');
    const hintText = document.getElementById('pdp-hero-zoom-hint');
    const closeBtn = modal.querySelector('[data-white-modal-close]');
    const prevBtn = modal.querySelector('[data-white-modal-prev]');
    const nextBtn = modal.querySelector('[data-white-modal-next]');
    
    const galleryItems = document.querySelectorAll('[data-gallery-item]');
    const images = Array.from(galleryItems).map(item => item.querySelector('.pdp-hero--main-image'));
    const totalImages = images.length;
    let currentIndex = 0;
    let isZoomed = false;
    
    // Pan/Drag variables
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let translateX = 0;
    let translateY = 0;
    let currentTranslateX = 0;
    let currentTranslateY = 0;
    
    if (totalImages === 0) return;
    
    // Update total counter
    if (totalSpan) totalSpan.textContent = totalImages;
    
    function openModal(index) {
      currentIndex = index;
      updateModalImage();
      modal.classList.add('is-active');
      document.body.style.overflow = 'hidden';
      resetZoomAndPan();
    }
    
    function closeModal() {
      modal.classList.remove('is-active');
      document.body.style.overflow = '';
      resetZoomAndPan();
    }
    
    function resetZoomAndPan() {
      isZoomed = false;
      isDragging = false;
      translateX = 0;
      translateY = 0;
      currentTranslateX = 0;
      currentTranslateY = 0;
      if (modalImg) {
        modalImg.classList.remove('is-zoomed');
        modalImg.style.transform = 'scale(1)';
        modalImg.style.cursor = 'zoom-in';
      }
      if (hintText) {
        hintText.textContent = 'Double click to zoom';
        hintText.style.opacity = '';
        hintText.style.animation = '';
      }
    }
    
    function updateModalImage() {
      const img = images[currentIndex];
      if (img && modalImg) {
        modalImg.src = img.dataset.highRes || img.src;
        modalImg.alt = img.alt;
      }
      if (currentSpan) {
        currentSpan.textContent = currentIndex + 1;
      }
      // Reset zoom and pan when changing images
      resetZoomAndPan();
    }
    
    function goToPrev() {
      currentIndex = (currentIndex - 1 + totalImages) % totalImages;
      updateModalImage();
    }
    
    function goToNext() {
      currentIndex = (currentIndex + 1) % totalImages;
      updateModalImage();
    }
    
    function applyTransform() {
      if (!modalImg) return;
      const scale = isZoomed ? 2.5 : 1;
      modalImg.style.transform = `translate(${currentTranslateX}px, ${currentTranslateY}px) scale(${scale})`;
    }
    
    function toggleZoom(e) {
      if (!modalImg) return;
      
      if (isZoomed) {
        // Zoom out
        resetZoomAndPan();
        if (hintText) hintText.textContent = 'Doble clic para zoom';
      } else {
        // Zoom in
        isZoomed = true;
        modalImg.classList.add('is-zoomed');
        modalImg.style.cursor = 'grab';
        
        // Update hint for pan mode
        if (hintText) {
          hintText.textContent = 'Drag to explore';
          hintText.style.opacity = '1';
          hintText.style.animation = 'none';
          // Fade out after 2 seconds
          setTimeout(() => {
            hintText.style.transition = 'opacity 0.5s ease';
            hintText.style.opacity = '0';
          }, 2000);
        }
        
        // Center zoom on click position
        const rect = modalImg.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        
        modalImg.style.transformOrigin = `${x}% ${y}%`;
        applyTransform();
      }
    }
    
    // Pan/Drag functionality
    function startDrag(e) {
      if (!isZoomed || !modalImg) return;
      
      isDragging = true;
      modalImg.style.cursor = 'grabbing';
      
      // Get start position (mouse or touch)
      if (e.type === 'touchstart') {
        startX = e.touches[0].clientX - currentTranslateX;
        startY = e.touches[0].clientY - currentTranslateY;
      } else {
        startX = e.clientX - currentTranslateX;
        startY = e.clientY - currentTranslateY;
      }
      
      e.preventDefault();
    }
    
    function drag(e) {
      if (!isDragging || !isZoomed || !modalImg) return;
      
      let clientX, clientY;
      
      if (e.type === 'touchmove') {
        clientX = e.touches[0].clientX;
        clientY = e.touches[0].clientY;
      } else {
        clientX = e.clientX;
        clientY = e.clientY;
      }
      
      translateX = clientX - startX;
      translateY = clientY - startY;
      
      // Calculate boundaries to prevent dragging image completely out of view
      const rect = modalImg.getBoundingClientRect();
      const scaledWidth = rect.width * 2.5;
      const scaledHeight = rect.height * 2.5;
      const maxTranslateX = (scaledWidth - rect.width) / 2;
      const maxTranslateY = (scaledHeight - rect.height) / 2;
      
      // Limit pan within reasonable bounds
      currentTranslateX = Math.max(-maxTranslateX, Math.min(maxTranslateX, translateX));
      currentTranslateY = Math.max(-maxTranslateY, Math.min(maxTranslateY, translateY));
      
      applyTransform();
    }
    
    function endDrag() {
      if (!isDragging) return;
      isDragging = false;
      if (modalImg) {
        modalImg.style.cursor = 'grab';
      }
    }
    
    // Add click handlers to gallery images
    galleryItems.forEach((item, index) => {
      item.addEventListener('click', () => openModal(index));
    });
    
    // Modal controls
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (prevBtn) prevBtn.addEventListener('click', goToPrev);
    if (nextBtn) nextBtn.addEventListener('click', goToNext);
    
    // Double click to zoom inside modal
    if (modalImg) {
      modalImg.addEventListener('dblclick', toggleZoom);
      
      // Drag events for panning when zoomed
      modalImg.addEventListener('mousedown', startDrag);
      modalImg.addEventListener('touchstart', startDrag, { passive: false });
      
      window.addEventListener('mousemove', drag);
      window.addEventListener('touchmove', drag, { passive: false });
      
      window.addEventListener('mouseup', endDrag);
      window.addEventListener('touchend', endDrag);
      
      // Prevent default drag behavior on image
      modalImg.addEventListener('dragstart', (e) => e.preventDefault());
    }
    
    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('is-active')) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft' && !isZoomed) goToPrev();
      if (e.key === 'ArrowRight' && !isZoomed) goToNext();
    });
    
    // Close on background click (but not on image)
    modal.addEventListener('click', (e) => {
      if (e.target === modal || e.target.closest('.pdp-hero--white-modal-container')) {
        if (e.target !== modalImg && !e.target.closest('.pdp-hero--white-modal-image-wrapper')) {
          closeModal();
        }
      }
    });
    
    // Touch gestures for mobile (swipe when not zoomed)
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    
    modal.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });
    
    modal.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const touchEndY = e.changedTouches[0].screenY;
      
      // Only swipe if not zoomed or if it's a horizontal swipe
      if (!isZoomed) {
        handleSwipe();
      }
    }, { passive: true });
    
    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;
      
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          goToNext(); // Swipe left = next
        } else {
          goToPrev(); // Swipe right = previous
        }
      }
    }
  })();

  (function () {
    const root = document.querySelector('.pdp-hero--root[data-section-id="{{ section.id }}"]');
    if (!root) return;

    const trigger = root.querySelector('[data-youtube-corner-open]');
    const lightbox = document.getElementById('pdp-hero-youtube-lightbox-{{ section.id }}');
    if (!trigger) return;

    const action = trigger.getAttribute('data-youtube-action') || 'modal';
    const linkUrl = (trigger.getAttribute('data-youtube-link') || '').trim();
    const openInNewTab = trigger.getAttribute('data-youtube-link-new-tab') === 'true';

    if (action === 'link' && linkUrl !== '') {
      trigger.addEventListener('click', function () {
        if (openInNewTab) {
          window.open(linkUrl, '_blank', 'noopener');
        } else {
          window.location.href = linkUrl;
        }
      });
      return;
    }

    if (!lightbox) return;
    const closeButtons = lightbox.querySelectorAll('[data-youtube-corner-close]');

    function openLightbox() {
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', openLightbox);
    closeButtons.forEach((btn) => btn.addEventListener('click', closeLightbox));

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !lightbox.hidden) {
        closeLightbox();
      }
    });
  })();

  // Dynamic Shipping Estimate
  (function () {
    var els = document.querySelectorAll('[data-delivery-estimation]');
    if (!els.length) return;

    function addBusinessDays(date, days) {
      var result = new Date(date);
      var added = 0;
      while (added < days) {
        result.setDate(result.getDate() + 1);
        var d = result.getDay();
        if (d !== 0 && d !== 6) added++;
      }
      return result;
    }

    function fmtDate(date) {
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    els.forEach(function (el) {
      var minDays   = parseInt(el.dataset.minDays, 10) || 3;
      var maxDays   = parseInt(el.dataset.maxDays, 10) || 6;
      var country   = (el.dataset.country || '').trim();
      var prefix    = (el.dataset.prefix || '').trim();
      var suffix    = (el.dataset.suffix || '').trim();
      var showDates = el.dataset.showDates === 'true';

      // Apply CSS custom properties for typography
      var fs  = el.dataset.fontSize;
      var fw  = el.dataset.fontWeight;
      var col = el.dataset.color;
      var ls  = el.dataset.letterSpacing;
      var gap = el.dataset.wordGap;
      if (fs)  el.style.setProperty('--delivery-font-size',     fs  + 'px');
      if (fw)  el.style.setProperty('--delivery-font-weight',   fw);
      if (col) el.style.setProperty('--delivery-text-color',    col);
      if (ls)  el.style.setProperty('--delivery-letter-spacing', ls + 'px');
      if (gap) el.style.setProperty('--delivery-segment-gap',   gap + 'px');

      var range = (minDays === maxDays) ? String(minDays) : (minDays + '–' + maxDays);
      var parts = [];
      if (prefix)  parts.push(prefix);
      parts.push(range);
      if (suffix)  parts.push(suffix);
      if (country) parts.push('to ' + country);

      if (showDates) {
        var now     = new Date();
        var earliest = addBusinessDays(now, minDays);
        var latest   = addBusinessDays(now, maxDays);
        var dateStr  = fmtDate(earliest) + '–' + fmtDate(latest);
        parts.push('·');
        parts.push('Est. ' + dateStr);
      }

      el.innerHTML = parts.map(function (p) { return '<span>' + p + '</span>'; }).join('');
    });
  })();
</script>


