          {%- capture content_style -%}
            --accordion-content-padding-vertical: {{ content_padding_vertical }}px;
            --accordion-content-padding-horizontal: {{ content_padding_horizontal }}px;
          {%- endcapture -%}
          <div class="pdp-hero--accordion" data-accordion data-accordion-id="{{ block.id }}" style="{{ accordion_style | strip_newlines }}">
              <button
                type="button"
                class="pdp-hero--accordion-button"
                data-accordion-toggle
                aria-controls="pdp-accordion-{{ block.id }}"
                aria-expanded="false"
                style="{{ button_style | strip_newlines }}"
              >
                <span>{{ block.settings.title | default: 'Más información' }}</span>
                <span class="pdp-hero--accordion-arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" role="presentation" focusable="false">
                    <path d="M3.5 5.5L8 10l4.5-4.5"></path>
                  </svg>
                </span>
              </button>
              <div
                class="pdp-hero--accordion-content"
                id="pdp-accordion-{{ block.id }}"
                data-accordion-content
                aria-hidden="true"
                style="{{ content_style | strip_newlines }}"
              >
                <div class="pdp-hero--accordion-text">
                  {{ block.settings.content | default: '<p>Contenido adicional del producto.</p>' }}
                </div>
              </div>
            </div>
          {% when 'complementary' %}
            {%- if block.settings.products != blank -%}
              {%- assign comp_bg = block.settings.background_color | default: '#FAFAFA' -%}
              {%- assign comp_padding = block.settings.padding | default: 20 -%}
              {%- assign comp_radius = block.settings.border_radius | default: 8 -%}
              {%- assign comp_title_color = block.settings.title_color | default: '#0d0d0d' -%}
              {%- assign comp_title_weight = block.settings.title_font_weight | default: 400 -%}
              {%- assign comp_title_size = block.settings.title_font_size | default: 16 -%}
              {%- assign comp_prod_title_color = block.settings.product_title_color | default: '#0d0d0d' -%}
              {%- assign comp_prod_title_weight = block.settings.product_title_font_weight | default: 700 -%}
              {%- assign comp_prod_price_color = block.settings.product_price_color | default: '#666666' -%}
              {%- assign comp_btn_bg = block.settings.add_btn_bg | default: '#ffffff' -%}
              {%- assign comp_btn_color = block.settings.add_btn_color | default: '#0d0d0d' -%}
              {%- assign comp_btn_hover_bg = block.settings.add_btn_hover_bg | default: '#0d0d0d' -%}
              {%- assign comp_btn_hover_color = block.settings.add_btn_hover_color | default: '#ffffff' -%}

              <div class="pdp-hero--complementary" style="background-color: {{ comp_bg }}; padding: {{ comp_padding }}px; border-radius: {{ comp_radius }}px; --comp-btn-bg: {{ comp_btn_bg }}; --comp-btn-color: {{ comp_btn_color }}; --comp-btn-hover-bg: {{ comp_btn_hover_bg }}; --comp-btn-hover-color: {{ comp_btn_hover_color }};">
                <h3 class="pdp-hero--complementary-title" style="color: {{ comp_title_color }}; font-weight: {{ comp_title_weight }}; font-size: {{ comp_title_size }}px;">{{ block.settings.title | escape }}</h3>
                <div class="pdp-hero--complementary-grid">
                  {%- for product in block.settings.products -%}
                    {%- if product.available -%}
                    <div class="pdp-hero--complementary-item">
                      <a href="{{ product.url }}" class="pdp-hero--complementary-image">
                        <img src="{{ product.featured_image | image_url: width: 140 }}" loading="lazy" alt="{{ product.title | escape }}">
                      </a>
                      <div class="pdp-hero--complementary-info">
                        <a href="{{ product.url }}" class="pdp-hero--complementary-link">
                          <p class="pdp-hero--complementary-name" style="color: {{ comp_prod_title_color }}; font-weight: {{ comp_prod_title_weight }};">{{ product.title | capitalize }}</p>
                          <p class="pdp-hero--complementary-price" style="color: {{ comp_prod_price_color }};">{{ product.price | money_without_trailing_zeros }}</p>
                        </a>
                        <div class="pdp-hero--complementary-actions">
                        {%- unless product.has_only_default_variant -%}
                          <select class="pdp-hero--complementary-select" aria-label="Seleccionar variante">
                            {%- for variant in product.variants -%}
                              <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }}</option>
                            {%- endfor -%}
                          </select>
                        {%- endunless -%}
                          <button class="pdp-hero--complementary-add" type="button" aria-label="Add {{ product.title }}" data-quick-add="{{ product.selected_or_first_available_variant.id }}">
                            {%- if global_icon_plus != blank -%}
                              <img src="{{ global_icon_plus | image_url: width: 28 }}" alt="Add" width="14" height="14" style="display: block; object-fit: contain;">
                            {%- else -%}
                              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            {%- endif -%}
                          </button>
                        </div>
                      </div>
                    </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {% when 'specifications' %}
            {%- assign specs_raw = product.metafields.custom.specifications.value -%}
            {%- if specs_raw != blank -%}
              {%- assign spec_lines = specs_raw | newline_to_br | replace: '<br />', '<br>' | split: '<br>' -%}
              {%- assign has_valid_specs = false -%}
              {%- for line in spec_lines -%}
                {%- assign trimmed = line | strip -%}
                {%- if trimmed != blank -%}{%- assign has_valid_specs = true -%}{%- endif -%}
              {%- endfor -%}
              {%- if has_valid_specs -%}
                <div class="pdp-hero--accordion pdp-hero--specs-accordion" data-accordion data-accordion-id="specs-{{ section.id }}" {{ block.shopify_attributes }}>
                  <button
                    type="button"
                    class="pdp-hero--accordion-button"
                    data-accordion-toggle
                    aria-controls="pdp-accordion-specs-{{ section.id }}"
                    aria-expanded="false"
                  >
                    <span>{{ block.settings.title | default: 'Specifications' }}</span>
                    <span class="pdp-hero--accordion-arrow" aria-hidden="true">
                      <svg viewBox="0 0 16 16" role="presentation" focusable="false">
                        <path d="M3.5 5.5L8 10l4.5-4.5"></path>
                      </svg>
                    </span>
                  </button>
                  <div
                    class="pdp-hero--accordion-content"
                    id="pdp-accordion-specs-{{ section.id }}"
                    data-accordion-content
                    aria-hidden="true"
                  >
                    <div class="pdp-hero--accordion-text">
                      <!-- debug: {{ spec_lines.size }} lines -->
                      <dl class="pdp-hero--specs-dl">
                        {%- for line in spec_lines -%}
                          {%- assign trimmed_line = line | strip_html | strip -%}
                          {%- if trimmed_line != blank -%}
                            {%- assign parts = trimmed_line | split: ': ' -%}
                            {%- if parts.size >= 2 -%}
                              {%- assign spec_key = parts[0] | strip -%}
                              {%- assign spec_val = trimmed_line | remove_first: parts[0] | remove_first: ': ' | strip -%}
                            {%- else -%}
                              {%- assign spec_key = trimmed_line -%}
                              {%- assign spec_val = '' -%}
                            {%- endif -%}
                            <div class="pdp-hero--spec-row">
                              <dt class="pdp-hero--spec-key">{{ spec_key }}</dt>
                              {%- if spec_val != blank -%}
                                <dd class="pdp-hero--spec-val">{{ spec_val }}</dd>
                              {%- else -%}
                                <dd class="pdp-hero--spec-val"></dd>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </dl>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          {% when '@app' %}
            {% render block %}
          {% endcase %}
        {%- endfor -%}
        {% render 'snc-sticky-atc', product: product %}
      </div>

    </div>
  </div>

</div>

{%- comment -%} White Modal Gallery (Luxury Style) {%- endcomment -%}
