              <button type="button" class="pdp-hero--button pdp-hero--button-add-cart" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>{{ add_label }}</button>
            {%- endif -%}
            {%- if show_buy_button -%}
              <button type="button" class="pdp-hero--button pdp-hero--button-buy-now" data-buy-now {% unless current_variant.available %}disabled{% endunless %}>{{ buy_label }}</button>
            {%- endif -%}
