        <script>
          (function() {
            const container = document.currentScript.previousElementSibling;
            const section = container.closest('.pdp-hero--root');
            if (!section) return;

            const addBtn = container.querySelector('[data-add-to-cart]');
            const buyBtn = container.querySelector('[data-buy-now]');

            const getQuantity = () => {
              const qtyInput = section.querySelector('[data-qty-input]');
              return qtyInput ? parseInt(qtyInput.value) : 1;
            };

            const getVariantId = () => {
              return section.dataset.initialVariantId;
            };

            if (addBtn) {
              addBtn.addEventListener('click', (e) => {
                e.preventDefault();
                const variantId = getVariantId();
                const quantity = getQuantity();
                if (!variantId) return;

                const formData = {
                  'items': [{
                    'id': variantId,
                    'quantity': quantity
                  }]
                };

                fetch((window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/') + 'cart/add.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(formData)
                })
                .then(response => response.json())
                .then(data => {
                  const toast = document.getElementById('pdp-hero-toast');
                  if (toast) {
                    toast.classList.add('is-visible');
                    setTimeout(() => toast.classList.remove('is-visible'), 3000);
                  }
                  document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
                  if (typeof window.updateSideCart === 'function') window.updateSideCart();
                  if (typeof window.openCartDrawer === 'function') window.openCartDrawer();
                })
                .catch(e => console.error(e));
              });
            }

            if (buyBtn) {
              buyBtn.addEventListener('click', (e) => {
                e.preventDefault();
                const variantId = getVariantId();
                const quantity = getQuantity();
                if (!variantId) return;
                window.location.href = '/cart/' + variantId + ':' + quantity;
              });
            }
          })();
        </script>
