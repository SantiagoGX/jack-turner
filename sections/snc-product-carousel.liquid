    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Orden",
      "default": "default",
      "options": [
        { "value": "default", "label": "Por defecto" },
        { "value": "best-selling", "label": "Más vendidos" },
