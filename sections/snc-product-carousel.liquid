    },
    {
      "type": "range",
      "id": "image_brightness",
      "label": "Brillo de las imágenes",
      "min": 80,
      "max": 100,
      "step": 1,
      "default": 100,
      "unit": "%",
      "info": "Útil para contrastar imágenes de fondo blanco."
    },
    {
      "type": "select",
      "id": "card_image_fit",
