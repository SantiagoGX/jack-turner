{%- liquid
  assign subtitle = section.settings.subtitle
  assign title = section.settings.title
  assign source_type = section.settings.source_type
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.limit | default: 12
  assign sort_by = section.settings.sort_by | default: 'default'
  
  assign card_style = section.settings.card_style | default: 'overlay'
  # Configuración de visualización
  assign visible_desktop = section.settings.visible_desktop | default: 3
  assign visible_mobile = section.settings.visible_mobile | default: 1
  
  assign card_height_mode = section.settings.card_height_mode | default: 'fixed'
  assign card_aspect_ratio = section.settings.card_aspect_ratio | default: '3/4'
  
  assign carousel_mode = section.settings.carousel_mode | default: 'infinite'
  assign carousel_peek_enabled = false
  if carousel_mode != 'normal'
    assign carousel_peek_enabled = true
  endif
  assign full_width = section.settings.full_width
  assign card_gap = section.settings.card_gap | default: 24
  assign carousel_side_padding = section.settings.carousel_side_padding | default: 0
  assign section_margin_top = section.settings.section_margin_top | default: 0
  assign section_margin_bottom = section.settings.section_margin_bottom | default: 0
  assign section_padding_top = section.settings.section_padding_top | default: 60
  assign section_padding_bottom = section.settings.section_padding_bottom | default: 80
  assign card_border_radius = section.settings.card_border_radius | default: 10
  assign side_peek = section.settings.side_peek | default: 10
  assign image_brightness = section.settings.image_brightness | default: 100
  assign card_image_fit = section.settings.card_image_fit | default: 'contain'

  assign qa_show_title = section.settings.qa_show_title
  assign qa_option_padding = section.settings.qa_option_padding | default: 6
  assign qa_padding = section.settings.qa_padding | default: 13
  assign qa_border_radius = section.settings.qa_border_radius | default: 0
  assign qa_sizes_per_row = section.settings.qa_sizes_per_row | default: 5
  assign qa_bg_color = section.settings.qa_bg_color | default: '#ffffff'
  assign qa_option_bg_color = section.settings.qa_option_bg_color | default: '#ffffff'
  assign qa_option_text_color = section.settings.qa_option_text_color | default: '#0d0d0d'
  assign qa_option_hover_bg_color = section.settings.qa_option_hover_bg_color | default: '#0d0d0d'
  assign qa_option_hover_text_color = section.settings.qa_option_hover_text_color | default: '#ffffff'
  assign qa_option_border_radius = section.settings.qa_option_border_radius | default: 4

  assign section_title_color = section.settings.section_title_color | default: '#0d0d0d'
  assign section_subtitle_color = section.settings.section_subtitle_color | default: '#0d0d0d'
  assign card_title_color = section.settings.card_title_color | default: '#0d0d0d'
  assign card_price_color = section.settings.card_price_color | default: '#000000'
  assign card_compare_price_color = section.settings.card_compare_price_color | default: 'rgba(0, 0, 0, 0.4)'
  assign card_title_margin_bottom = section.settings.card_title_margin_bottom | default: 6

  assign section_title_font_size = section.settings.section_title_font_size | default: 48
  assign section_subtitle_font_size = section.settings.section_subtitle_font_size | default: 14
  assign section_title_font_weight = section.settings.section_title_font_weight | default: 400
  assign section_subtitle_font_weight = section.settings.section_subtitle_font_weight | default: 700
  assign card_title_font_size = section.settings.card_title_font_size | default: 16
  assign card_title_font_weight = section.settings.card_title_font_weight | default: 400
  assign card_price_font_size = section.settings.card_price_font_size | default: 14
  assign card_price_font_weight = section.settings.card_price_font_weight | default: 400

  assign global_icon_wishlist = settings.global_icon_wishlist
  assign global_icon_plus = settings.global_icon_plus
  
  assign wishlist_bg_enabled = settings.global_wishlist_bg_enabled
  assign wishlist_bg_color = settings.global_wishlist_bg_color | default: '#FFFFFF'
  assign wishlist_inset = settings.global_wishlist_inset | default: 20
  assign wishlist_radius = settings.global_wishlist_radius | default: 0
  assign wishlist_padding = settings.global_wishlist_padding | default: 8
  assign wishlist_size = settings.global_wishlist_size | default: 40

  assign dot_color = section.settings.dot_color | default: '#d8d8d8'
  assign dot_active_color = section.settings.dot_active_color | default: '#0d0d0d'
  assign section_header_alignment = section.settings.section_header_alignment | default: 'center'
  assign section_header_alignment_mobile = section.settings.section_header_alignment_mobile | default: 'center'
  assign header_vertical_alignment = section.settings.header_vertical_alignment | default: 'center'
-%}

{% schema %}
{
  "name": "SNC Infinite Carousel",
  "class": "section--snc-product-carousel",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Nuestra selección"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Destacados"
    },
    {
      "type": "select",
      "id": "section_header_alignment",
      "label": "Alineación de textos (Título/Subtítulo)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_header_alignment_mobile",
      "label": "Alineación de textos (Móvil)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "header_vertical_alignment",
      "label": "Alineación vertical en cabecera",
      "options": [
        { "value": "flex-start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Botón de cabecera"
    },
    {
      "type": "text",
      "id": "header_button_text",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "header_button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "color",
      "id": "header_button_bg_color",
      "label": "Fondo del botón",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "header_button_text_color",
      "label": "Texto del botón",
      "default": "#0d0d0d"
    },
    {
      "type": "color",
      "id": "header_button_border_color",
      "label": "Borde del botón",
      "default": "#0d0d0d"
    },
    {
      "type": "color",
      "id": "header_button_hover_bg_color",
      "label": "Fondo del botón (Hover)",
      "default": "#0d0d0d"
    },
    {
      "type": "color",
      "id": "header_button_hover_text_color",
      "label": "Texto del botón (Hover)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "header_button_hover_border_color",
      "label": "Borde del botón (Hover)",
      "default": "#0d0d0d"
    },
    {
      "type": "range",
      "id": "header_button_border_width",
      "label": "Ancho del borde",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "header_button_border_radius",
      "label": "Redondeo del botón",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "header_button_font_size",
      "label": "Tamaño de fuente",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "header_button_font_weight",
      "label": "Grosor de fuente",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 700
    },
    {
      "type": "range",
      "id": "header_button_padding_vertical",
      "label": "Padding vertical",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "header_button_padding_horizontal",
      "label": "Padding horizontal",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "select",
      "id": "source_type",
      "label": "Fuente de productos",
      "default": "collection",
      "options": [
        { "value": "collection", "label": "Colección" },
        { "value": "manual", "label": "Manual (bloques)" }
