  .spf-product-card__image-wrapper:hover .spf-product-card__image-main {
    opacity: 0;
  }
  .spf-product-card__image-wrapper:hover .spf-product-card__image-secondary {
    opacity: 1;
  }
  .spf-product__label {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 10;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
  }
  .spf-product__form {
    position: absolute;
    bottom: 30px;
    right: 20px;
    z-index: 10;
    pointer-events: auto;
  }
  .spf-product__form-btn-addtocart {
