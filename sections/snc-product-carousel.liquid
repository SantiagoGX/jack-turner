      "id": "limit",
      "label": "Máximo de productos",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Estilo de tarjeta",
      "options": [
        { "value": "overlay", "label": "Contenido sobre imagen" },
        { "value": "below", "label": "Contenido debajo de imagen" }
      ],
      "default": "overlay"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": true
    },
    {
      "type": "range",
