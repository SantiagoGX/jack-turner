  }
  .spf-product-card:hover .spf-product__form-btn-addtocart {
    width: auto;
    min-width: 200px;
    padding: 0 20px;
    border-radius: 1000px;
    font-size: 14px;
  }
  .spf-product-card:hover .spf-product__form-btn-addtocart::before {
    display: none;
  }
  .spf-product__form-btn-addtocart span {
    font-family: var(--font-main);
    font-size: 14px;
    color: #0d0d0d;
    white-space: nowrap;
  }
  .spf-product__info {
    position: absolute;
    bottom: 30px;
    left: 20px;
    right: 20px;
    height: 54px;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background: transparent;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .spf-product-card:hover .spf-product__info {
    opacity: 0;
    transform: translateY(10px);
  }
  .spf-product-card__title {
    margin: 0 0 6px 0;
    font-family: var(--font-main) !important;
    font-size: 16px !important;
    font-weight: normal !important;
    color: #0d0d0d !important;
    line-height: 1.2;
  }
  .spf-product-card__title a {
    text-decoration: none;
    color: #0d0d0d;
  }
  .spf-product-card__price-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .spf-product-card__oldprice {
    font-family: var(--font-main) !important;
    font-size: 14px !important;
    color: rgba(0, 0, 0, 0.4) !important;
    text-decoration: line-through;
  }
  .spf-product-card__saleprice {
    font-family: var(--font-main) !important;
    font-size: 14px !important;
    font-weight: normal !important;
    color: #000000 !important;
  }
  .spf-product__swatchs {
    display: none;
  }
  .spf-product__variants {
    display: none;
  }
  .spf-col-xl-4,
  .spf-col-lg-4 {
    padding-left: 5px;
    padding-right: 5px;
    max-width: 460px;
    flex: 0 0 460px;
  }
  @media (max-width: 1023px) {
    .spf-product-card {
      width: 100% !important;
      max-width: none !important;
      min-width: 0 !important;
    }
    .spf-product-card__image-wrapper {
      height: auto !important;
      aspect-ratio: 460 / 600;
    }
    .spf-product__form-btn-addtocart {
      width: 40px;
      height: 40px;
    }
    .spf-col-xl-4,
    .spf-col-lg-4,
    .spf-col-md-6 {
      flex: 0 0 50%;
      max-width: 50%;
    }
  }
  @media (max-width: 767px) {
    .spf-col-md-6,
    .spf-col-sm-12,
    .spf-col-12 {
      flex: 0 0 100%;
      max-width: 100%;
    }
  }
</style>

<div class="snc-product-carousel-wrapper"
     style="
       --section-title-color: {{ section_title_color }};
       --section-subtitle-color: {{ section_subtitle_color }};
       --card-title-color: {{ card_title_color }};
       --card-price-color: {{ card_price_color }};
       --card-compare-price-color: {{ card_compare_price_color }};
       --card-title-margin-bottom: {{ card_title_margin_bottom }}px;
       --section-title-font-size: {{ section_title_font_size }}px;
       --section-subtitle-font-size: {{ section_subtitle_font_size }}px;
       --section-title-font-weight: {{ section_title_font_weight }};
       --section-subtitle-font-weight: {{ section_subtitle_font_weight }};
       --card-title-font-size: {{ card_title_font_size }}px;
       --card-title-font-weight: {{ card_title_font_weight }};
       --card-price-font-size: {{ card_price_font_size }}px;
       --card-price-font-weight: {{ card_price_font_weight }};
       --snc-dot-color: {{ dot_color }};
       --snc-dot-active-color: {{ dot_active_color }};
       --section-header-alignment: {{ section_header_alignment }};
       --section-header-alignment-mobile: {{ section_header_alignment_mobile }};
       --section-header-alignment-mobile-flex: {%- case section_header_alignment_mobile -%}{%- when 'left' -%}flex-start{%- when 'right' -%}flex-end{%- else -%}center{%- endcase -%};
       --header-vertical-alignment: {{ header_vertical_alignment }};
       --hb-bg-color: {{ section.settings.header_button_bg_color }};
       --hb-text-color: {{ section.settings.header_button_text_color }};
       --hb-border-color: {{ section.settings.header_button_border_color }};
       --hb-hover-bg-color: {{ section.settings.header_button_hover_bg_color }};
       --hb-hover-text-color: {{ section.settings.header_button_hover_text_color }};
       --hb-hover-border-color: {{ section.settings.header_button_hover_border_color }};
       --hb-border-width: {{ section.settings.header_button_border_width }}px;
       --hb-border-radius: {{ section.settings.header_button_border_radius }}px;
       --hb-font-size: {{ section.settings.header_button_font_size }}px;
       --hb-font-weight: {{ section.settings.header_button_font_weight }};
       --hb-padding-y: {{ section.settings.header_button_padding_vertical }}px;
       --hb-padding-x: {{ section.settings.header_button_padding_horizontal }}px;
       --snc-edge-spacing: {%- if carousel_peek_enabled -%}{{ carousel_side_padding }}px{%- else -%}0px{%- endif -%};
       margin-top: {{ section_margin_top }}px;
       margin-bottom: {{ section_margin_bottom }}px;
     ">
  <div class="snc-carousel" 
      data-section-id="{{ section.id }}"
      data-section-type="snc-product-carousel"
      data-visible-desktop="{{ visible_desktop }}"
      data-visible-mobile="{{ visible_mobile }}"
      data-carousel-mode="{{ carousel_mode }}"
      data-side-peek="{{ side_peek }}">
      
    <div class="snc-carousel__inner">
      <div class="snc-carousel__header">
        <div class="snc-carousel__header-content">
          {%- if subtitle != blank -%}
            <div class="snc-carousel__subtitle">{{ subtitle | escape }}</div>
          {%- endif -%}
          {%- if title != blank -%}
            <h2 class="snc-carousel__title">{{ title | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.header_button_text != blank -%}
          <a href="{{ section.settings.header_button_link | default: '#' }}" class="snc-carousel__header-btn">{{ section.settings.header_button_text | escape }}</a>
        {%- endif -%}
      </div>

      <div class="snc-carousel__track" data-track>
        {%- assign manual_products = '' -%}
        {%- if section.blocks.size > 0 -%}
          {%- assign manual_products = section.blocks | map: 'settings' | map: 'product' -%}
        {%- endif -%}

        {%- comment -%} GENERACIÓN DE PRODUCTOS {%- endcomment -%}
        {%- if source_type == 'manual' and manual_products != blank -%}
          {%- for b in section.blocks limit: limit -%}
            <div class="snc-carousel__slide" data-index="{{ forloop.index0 }}">
              {%- assign product_card_product = b.settings.product -%}
              {%- render 'product-card-content', product: product_card_product -%}
            </div>
          {%- endfor -%}
        {%- elsif source_type == 'collection' and collection != blank -%}
          {%- assign sorted_products = collection.products -%}
          {%- case sort_by -%}
            {%- when 'price-ascending' -%} {%- assign sorted_products = collection.products | sort: 'price' -%}
            {%- when 'price-descending' -%} {%- assign sorted_products = collection.products | sort: 'price' | reverse -%}
            {%- when 'created-descending' -%} {%- assign sorted_products = collection.products | sort: 'created_at' | reverse -%}
          {%- endcase -%}
          
          {%- for product in sorted_products limit: limit -%}
            <div class="snc-carousel__slide" data-index="{{ forloop.index0 }}">
              {%- assign product_card_product = product -%}
              {%- liquid
                assign main_image = product_card_product.featured_image
                assign hover_image = false
                if product_card_product.images.size > 1
                  for image in product_card_product.images
                    unless image == main_image
                      assign hover_image = image
                      break
                    endunless
                  endfor
                endif
              
                assign has_size_option = false
                assign has_color_option = false
                assign size_option = blank
                assign color_option = blank
                
                if product_card_product
                  for option in product_card_product.options_with_values
                    assign option_name_lower = option.name | downcase
                    if option_name_lower == 'talla' or option_name_lower == 'size' or option_name_lower == 'tamaño'
                      assign has_size_option = true
                      assign size_option = option
                    elsif option_name_lower == 'color' or option_name_lower == 'colour' or option_name_lower == 'colores'
                      assign has_color_option = true
                      assign color_option = option
                    endif
                  endfor
                endif
              -%}
              
              <div class="snc-plp--product-card" data-card-style="{{ card_style }}" data-product-handle="{{ product_card_product.handle }}" data-product-available="{{ product_card_product.available }}" data-product-price="{{ product_card_product.price }}">
                {%- if product_card_product -%}
                  <div class="snc-plp--product-image-wrapper">
                    <a href="{{ product_card_product.url }}" class="snc-plp--product-image-link">
                      <img 
                        src="{{ main_image | image_url: width: 460 }}" 
                        alt="{{ main_image.alt | escape }}" 
                        class="snc-plp--product-main-image"
                        loading="lazy"
                        width="460"
                        height="600"
                      >
                      {%- if hover_image -%}
                        <img 
                          src="{{ hover_image | image_url: width: 460 }}" 
                          alt="{{ hover_image.alt | escape }}" 
                          class="snc-plp--product-hover-image"
                          loading="lazy"
                          width="460"
                          height="600"
                        >
                      {%- endif -%}
                    </a>
                    <button class="snc-plp--favorite-button" data-favorite-handle="{{ product_card_product.handle }}">                      <img src="{% if global_icon_wishlist != blank %}{{ global_icon_wishlist | image_url: width: 46 }}{% else %}{{ 'favorite.svg' | asset_url }}{% endif %}" alt="Add to favorites" class="snc-plp--favorite-icon">
                    </button>                    
                    
                    {%- if card_style == 'below' -%}
                      <div 
                        class="snc-plp--quick-add-overlay"
                        style="
                          --qa-padding: {{ qa_padding }}px;
                          --qa-option-padding: {{ qa_option_padding }}px;
                          --qa-border-radius: {{ qa_border_radius }}px;
                          --qa-sizes-per-row: {{ qa_sizes_per_row }};
                          --qa-bg-color: {{ qa_bg_color }};
                          --qa-option-bg-color: {{ qa_option_bg_color }};
                          --qa-option-text-color: {{ qa_option_text_color }};
                          --qa-option-hover-bg-color: {{ qa_option_hover_bg_color }};
                          --qa-option-hover-text-color: {{ qa_option_hover_text_color }};
                          --qa-option-border-radius: {{ qa_option_border_radius }}px;
                        "
                      >
                        {%- if has_size_option and has_color_option -%}
                           <div class="snc-plp--qa-step" data-step="size">
                             {%- if qa_show_title -%}<span class="snc-plp--qa-title">Selecciona Talla</span>{%- endif -%}
                             <div class="snc-plp--qa-options">
                               {%- for value in size_option.values -%}
                                 {%- assign size_available = false -%}
                                 {%- for variant in product_card_product.variants -%}
                                   {%- if variant.option1 == value or variant.option2 == value or variant.option3 == value -%}
                                     {%- if variant.available -%}
                                       {%- assign size_available = true -%}
                                       {%- break -%}
                                     {%- endif -%}
                                   {%- endif -%}
                                 {%- endfor -%}
                                 <button type="button" class="snc-plp--qa-option" data-value="{{ value }}" {% unless size_available %}disabled{% endunless %}>{{ value }}</button>
                               {%- endfor -%}
                             </div>
                           </div>
                           <div class="snc-plp--qa-step" data-step="color" style="display: none; opacity: 0;">
                             {%- if qa_show_title -%}<span class="snc-plp--qa-title">Selecciona Color</span>{%- endif -%}
                             <div class="snc-plp--qa-options">
                               {%- for value in color_option.values -%}
                                 <button type="button" class="snc-plp--qa-option" data-value="{{ value }}">{{ value }}</button>
                               {%- endfor -%}
                             </div>
                           </div>
                           <script type="application/json" class="snc-plp--variant-data">
                             {{ product_card_product.variants | json }}
                           </script>
                        {%- elsif has_size_option -%}
                           <div class="snc-plp--qa-step" data-step="size">
                             {%- if qa_show_title -%}<span class="snc-plp--qa-title">Selecciona Talla</span>{%- endif -%}
                             <div class="snc-plp--qa-options">
                               {%- for value in size_option.values -%}
                                 {%- liquid 
                                    assign variant_for_size = false
                                    for variant in product_card_product.variants
                                      if variant.option1 == value or variant.option2 == value or variant.option3 == value
                                        assign variant_for_size = variant
                                        break
                                      endif
                                    endfor
                                 -%}
                                 <button 
                                   type="button" 
                                   class="snc-plp--qa-option" 
                                   data-variant-id="{{ variant_for_size.id }}" 
                                   {% unless variant_for_size.available %}disabled{% endunless %}
                                 >
                                   {{ value }}
                                 </button>
                               {%- endfor -%}
                             </div>
                           </div>
                        {%- else -%}
                           <button type="button" class="snc-plp--qa-btn-full" data-add-product-handle="{{ product_card_product.handle }}">Add to cart</button>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="snc-plp--product-footer">
                    <div class="snc-plp--product-info">
                      <a href="{{ product_card_product.url }}" class="snc-plp--product-title-link">
                        <h3 class="snc-plp--product-title">{{ product_card_product.title }}</h3>
                      </a>
                      <div class="snc-plp--product-price-container">
                        {%- if product_card_product.compare_at_price > product_card_product.price -%}
                          <span class="snc-plp--product-compare-price">{{ product_card_product.compare_at_price | money }}</span>
                        {%- endif -%}
                        <span class="snc-plp--product-price">{{ product_card_product.price | money }}</span>
                      </div>
                    </div>
                    <div class="snc-plp--add-container">
                      {%- if has_size_option -%}
                        <div class="snc-plp--sizes-dropdown">
                          {%- for value in size_option.values -%}
                            {%- liquid
                              assign variant_for_size = false
                              for variant in product_card_product.variants
                                if variant.option1 == value or variant.option2 == value or variant.option3 == value
                                  assign variant_for_size = variant
                                  break
                                endif
                              endfor
                            -%}
                            <button 
                              class="snc-plp--size-option" 
                              data-variant-id="{{ variant_for_size.id }}"
                              {% unless variant_for_size.available %}disabled{% endunless %}
                            >
                              {{ value }}
                            </button>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                      <button class="snc-plp--add-button">
                        <img src="{% if global_icon_plus != blank %}{{ global_icon_plus | image_url: width: 36 }}{% else %}{{ 'plus.svg' | asset_url }}{% endif %}" alt="Add to cart" class="snc-plp--plus-icon">
                      </button>
                    </div>
                  </div>
                {%- else -%}
                  <div class="snc-plp--product-image-wrapper" style="background-color: #f0f0f0;"></div>
                  <div class="snc-plp--product-footer">
                    <div class="snc-plp--product-info">
                      <div style="height: 1.2em; width: 80%; background-color: #e0e0e0; margin-bottom: 6px; border-radius: 4px;"></div>
                      <div style="height: 1em; width: 40%; background-color: #e0e0e0; border-radius: 4px;"></div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="snc-carousel__slide" data-index="{{ forloop.index0 }}">
              {%- assign product_card_product = false -%}
              <div class="snc-plp--product-card" data-card-style="{{ card_style }}">
                <div class="snc-plp--product-image-wrapper" style="background-color: #f0f0f0;"></div>
                <div class="snc-plp--product-footer">
                  <div class="snc-plp--product-info">
                    <div style="height: 1.2em; width: 80%; background-color: #e0e0e0; margin-bottom: 6px; border-radius: 4px;"></div>
                    <div style="height: 1em; width: 40%; background-color: #e0e0e0; border-radius: 4px;"></div>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="snc-carousel__nav">
        <button class="snc-carousel__arrow" type="button" data-prev aria-label="Anterior">
          <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="snc-carousel__arrow" type="button" data-next aria-label="Siguiente">
          <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
      <div class="snc-carousel__dots" data-dots></div>
    </div>
  </div>
</div>

