    {
      "type": "color",
      "id": "dot_color",
      "label": "Color de puntos inactivos",
      "default": "#d8d8d8"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Color de punto activo",
      "default": "#0d0d0d"
    }
