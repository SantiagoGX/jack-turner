{% schema %}
{
  "name": "SNC Our Story",
  "class": "section--snc-our-story",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "OUR STORY"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Título",
      "default": "Legacy Is Not Given. It's Built."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Jack Turner was founded on a simple belief: a watch should outlive the moment it was purchased in. Inspired by heritage, discipline, and timeless design, every piece is produced in limited numbers and built with mechanical integrity at its core.</p><p>We don't chase fashion cycles. We create modern heirlooms meant to be worn with purpose and passed forward.</p>"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "button_preset",
      "label": "Estilo de botón",
      "options": [
        { "value": "1", "label": "Preset 1" },
        { "value": "2", "label": "Preset 2" },
        { "value": "3", "label": "Preset 3" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Color del subtítulo",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "centered", "label": "Centrado" },
        { "value": "two-column", "label": "Dos columnas" }
      ],
      "default": "centered"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (solo para layout de dos columnas)"
    }
  ],
  "presets": [
    {
      "name": "SNC Our Story",
      "settings": {
        "subtitle": "OUR STORY",
        "title": "Legacy Is Not Given. It's Built.",
        "text": "<p>Jack Turner was founded on a simple belief: a watch should outlive the moment it was purchased in. Inspired by heritage, discipline, and timeless design, every piece is produced in limited numbers and built with mechanical integrity at its core.</p><p>We don't chase fashion cycles. We create modern heirlooms meant to be worn with purpose and passed forward.</p>"
      }
    }
  ]
}
{% endschema %}

<style>
  .snc-our-story--root {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
  }

  .snc-our-story--container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .snc-our-story--content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .snc-our-story--subtitle {
    font-family: var(--font-main);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: {{ section.settings.subtitle_color }};
    margin: 0 0 20px 0;
    display: block;
  }

  .snc-our-story--title {
    font-family: var(--font-main);
    font-size: 34px;
    font-weight: 400;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
    margin: 0 0 30px 0;
  }

  .snc-our-story--text {
    font-family: var(--font-main);
    font-size: 14px;
    line-height: 1.8;
    color: {{ section.settings.text_color }};
    margin: 0 0 40px 0;
    opacity: 0.85;
  }

  .snc-our-story--text p {
    margin: 0 0 20px 0;
  }

  .snc-our-story--text p:last-child {
    margin-bottom: 0;
  }

  .snc-our-story--button-wrapper {
    margin-top: 40px;
  }

  .snc-our-story--button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    font-family: var(--font-main);
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: 1px solid #000000;
    background: transparent;
    color: #000000;
  }

  .snc-our-story--button:hover {
    background: #000000;
    color: #ffffff;
  }

  /* Two column layout */
  .snc-our-story--two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    text-align: left;
  }

  .snc-our-story--two-column .snc-our-story--content {
    text-align: left;
    margin: 0;
  }

  .snc-our-story--image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  .snc-our-story--image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .snc-our-story--root {
      padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }

    .snc-our-story--title {
      font-size: 24px;
    }

    .snc-our-story--text {
      font-size: 15px;
    }

    .snc-our-story--two-column {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .snc-our-story--two-column .snc-our-story--content {
      text-align: center;
    }
  }
</style>

<div class="snc-our-story--root">
  <div class="snc-our-story--container {% if section.settings.layout == 'two-column' %}snc-our-story--two-column{% endif %}">
    
    {% if section.settings.layout == 'two-column' and section.settings.image != blank %}
      <div class="snc-our-story--image-wrapper">
        {{ section.settings.image | image_url: width: 800 | image_tag: class: 'snc-our-story--image', loading: 'lazy' }}
      </div>
    {% endif %}

    <div class="snc-our-story--content">
      {% if section.settings.subtitle != blank %}
        <span class="snc-our-story--subtitle">{{ section.settings.subtitle | escape }}</span>
      {% endif %}
      
      {% if section.settings.title != blank %}
        <h2 class="snc-our-story--title">{{ section.settings.title | escape }}</h2>
      {% endif %}
      
      {% if section.settings.text != blank %}
        <div class="snc-our-story--text">
          {{ section.settings.text }}
        </div>
      {% endif %}
      
      {% if section.settings.button_label != blank %}
        <div class="snc-our-story--button-wrapper">
          <a href="{{ section.settings.button_link | default: '#' }}" class="snc-our-story--button">
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {% endif %}
    </div>

    {% if section.settings.layout == 'two-column' and section.settings.image != blank %}
      <div class="snc-our-story--image-wrapper mobile-only">
        {{ section.settings.image | image_url: width: 800 | image_tag: class: 'snc-our-story--image', loading: 'lazy' }}
      </div>
    {% endif %}
  </div>
</div>
