                        --snc-cct-btn-scale-mobile: {{ block.settings.btn2_scale_mobile | default: 100 }};
                      ">
                        <span class="snc-cct--btn-label">{{ block.settings.btn2_text }}</span>
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        <div class="snc-cct--split-media">
          {%- for block in section.blocks -%}
            {%- if block.type == 'images' -%}
              <div class="snc-cct--images" {{ block.shopify_attributes }} style="
                --img-gap: {{ block.settings.gap }}px;
                --img-radius: {{ block.settings.border_radius }}px;
                --img-max-width: {{ block.settings.image_max_width }}px;
                --img-max-width-mobile: {{ block.settings.image_max_width_mobile }}px;
                --img-align: {{ block.settings.image_alignment | default: 'center' }};
                --mobile-direction: {{ block.settings.mobile_layout | default: 'row' }};
                margin-bottom: {{ block.settings.margin_bottom }}px;
              ">
                {%- if block.settings.image1 != blank -%}
                  <div class="snc-cct--image-wrapper">
                    {{ block.settings.image1 | image_url: width: 1200 | image_tag: class: 'snc-cct--image', loading: 'lazy' }}
                  </div>
                {%- endif -%}
                {%- if block.settings.image2 != blank -%}
                  <div class="snc-cct--image-wrapper">
                    {{ block.settings.image2 | image_url: width: 1200 | image_tag: class: 'snc-cct--image', loading: 'lazy' }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            {%- liquid
              assign text_margin_styles = ''
              if effective_alignment == 'center'
                assign text_margin_styles = 'margin-left: auto; margin-right: auto;'
              elsif effective_alignment == 'right'
                assign text_margin_styles = 'margin-left: auto; margin-right: 0;'
              else
                assign text_margin_styles = 'margin-left: 0; margin-right: auto;'
              endif
            -%}
            <div class="snc-cct--text" {{ block.shopify_attributes }} style="
              color: {{ block.settings.color }};
              --font-size-desktop: {{ block.settings.font_size }}px;
              --font-size-mobile: {{ block.settings.font_size_mobile | default: block.settings.font_size }}px;
              --font-scale-desktop: {{ block.settings.font_scale | default: 100 }};
              --font-scale-mobile: {{ block.settings.font_scale_mobile | default: 100 }};
              font-weight: {{ block.settings.font_weight }};
              margin-bottom: {{ block.settings.margin_bottom }}px;
              font-family: var(--font-main);
              text-align: {{ effective_alignment }};
              max-width: {{ block.settings.text_max_width }}px;
              {{ text_margin_styles }}
            ">
              {{ block.settings.text }}
            </div>
          {%- when 'buttons' -%}
            <div class="snc-cct--buttons" {{ block.shopify_attributes }} style="--btn-gap: {{ block.settings.gap }}px; justify-content: {{ buttons_justify }};">
              {%- if block.settings.btn1_text != blank -%}
                {%- if block.settings.btn1_style_mode == 'preset' -%}
                  <a
                    href="{{ block.settings.btn1_link | default: '#' }}"
                    class="snc-cct--btn btn-preset-{{ block.settings.btn1_preset }} {{ block.settings.btn1_typography }}"
                    style="--snc-cct-btn-scale-desktop: {{ block.settings.btn1_scale | default: 100 }}; --snc-cct-btn-scale-mobile: {{ block.settings.btn1_scale_mobile | default: 100 }};"
                  >
                    <span class="snc-cct--btn-label">{{ block.settings.btn1_text }}</span>
                  </a>
                {%- else -%}
                  <a href="{{ block.settings.btn1_link | default: '#' }}" class="snc-cct--btn{% if block.settings.btn1_underline %} snc-cct--btn--underline{% endif %}" style="
                    background-color: {{ block.settings.btn1_bg_color }};
                    color: {{ block.settings.btn1_text_color }};
                    font-size: {{ block.settings.btn1_font_size }}px;
                    font-weight: {{ block.settings.btn1_font_weight }};
                    padding: {{ block.settings.btn1_padding_v }}px {{ block.settings.btn1_padding_h }}px;
                    border: {{ block.settings.btn1_border_width | default: 0 }}px solid {{ block.settings.btn1_border_color | default: 'transparent' }};
                    border-radius: {{ block.settings.btn1_border_radius }}px;
                    font-family: var(--font-main);
                    --snc-cct-btn-scale-desktop: {{ block.settings.btn1_scale | default: 100 }};
                    --snc-cct-btn-scale-mobile: {{ block.settings.btn1_scale_mobile | default: 100 }};
                  ">
                    <span class="snc-cct--btn-label">{{ block.settings.btn1_text }}</span>
                  </a>
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.btn2_text != blank -%}
                {%- if block.settings.btn2_style_mode == 'preset' -%}
                  <a
                    href="{{ block.settings.btn2_link | default: '#' }}"
                    class="snc-cct--btn btn-preset-{{ block.settings.btn2_preset }} {{ block.settings.btn2_typography }}"
                    style="--snc-cct-btn-scale-desktop: {{ block.settings.btn2_scale | default: 100 }}; --snc-cct-btn-scale-mobile: {{ block.settings.btn2_scale_mobile | default: 100 }};"
                  >
                    <span class="snc-cct--btn-label">{{ block.settings.btn2_text }}</span>
                  </a>
                {%- else -%}
                  <a href="{{ block.settings.btn2_link | default: '#' }}" class="snc-cct--btn" style="
                    background-color: {{ block.settings.btn2_bg_color }};
                    color: {{ block.settings.btn2_text_color }};
                    font-size: {{ block.settings.btn2_font_size }}px;
                    font-weight: {{ block.settings.btn2_font_weight }};
                    padding: {{ block.settings.btn2_padding_v }}px {{ block.settings.btn2_padding_h }}px;
                    border: {{ block.settings.btn2_border_width }}px solid {{ block.settings.btn2_border_color }};
                    border-radius: {{ block.settings.btn2_border_radius }}px;
                    font-family: var(--font-main);
                    --snc-cct-btn-scale-desktop: {{ block.settings.btn2_scale | default: 100 }};
                    --snc-cct-btn-scale-mobile: {{ block.settings.btn2_scale_mobile | default: 100 }};
                  ">
                    <span class="snc-cct--btn-label">{{ block.settings.btn2_text }}</span>
                  </a>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- when 'images' -%}
            <div class="snc-cct--images" {{ block.shopify_attributes }} style="
              --img-gap: {{ block.settings.gap }}px;
              --img-radius: {{ block.settings.border_radius }}px;
