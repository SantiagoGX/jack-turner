{% schema %}
{
  "name": "SNC Custom Content",
  "class": "section--snc-custom-content-text",
  "settings": [
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Margen superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Margen inferior",
      "default": 60
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo del contenido",
      "default": 800
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación del texto",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_layout",
      "label": "Layout de la sección",
      "options": [
        { "value": "stacked", "label": "Bloques verticales (actual)" },
        { "value": "split", "label": "Texto + imagen en dos columnas" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "split_image_position",
      "label": "Posición de imagen (layout dos columnas)",
      "options": [
        { "value": "right", "label": "Imagen a la derecha" },
        { "value": "left", "label": "Imagen a la izquierda" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "split_text_alignment",
      "label": "Alineación del texto (layout dos columnas)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "split_vertical_align",
      "label": "Alineación vertical (layout dos columnas)",
      "options": [
        { "value": "flex-start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "split_gap",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Espacio entre columnas",
      "default": 52
    },
    {
      "type": "select",
      "id": "split_mobile_order",
      "label": "Orden en móvil (layout dos columnas)",
      "options": [
        { "value": "content_first", "label": "Texto primero, imagen después" },
        { "value": "image_first", "label": "Imagen primero, texto después" }
      ],
      "default": "content_first"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Texto",
      "limit": 5,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Agrega tu texto aquí</p>"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#0d0d0d"
        },
        {
          "type": "range",
          "id": "font_size",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Tamaño de fuente",
          "default": 20
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Tamaño de fuente (Móvil)",
          "default": 18
        },
        {
          "type": "range",
          "id": "font_scale",
          "min": 80,
          "max": 160,
          "step": 2,
          "unit": "%",
          "label": "Ajuste tamaño texto (Desktop)",
          "default": 100
        },
        {
          "type": "range",
          "id": "font_scale_mobile",
          "min": 80,
          "max": 160,
          "step": 2,
          "unit": "%",
          "label": "Ajuste tamaño texto (Móvil)",
          "default": 100
        },
        {
          "type": "range",
          "id": "font_weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "label": "Grosor de fuente",
          "default": 400
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Margen inferior",
          "default": 15
        },
        {
          "type": "range",
          "id": "text_max_width",
          "min": 100,
          "max": 1000,
          "step": 20,
          "unit": "px",
          "label": "Ancho máximo del texto",
          "default": 800,
          "info": "Controla el ancho máximo de este bloque de texto específico."
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Botones",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Botón 1"
        },
        {
          "type": "select",
          "id": "btn1_style_mode",
          "label": "Modo de estilo (Botón 1)",
          "options": [
            { "value": "custom", "label": "Personalizado" },
            { "value": "preset", "label": "Preset del tema" }
          ],
          "default": "custom"
        },
        {
          "type": "select",
          "id": "btn1_preset",
          "label": "Estilo de Botón (Preset 1)",
          "options": [
            { "value": "1", "label": "Preset 1" },
            { "value": "2", "label": "Preset 2" },
            { "value": "3", "label": "Preset 3" }
          ],
          "default": "1"
        },
        {
          "type": "select",
          "id": "btn1_typography",
          "label": "Estilo de tipografía (Botón 1)",
          "options": [
            { "value": "h1", "label": "Título principal" },
            { "value": "h2", "label": "Títulos secundarios" },
            { "value": "h3", "label": "Títulos pequeños" },
            { "value": "body", "label": "Párrafo" },
            { "value": "small", "label": "Párrafo pequeño" },
            { "value": "button", "label": "Botón" },
            { "value": "emphasis", "label": "Énfasis" }
          ],
          "default": "button"
        },
        {
          "type": "liquid",
          "id": "btn1_text",
          "label": "Texto Botón 1",
          "default": "Botón 1",
          "info": "Permite HTML y Liquid."
        },
        {
          "type": "url",
          "id": "btn1_link",
          "label": "Enlace Botón 1"
        },
        {
          "type": "color",
          "id": "btn1_bg_color",
          "label": "Fondo Botón 1",
          "default": "#0d0d0d"
        },
        {
          "type": "color",
          "id": "btn1_text_color",
          "label": "Texto Botón 1",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "btn1_font_size",
          "min": 10,
          "max": 40,
          "step": 1,
          "unit": "px",
          "label": "Tamaño fuente Botón 1",
          "default": 18
        },
        {
          "type": "range",
          "id": "btn1_scale",
          "min": 80,
          "max": 160,
          "step": 2,
          "unit": "%",
          "label": "Ajuste tamaño Botón 1 (Desktop)",
          "default": 100
        },
        {
          "type": "range",
          "id": "btn1_scale_mobile",
          "min": 80,
          "max": 160,
          "step": 2,
          "unit": "%",
          "label": "Ajuste tamaño Botón 1 (Móvil)",
          "default": 100
        },
        {
          "type": "range",
          "id": "btn1_font_weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "label": "Grosor fuente Botón 1",
          "default": 700
        },
        {
          "type": "range",
          "id": "btn1_padding_v",
          "min": 5,
          "max": 40,
          "step": 1,
          "unit": "px",
          "label": "Padding vertical Botón 1",
          "default": 12
        },
        {
          "type": "range",
          "id": "btn1_padding_h",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Padding horizontal Botón 1",
          "default": 24
        },
        {
          "type": "range",
          "id": "btn1_border_radius",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "label": "Redondeo de borde Botón 1",
          "default": 4
        },
        {
          "type": "color",
