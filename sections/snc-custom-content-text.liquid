<style>
  .snc-custom-content-text[data-section-id="{{ section.id }}"] {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: 0 20px;
  }
  
  .snc-custom-content-text[data-section-id="{{ section.id }}"] .snc-cct--container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ section.settings.alignment }};
    display: flex;
    flex-direction: column;
  }

  .snc-custom-content-text[data-section-id="{{ section.id }}"] .snc-cct--split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--split-gap, 52px);
    align-items: var(--split-align, center);
  }

  .snc-custom-content-text[data-section-id="{{ section.id }}"] .snc-cct--split.snc-cct--split-image-left .snc-cct--split-media {
    order: 1;
  }

  .snc-custom-content-text[data-section-id="{{ section.id }}"] .snc-cct--split.snc-cct--split-image-left .snc-cct--split-content {
    order: 2;
  }
  
  .snc-cct--text {
    line-height: 1.4;
    font-size: calc(var(--font-size-desktop) * var(--font-scale-desktop, 100) / 100);
  }
  
  .snc-cct--text p, 
  .snc-cct--text h1, 
  .snc-cct--text h2, 
  .snc-cct--text h3, 
  .snc-cct--text h4, 
  .snc-cct--text h5, 
  .snc-cct--text h6 {
    margin: 0;
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
  }
  
  .snc-custom-content-text[data-section-id="{{ section.id }}"] .snc-cct--buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {{ section.settings.alignment }};
    gap: var(--btn-gap);
    margin-top: 10px;
  }
  
  .snc-cct--btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
    border: 0;
    line-height: 1;
    text-align: center;
    --snc-cct-btn-scale-current: var(--snc-cct-btn-scale-desktop, 100);
  }

  .snc-cct--btn-label {
    font-size: calc(1em * var(--snc-cct-btn-scale-current, 100) / 100);
  }
  
  .snc-cct--btn:hover {
    opacity: 0.85;
  }

  .snc-cct--btn--underline {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: currentColor;
    transition: text-decoration-color 0.25s ease, opacity 0.25s ease;
  }
  .snc-cct--btn--underline:hover {
    opacity: 1;
    text-decoration-color: transparent;
  }
  @media (max-width: 768px) {
    .snc-cct--btn--underline {
      width: auto;
    }
  }
  
  @media (max-width: 768px) {
    .snc-cct--buttons {
      flex-direction: column;
      width: 100%;
    }
    .snc-cct--btn {
      width: 100%;
      --snc-cct-btn-scale-current: var(--snc-cct-btn-scale-mobile, 100);
    }
    .snc-cct--text {
      font-size: calc(var(--font-size-mobile) * var(--font-scale-mobile, 100) / 100);
    }
    .snc-cct--images {
      flex-direction: var(--mobile-direction);
    }
  }

  .snc-cct--images {
    display: flex;
    width: 100%;
    gap: var(--img-gap);
  }
  
  .snc-cct--image-wrapper {
    flex: 1;
    display: flex;
    justify-content: var(--img-align, center);
  }
  
  .snc-cct--image {
    width: 100%;
    max-width: var(--img-max-width, 100%);
    height: auto;
    display: block;
    border-radius: var(--img-radius);
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .snc-custom-content-text[data-section-id="{{ section.id }}"] .snc-cct--split {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .snc-custom-content-text[data-section-id="{{ section.id }}"] .snc-cct--split.snc-cct--split-mobile-image_first .snc-cct--split-media {
      order: 1;
    }
    .snc-custom-content-text[data-section-id="{{ section.id }}"] .snc-cct--split.snc-cct--split-mobile-image_first .snc-cct--split-content {
      order: 2;
    }
    .snc-cct--image {
      max-width: var(--img-max-width-mobile, var(--img-max-width, 100%));
    }
  }
</style>

{%- liquid
  assign has_images = false
  for block in section.blocks
    if block.type == 'images'
      assign has_images = true
    endif
  endfor

  assign use_split_layout = false
  if section.settings.section_layout == 'split' and has_images
    assign use_split_layout = true
  endif

  assign effective_alignment = section.settings.alignment
  if use_split_layout
    assign effective_alignment = section.settings.split_text_alignment
  endif

  assign buttons_justify = 'flex-start'
  if effective_alignment == 'center'
    assign buttons_justify = 'center'
  elsif effective_alignment == 'right'
    assign buttons_justify = 'flex-end'
  endif
-%}

<div class="snc-custom-content-text" data-section-id="{{ section.id }}">
  <div class="snc-cct--container">
    {%- if use_split_layout -%}
      <div
        class="snc-cct--split snc-cct--split-image-{{ section.settings.split_image_position }} snc-cct--split-mobile-{{ section.settings.split_mobile_order }}"
        style="--split-gap: {{ section.settings.split_gap }}px; --split-align: {{ section.settings.split_vertical_align }};"
      >
        <div class="snc-cct--split-content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                {%- liquid
                  assign text_margin_styles = ''
                  if effective_alignment == 'center'
                    assign text_margin_styles = 'margin-left: auto; margin-right: auto;'
                  elsif effective_alignment == 'right'
                    assign text_margin_styles = 'margin-left: auto; margin-right: 0;'
                  else
                    assign text_margin_styles = 'margin-left: 0; margin-right: auto;'
                  endif
                -%}
                <div class="snc-cct--text" {{ block.shopify_attributes }} style="
                  color: {{ block.settings.color }};
                  --font-size-desktop: {{ block.settings.font_size }}px;
                  --font-size-mobile: {{ block.settings.font_size_mobile | default: block.settings.font_size }}px;
                  --font-scale-desktop: {{ block.settings.font_scale | default: 100 }};
                  --font-scale-mobile: {{ block.settings.font_scale_mobile | default: 100 }};
                  font-weight: {{ block.settings.font_weight }};
                  margin-bottom: {{ block.settings.margin_bottom }}px;
                  font-family: var(--font-main);
                  text-align: {{ effective_alignment }};
                  max-width: {{ block.settings.text_max_width }}px;
                  {{ text_margin_styles }}
                ">
                  {{ block.settings.text }}
                </div>
              {%- when 'buttons' -%}
                <div class="snc-cct--buttons" {{ block.shopify_attributes }} style="--btn-gap: {{ block.settings.gap }}px; justify-content: {{ buttons_justify }};">
                  {%- if block.settings.btn1_text != blank -%}
                    {%- if block.settings.btn1_style_mode == 'preset' -%}
                      <a
                        href="{{ block.settings.btn1_link | default: '#' }}"
                        class="snc-cct--btn btn-preset-{{ block.settings.btn1_preset }} {{ block.settings.btn1_typography }}"
                        style="--snc-cct-btn-scale-desktop: {{ block.settings.btn1_scale | default: 100 }}; --snc-cct-btn-scale-mobile: {{ block.settings.btn1_scale_mobile | default: 100 }};"
