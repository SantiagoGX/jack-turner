        },
        {
          "type": "range",
          "id": "btn1_border_width",
          "min": 0,
          "max": 4,
          "step": 1,
          "unit": "px",
          "label": "Grosor de borde Botón 1",
          "default": 0
        },
        {
          "type": "checkbox",
