          ],
          "default": "custom"
        },
        {
          "type": "select",
          "id": "btn2_preset",
          "label": "Estilo de Botón (Preset 2)",
          "options": [
            { "value": "1", "label": "Preset 1" },
            { "value": "2", "label": "Preset 2" },
            { "value": "3", "label": "Preset 3" }
          ],
          "default": "2"
        },
        {
          "type": "select",
          "id": "btn2_typography",
          "label": "Estilo de tipografía (Botón 2)",
          "options": [
            { "value": "h1", "label": "Título principal" },
            { "value": "h2", "label": "Títulos secundarios" },
            { "value": "h3", "label": "Títulos pequeños" },
            { "value": "body", "label": "Párrafo" },
            { "value": "small", "label": "Párrafo pequeño" },
            { "value": "button", "label": "Botón" },
            { "value": "emphasis", "label": "Énfasis" }
          ],
          "default": "button"
        },
        {
          "type": "liquid",
          "id": "btn2_text",
          "label": "Texto Botón 2",
          "info": "Permite HTML y Liquid."
        },
        {
          "type": "url",
          "id": "btn2_link",
          "label": "Enlace Botón 2"
        },
        {
          "type": "color",
          "id": "btn2_bg_color",
          "label": "Fondo Botón 2",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "btn2_text_color",
          "label": "Texto Botón 2",
          "default": "#0d0d0d"
        },
        {
          "type": "color",
          "id": "btn2_border_color",
          "label": "Borde Botón 2",
