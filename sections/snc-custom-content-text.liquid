                        font-size: {{ block.settings.btn2_font_size }}px;
                        font-weight: {{ block.settings.btn2_font_weight }};
                        padding: {{ block.settings.btn2_padding_v }}px {{ block.settings.btn2_padding_h }}px;
                        border: {{ block.settings.btn2_border_width }}px solid {{ block.settings.btn2_border_color }};
                        border-radius: {{ block.settings.btn2_border_radius }}px;
                        font-family: var(--font-main);
