                        background-color: {{ block.settings.btn1_bg_color }};
                        color: {{ block.settings.btn1_text_color }};
                        font-size: {{ block.settings.btn1_font_size }}px;
                        font-weight: {{ block.settings.btn1_font_weight }};
                        padding: {{ block.settings.btn1_padding_v }}px {{ block.settings.btn1_padding_h }}px;
