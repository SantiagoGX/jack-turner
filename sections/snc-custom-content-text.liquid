                        style="--snc-cct-btn-scale-desktop: {{ block.settings.btn2_scale | default: 100 }}; --snc-cct-btn-scale-mobile: {{ block.settings.btn2_scale_mobile | default: 100 }};"
                      >
                        <span class="snc-cct--btn-label">{{ block.settings.btn2_text }}</span>
                      </a>
                    {%- else -%}
