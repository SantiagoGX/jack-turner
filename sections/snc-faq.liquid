{% schema %}
{
  "name": "SNC FAQ",
  "class": "section--snc-faq",
  "settings": [
    {
      "type": "header",
      "content": "Cabecera de Sección"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Preguntas Frecuentes"
    },
    {
      "type": "color",
      "id": "section_title_color",
      "label": "Color del título",
      "default": "#0d0d0d"
    },
    {
      "type": "range",
      "id": "section_title_size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_title_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Grosor del título",
      "default": 700
    },
    {
      "type": "range",
      "id": "section_title_margin_bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Margen inferior título",
      "default": 20
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Párrafo"
    },
    {
      "type": "color",
      "id": "section_desc_color",
      "label": "Color del párrafo",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "section_desc_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del párrafo",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_desc_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Grosor del párrafo",
      "default": 400
    },
    {
      "type": "range",
      "id": "section_desc_margin_bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Margen inferior párrafo",
      "default": 40
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Alineación de cabecera",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo del acordeón",
      "default": 800
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen inferior",
      "default": 40
    },
    {
      "type": "header",
      "content": "Estilo del Acordeón"
    },
    {
      "type": "range",
      "id": "item_padding_vertical",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Padding vertical interno",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_padding_horizontal",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Padding horizontal interno",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Espacio entre preguntas",
      "default": 10
    },
    {
      "type": "header",
      "content": "Bordes"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Redondeo de bordes",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Grosor del borde",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color del borde",
      "default": "#E5E5E5"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo del item",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Tipografía y Colores"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título (Pregunta)",
      "default": "#0d0d0d"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Tamaño fuente título",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "label": "Grosor fuente título",
      "default": 600
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Color del contenido (Respuesta)",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "content_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño fuente contenido",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Pregunta",
          "default": "¿Pregunta frecuente?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Respuesta",
          "default": "<p>Respuesta a la pregunta frecuente.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNC FAQ",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .snc-faq-section {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: 0 20px;
  }
  
  .snc-faq-header {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  
  .snc-faq-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.gap }}px;
  }
  
  .snc-faq-item {
    background-color: {{ section.settings.background_color }};
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .snc-faq-summary {
    padding: {{ section.settings.item_padding_vertical }}px {{ section.settings.item_padding_horizontal }}px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    color: {{ section.settings.title_color }};
  }
  
  .snc-faq-summary::-webkit-details-marker {
    display: none;
  }
  
  .snc-faq-title {
    font-family: var(--font-main);
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    line-height: 1.3;
  }
  
  .snc-faq-icon {
    transition: transform 0.3s ease;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: 15px;
    color: {{ section.settings.title_color }};
  }
  
  .snc-faq-item[open] .snc-faq-icon {
    transform: rotate(180deg);
  }
  
  .snc-faq-content {
    padding: 0 {{ section.settings.item_padding_horizontal }}px {{ section.settings.item_padding_vertical }}px;
    color: {{ section.settings.content_color }};
    font-family: var(--font-main);
    font-size: {{ section.settings.content_font_size }}px;
    line-height: 1.6;
  }
  
  .snc-faq-content p {
    margin: 0;
  }
  
  .snc-faq-content p + p {
    margin-top: 10px;
  }
</style>

<div class="snc-faq-section" data-section-id="{{ section.id }}" data-section-type="snc-faq">
  <div class="snc-faq-header" style="text-align: {{ section.settings.header_alignment }};">
    {%- if section.settings.title != blank -%}
      <h2 class="snc-faq-section-title" style="
        color: {{ section.settings.section_title_color }};
        font-size: {{ section.settings.section_title_size }}px;
        font-weight: {{ section.settings.section_title_weight }};
        margin-bottom: {{ section.settings.section_title_margin_bottom }}px;
        font-family: var(--font-main);
        margin-top: 0;
      ">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="snc-faq-section-desc" style="
        color: {{ section.settings.section_desc_color }};
        font-size: {{ section.settings.section_desc_size }}px;
        font-weight: {{ section.settings.section_desc_weight }};
        margin-bottom: {{ section.settings.section_desc_margin_bottom }}px;
        font-family: var(--font-main);
      ">{{ section.settings.description }}</div>
    {%- endif -%}
  </div>
  <div class="snc-faq-container">
    {%- for block in section.blocks -%}
      <details class="snc-faq-item" {{ block.shopify_attributes }}>
        <summary class="snc-faq-summary">
          <span class="snc-faq-title">{{ block.settings.title }}</span>
          <span class="snc-faq-icon">
            <svg width="14" height="9" viewBox="0 0 14 9" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1.5L7 7.5L13 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </summary>
        <div class="snc-faq-content">
          <div class="rte">{{ block.settings.content }}</div>
        </div>
      </details>
    {%- endfor -%}
  </div>
</div>
