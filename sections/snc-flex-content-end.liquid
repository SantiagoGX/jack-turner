	                --content-max-width: {{ block.settings.content_max_width }}px;
	                --logo-width: {{ block.settings.logo_width }}px;
	                --macro-width: {{ block.settings.macro_width }}vw;
	                --macro-fit: {{ block.settings.macro_fit }};
	                --macro-scale: {{ block.settings.macro_scale | divided_by: 100.0 }};
	                --macro-offset-x: {{ block.settings.macro_offset_x }}px;
	                --macro-offset-y: {{ block.settings.macro_offset_y }}px;
	                --snc-hs-text-offset-y: {{ block.settings.text_offset_y | default: 0 }}px;
