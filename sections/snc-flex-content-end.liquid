{%- liquid
  assign total_width = 0
  for block in section.blocks
    if block.type == 'slide_type_2'
      assign total_width = total_width | plus: 150
    elsif block.type == 'slide_type_3'
      assign total_width = total_width | plus: 240
    elsif block.type == 'slide_type_4'
      assign total_width = total_width | plus: 100
    else
      assign total_width = total_width | plus: 100
    endif
  endfor
-%}

<style>
  #snc-horizontal-scroll-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    height: {{ total_width }}vh;
    position: relative;
    z-index: 0;
  }

  .snc-horizontal-scroll--sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    z-index: 0;
  }

  .snc-horizontal-scroll--track {
    display: flex;
    height: 100%;
    width: {{ total_width }}vw;
    will-change: transform;
  }

  .snc-horizontal-scroll--slide {
    width: 100vw;
    height: 100%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: visible;
  }

  .snc-horizontal-scroll--container {
    max-width: 1512px;
    width: 90%;
    height: 100%;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    pointer-events: none; /* Permite clicks en la imagen de fondo si es necesario */
  }

  .snc-horizontal-scroll--content {
    pointer-events: auto;
    position: absolute;
    left: 0px;
    bottom: 74px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    max-width: 600px;
    gap: 150px; /* Gap solicitado entre título y párrafo */
    color: {{ section.settings.text_color }};
    z-index: 2;
    transform: translateY(var(--snc-hs-text-offset-y, 0px));
    min-height: var(--snc-hs-text-min-height, 0px);
  }

  .snc-hs--subtitle {
    font-family: var(--font-main);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
    opacity: 0.8;
  }

  .snc-hs--title {
    font-family: var(--font-main);
    font-size: 40px;
    font-weight: 700;
    margin: 0 0 20px 0;
    line-height: 1.1;
  }

  .snc-hs--text {
    font-family: var(--font-main);
    font-size: 16px;
    line-height: 1.5;
  }

  .snc-hs--header-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .snc-horizontal-scroll--image {
    position: absolute;
    right: 0;
    width: 600px;
    z-index: 1;
    overflow: hidden;
  }

  /* Estilos específicos Bloque 1 */
  .slide-type-1 .snc-horizontal-scroll--image {
    bottom: 0;
    height: 90%;
  }

  /* Estilos específicos Bloque 2 */
  .slide-type-2 {
    width: 150vw;
  }

  .slide-type-2 .snc-horizontal-scroll--gallery {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: flex-start;
    z-index: 1;
    gap: 20px;
  }

  .slide-type-2 .snc-hs--img-container-1 {
    width: 600px;
    height: 60vh;
  }
  .slide-type-2 .snc-hs--img-container-1 img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .slide-type-2 .snc-hs--img-container-2 {
    width: 721px;
    height: calc(60vh * 1.13);
  }
  .slide-type-2 .snc-hs--img-container-2 img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  /* Estilos específicos Bloque 3 */
  .slide-type-3 {
    width: 240vw;
  }

  .slide-type-3 .snc-horizontal-scroll--gallery {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: flex-start;
    z-index: 1;
    gap: 20px;
  }

  .slide-type-3 .snc-hs--img-container-1 {
    width: 796px;
    height: 60vh;
  }
  .slide-type-3 .snc-hs--img-container-1 img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .slide-type-3 .snc-hs--img-container-2,
  .slide-type-3 .snc-hs--img-container-3 {
    width: 633px;
    height: 35vh;
  }
  .slide-type-3 .snc-hs--img-container-2 img,
  .slide-type-3 .snc-hs--img-container-3 img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .snc-horizontal-scroll--image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Estilos específicos Bloque 4 */
  .slide-type-4 .snc-horizontal-scroll--content {
    position: relative;
    left: auto;
    bottom: auto;
    height: 100%;
    max-width: var(--content-max-width);
    gap: 28px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .slide-type-4 .snc-horizontal-scroll--content.snc-hs--type4-align-left {
    align-items: flex-start;
    text-align: left;
  }

  .snc-hs--type4-logo {
    width: var(--logo-width);
    max-width: 70%;
    height: auto;
    display: block;
  }

  .snc-hs--type4-macro {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: var(--macro-width);
    z-index: 1;
    pointer-events: none;
    transform: translate(var(--macro-offset-x), var(--macro-offset-y)) scale(var(--macro-scale));
    transform-origin: right center;
  }

  .snc-hs--type4-macro img {
    width: 100%;
    height: 100%;
    object-fit: var(--macro-fit);
    object-position: right center;
    display: block;
  }

  @media (max-width: 768px) {
    #snc-horizontal-scroll-{{ section.id }} {
      height: auto;
    }
    .snc-horizontal-scroll--sticky {
      position: relative;
      height: auto;
      overflow: visible;
    }
    .snc-horizontal-scroll--track {
      flex-direction: column;
      width: 100%;
      height: auto;
      transform: none !important;
    }
    .snc-horizontal-scroll--slide {
      width: 100%;
      height: auto;
      padding: 60px 0;
      display: block;
    }
    .snc-horizontal-scroll--container {
      height: auto;
      padding: 0 20px;
    }
    .snc-horizontal-scroll--content {
      position: relative;
      left: auto;
      bottom: auto;
      gap: 40px;
      margin-top: 40px;
      margin-bottom: 0px;
      transform: none;
      min-height: 0 !important;
    }
    .snc-horizontal-scroll--image {
      position: relative;
      width: 100%;
      height: 400px !important;
      transform: none !important;
      top: auto !important;
      bottom: auto !important;
    }
    .slide-type-2, .slide-type-3 {
      width: 100%;
    }
    .slide-type-2 .snc-horizontal-scroll--gallery {
      position: relative;
      flex-direction: column;
      transform: none;
      top: auto;
      width: 100%;
      height: auto;
      right: 0;
    }
    .slide-type-2 .snc-hs--img-container-1,
    .slide-type-2 .snc-hs--img-container-2 {
      width: 100%;
      height: 400px;
    }
    .slide-type-3 .snc-horizontal-scroll--gallery {
      position: relative;
      flex-direction: column;
      transform: none;
      top: auto;
      width: 100%;
      height: auto;
      right: 0;
    }
    .slide-type-3 .snc-hs--img-container-1,
    .slide-type-3 .snc-hs--img-container-2,
    .slide-type-3 .snc-hs--img-container-3 {
      width: 100%;
      height: 400px;
    }

    .slide-type-4 .snc-horizontal-scroll--content {
      height: auto;
      max-width: 100%;
      justify-content: flex-start;
      padding-top: 10px;
    }

    .slide-type-4.snc-horizontal-scroll--slide {
      display: flex;
      flex-direction: column;
      height: 100vh;
      min-height: 100vh;
      padding: 0;
    }

    .slide-type-4 .snc-horizontal-scroll--container {
      order: 1;
    }

    .slide-type-4 .snc-hs--type4-macro {
      order: 2;
    }

    .snc-hs--type4-macro {
      position: relative;
      width: 100%;
      height: 420px;
      transform: none;
      margin-top: auto;
      margin-bottom: 0;
    }

    .snc-hs--type4-macro img {
      object-position: center bottom;
    }
  }
</style>

<div class="snc-horizontal-scroll--wrapper" id="snc-horizontal-scroll-{{ section.id }}">
  <div class="snc-horizontal-scroll--sticky">
    <div class="snc-horizontal-scroll--track">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'slide_type_1' %}
            <div class="snc-horizontal-scroll--slide slide-type-1" {{ block.shopify_attributes }}>
              <div class="snc-horizontal-scroll--image">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <div class="snc-horizontal-scroll--container">
                <div class="snc-horizontal-scroll--content" style="max-width: {{ block.settings.content_max_width }}px;{% if block.settings.text_container_height > 0 %} --snc-hs-text-min-height: {{ block.settings.text_container_height }}px;{% endif %} --snc-hs-text-offset-y: {{ block.settings.text_offset_y | default: 0 }}px;">
                  <h2 class="snc-hs--title" style="color: {{ block.settings.title_color }}; font-size: {{ block.settings.title_size }}px;">{{ block.settings.title }}</h2>
                  <div class="snc-hs--text" style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px;">{{ block.settings.text }}</div>
                </div>
              </div>
            </div>
          {% when 'slide_type_2' %}
            <div class="snc-horizontal-scroll--slide slide-type-2" {{ block.shopify_attributes }}>
              <div class="snc-horizontal-scroll--gallery">
                <div class="snc-hs--img-container-1">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="snc-hs--img-container-2">
                  {% if block.settings.image_2 != blank %}
                    {{ block.settings.image_2 | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </div>
              </div>
              <div class="snc-horizontal-scroll--container">
                <div class="snc-horizontal-scroll--content" style="max-width: {{ block.settings.content_max_width }}px;{% if block.settings.text_container_height > 0 %} --snc-hs-text-min-height: {{ block.settings.text_container_height }}px;{% endif %} --snc-hs-text-offset-y: {{ block.settings.text_offset_y | default: 0 }}px;">
                  <div class="snc-hs--header-group">
                    <p class="snc-hs--subtitle" style="color: {{ block.settings.subtitle_color }}; font-size: {{ block.settings.subtitle_size }}px;">{{ block.settings.subtitle }}</p>
                    <h2 class="snc-hs--title" style="color: {{ block.settings.title_color }}; font-size: {{ block.settings.title_size }}px;">{{ block.settings.title }}</h2>
                  </div>
                  <div class="snc-hs--text" style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px;">{{ block.settings.text }}</div>
                </div>
              </div>
            </div>
          {% when 'slide_type_3' %}
            <div class="snc-horizontal-scroll--slide slide-type-3" {{ block.shopify_attributes }}>
              <div class="snc-horizontal-scroll--gallery">
                <div class="snc-hs--img-container-1">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="snc-hs--img-container-2">
                  {% if block.settings.image_2 != blank %}
                    {{ block.settings.image_2 | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="snc-hs--img-container-3">
                  {% if block.settings.image_3 != blank %}
                    {{ block.settings.image_3 | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </div>
              </div>
              <div class="snc-horizontal-scroll--container">
                <div class="snc-horizontal-scroll--content" style="max-width: {{ block.settings.content_max_width }}px;{% if block.settings.text_container_height > 0 %} --snc-hs-text-min-height: {{ block.settings.text_container_height }}px;{% endif %} --snc-hs-text-offset-y: {{ block.settings.text_offset_y | default: 0 }}px;">
                  <div class="snc-hs--header-group">
                    <p class="snc-hs--subtitle" style="color: {{ block.settings.subtitle_color }}; font-size: {{ block.settings.subtitle_size }}px;">{{ block.settings.subtitle }}</p>
