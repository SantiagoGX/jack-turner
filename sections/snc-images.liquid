{% schema %}
{
  "name": "SNC Images",
  "class": "section--snc-images",
  "settings": [
    {
      "type": "header",
      "content": "Configuración General"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo de la sección",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen Superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margen Inferior",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Ancho máximo del contenido",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Diseño de Cuadrícula"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columnas en escritorio",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columnas en móvil",
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Espacio entre imágenes",
      "default": 20
    },
    {
      "type": "header",
      "content": "Estilo de Imágenes"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Relación de aspecto",
      "options": [
        { "value": "auto", "label": "Natural (Auto)" },
        { "value": "1/1", "label": "Cuadrado (1:1)" },
        { "value": "3/4", "label": "Retrato (3:4)" },
        { "value": "4/3", "label": "Paisaje (4:3)" },
        { "value": "16/9", "label": "Panorámico (16:9)" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Ajuste de imagen",
      "info": "Solo aplica si se selecciona una relación de aspecto fija.",
      "options": [
        { "value": "cover", "label": "Cubrir (Recortar)" },
        { "value": "contain", "label": "Contener (Sin recortar)" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Redondeo de bordes",
      "default": 8
    },
    {
      "type": "header",
      "content": "Estilo de Texto"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Color de la leyenda",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "caption_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de fuente de la leyenda",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Imagen",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 10,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Ancho de la imagen",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alineación",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Derecha" }
          ],
          "default": "center"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (Opcional)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Leyenda (Opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNC Images",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}

<style>
  #snc-images-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.margin_top }}px;
    padding-bottom: {{ section.settings.margin_bottom }}px;
    {% if section.settings.full_width %}
      width: 100vw;
      position: relative;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
    {% endif %}
  }

  #snc-images-{{ section.id }} .snc-images--container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    {% if section.settings.full_width %}
      max-width: 100%;
      padding: 0;
    {% endif %}
  }

  #snc-images-{{ section.id }} .snc-images--grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  .snc-images--item {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .snc-images--link {
    display: block;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  #snc-images-{{ section.id }} .snc-images--media {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
    {% if section.settings.image_ratio != 'auto' %}
      aspect-ratio: {{ section.settings.image_ratio }};
    {% endif %}
  }

  #snc-images-{{ section.id }} .snc-images--img {
    width: 100%;
    height: 100%;
    display: block;
    {% if section.settings.image_ratio != 'auto' %}
      object-fit: {{ section.settings.image_fit }};
      position: absolute;
      top: 0;
      left: 0;
    {% else %}
      height: auto;
    {% endif %}
  }

  #snc-images-{{ section.id }} .snc-images--caption {
    margin-top: 8px;
    font-size: {{ section.settings.caption_size }}px;
    color: {{ section.settings.caption_color }};
    text-align: center;
  }

  @media (max-width: 768px) {
    #snc-images-{{ section.id }} .snc-images--grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
  }
</style>

<div id="snc-images-{{ section.id }}" class="snc-images--root">
  <div class="snc-images--container">
    <div class="snc-images--grid">
      {% for block in section.blocks %}
        {% case block.type %}
        {% when 'image' %}
        {%- liquid
          assign img_align = 'center'
          if block.settings.alignment == 'left'
            assign img_align = 'flex-start'
          elsif block.settings.alignment == 'right'
            assign img_align = 'flex-end'
          endif
        -%}
        <div class="snc-images--item" {{ block.shopify_attributes }} style="align-items: {{ img_align }};">
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="snc-images--link" style="width: {{ block.settings.image_width }}%;">
          {% endif %}
          
          <div class="snc-images--media" style="width: {% if block.settings.link != blank %}100%{% else %}{{ block.settings.image_width }}%{% endif %};">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: 
                loading: 'lazy', 
                class: 'snc-images--img', 
                widths: '300, 600, 900, 1200' 
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'snc-images--img' }}
            {% endif %}
          </div>

          {% if block.settings.caption != blank %}
            <div class="snc-images--caption">{{ block.settings.caption }}</div>
          {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>