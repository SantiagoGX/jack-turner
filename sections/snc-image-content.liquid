{% schema %}
{
  "name": "SNC Horizontal List",
  "class": "section--snc-horizontal-list",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Detalles"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Información Importante"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Elemento de lista",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título del elemento",
          "default": "Característica"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (Hover)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto del elemento",
          "default": "<p>Descripción detallada de este punto.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNC Horizontal List",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .snc-horizontal-list {
    padding: 60px 100px;
    max-width: 1512px;
    margin: 0 auto;
    width: 100%;
    background: #fff;
    box-sizing: border-box;
    position: relative;
    z-index: 0;
  }

  .snc-hl__header {
    text-align: left;
    margin-bottom: 45px;
    max-width: 800px;
  }

  .snc-hl__subtitle {
    font-family: var(--font-main);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
    color: #000000;
    display: block;
  }

  .snc-hl__title {
    font-family: var(--font-main);
    font-size: 36px;
    line-height: 1.1;
    margin: 0;
    color: #000000;
    font-weight: 400;
  }

  .snc-hl__list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #e5e5e5;
  }

  .snc-hl__item {
    position: relative;
    z-index: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 40px 0;
    border-bottom: 1px solid #e5e5e5;
    gap: 40px;
  }

  .snc-hl__item:hover {
    z-index: 2;
  }

  .snc-hl__item-title {
    flex: 0 0 30%;
    font-family: var(--font-main);
    font-size: 18px;
    margin: 0;
    color: #000000;
    line-height: 1.3;
    font-weight: 600;
  }

  .snc-hl__item-image {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    height: 240px;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 10;
  }

  .snc-hl__item:hover .snc-hl__item-image {
    opacity: 1;
  }

  .snc-hl__item-image img {
    border-radius: 0;
  }

  .snc-hl__item-text {
    flex: 0 0 40%;
    font-family: var(--font-main);
    font-size: 14px;
    line-height: 1.6;
    color: #666;
  }
  
  .snc-hl__item-text p {
    margin: 0;
  }
  
  .snc-hl__item-text p + p {
    margin-top: 10px;
  }

  @media (max-width: 768px) {
    .snc-horizontal-list {
      padding: 60px 20px;
    }
    .snc-hl__title {
      font-size: 28px;
    }
    .snc-hl__item {
      flex-direction: column;
      gap: 12px;
      padding: 20px 0;
    }
    .snc-hl__item-title {
      width: 100%;
      font-size: 15px;
      order: 2;
    }
    .snc-hl__item-image {
      position: static;
      display: block;
      width: 100%;
      height: auto;
      max-height: 160px;
      aspect-ratio: 4 / 3;
      opacity: 0;
      transform: translateY(10px) scale(0.98);
      transition: opacity 0.4s ease, transform 0.4s ease;
      order: 1;
      background: #f5f5f5;
      border-radius: 10px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      padding: 0;
    }
    .snc-hl__item-text {
      width: 100%;
      flex: 1 1 auto;
      order: 3;
      font-size: 14px;
      line-height: 1.5;
    }
    .snc-hl__item-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 10px;
      display: block;
    }
    .snc-hl__item.is-visible .snc-hl__item-image {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<div class="snc-horizontal-list">
  <div class="snc-hl__header">
    {%- if section.settings.subtitle != blank -%}
      <span class="snc-hl__subtitle">{{ section.settings.subtitle | escape }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="snc-hl__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
  </div>

  <div class="snc-hl__list">
    {%- for block in section.blocks -%}
      <div class="snc-hl__item" {{ block.shopify_attributes }} data-hl-item>
        <h3 class="snc-hl__item-title">{{ block.settings.title | escape }}</h3>
        <div class="snc-hl__item-image">
          {%- if block.settings.image != blank -%}
            <img 
              src="{{ block.settings.image | image_url: width: 400 }}" 
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- endif -%}
        </div>
        <div class="snc-hl__item-text">
          {{ block.settings.text }}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('[data-hl-item]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    items.forEach(item => observer.observe(item));

    if (window.matchMedia('(min-width: 769px)').matches) {
      items.forEach(item => {
        const img = item.querySelector('.snc-hl__item-image');
        item.addEventListener('mousemove', e => {
          const rect = item.getBoundingClientRect();
          img.style.transform = `translate(${e.clientX - rect.left}px, ${e.clientY - rect.top}px) translate(-50%, -50%)`;
        });
      });
    }
  });
</script>
