  assign mobile_cart_body_padding_horizontal = section.settings.mobile_cart_body_padding_horizontal | default: 15
  assign mobile_cart_footer_padding_vertical = section.settings.mobile_cart_footer_padding_vertical | default: 15
  assign mobile_cart_footer_padding_horizontal = section.settings.mobile_cart_footer_padding_horizontal | default: 15
  assign cart_qty_icon_size = section.settings.cart_qty_icon_size | default: 16
  assign cart_qty_border_width = section.settings.cart_qty_border_width | default: 1
  assign cart_qty_border_radius = section.settings.cart_qty_border_radius | default: 4
  assign cart_full_height = section.settings.cart_full_height
  assign cart_switcher_font_size = section.settings.cart_switcher_font_size | default: 16
  assign cart_switcher_active_color = section.settings.cart_switcher_active_color | default: '#0d0d0d'
