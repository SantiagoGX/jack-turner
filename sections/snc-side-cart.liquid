  assign cart_item_title_font_size = section.settings.cart_item_title_font_size | default: 16
  assign cart_item_title_color = section.settings.cart_item_title_color | default: '#333333'
  assign cart_checkout_btn_bg = section.settings.cart_checkout_btn_bg | default: '#0d0d0d'
  assign cart_checkout_btn_text = section.settings.cart_checkout_btn_text | default: '#FFFFFF'
  assign cart_checkout_btn_label = section.settings.cart_checkout_btn_label | default: 'CHECKOUT'
  assign cart_item_price_color = section.settings.cart_item_price_color | default: '#000000'
  assign cart_item_price_weight = section.settings.cart_item_price_weight | default: 700
  assign cart_width = section.settings.cart_width | default: 30
  assign cart_gap = section.settings.cart_gap | default: 20
  assign cart_empty_btn_1_text = section.settings.cart_empty_button_1_text
  assign cart_empty_btn_1_link = section.settings.cart_empty_button_1_link
  assign cart_empty_btn_2_text = section.settings.cart_empty_button_2_text
  assign cart_empty_btn_2_link = section.settings.cart_empty_button_2_link
  assign cart_empty_btn_1_bg = section.settings.cart_empty_button_1_bg_color | default: '#0d0d0d'
  assign cart_empty_btn_1_text_color = section.settings.cart_empty_button_1_text_color | default: '#FFFFFF'
  assign cart_empty_btn_2_bg = section.settings.cart_empty_button_2_bg_color | default: '#FFFFFF'
  assign cart_empty_btn_2_text_color = section.settings.cart_empty_button_2_text_color | default: '#0d0d0d'
  assign cart_empty_title = section.settings.cart_empty_title
  assign cart_empty_title_style = section.settings.cart_empty_title_style | default: 'h3'
  assign cart_empty_text = section.settings.cart_empty_text
  assign cart_empty_text_style = section.settings.cart_empty_text_style | default: 'body'
  
  assign cart_title_fallback_text = section.settings.cart_title_fallback_text | default: 'Your cart'
  assign cart_title_fallback_size = section.settings.cart_title_fallback_size | default: 16
  assign cart_title_fallback_color = section.settings.cart_title_fallback_color | default: '#0d0d0d'
  assign cart_title_fallback_weight = section.settings.cart_title_fallback_weight | default: 600
  assign cart_title_fallback_bg = section.settings.cart_title_fallback_bg | default: '#f0f0f0'

  assign cart_guarantee_text = section.settings.cart_guarantee_text | default: 'Your purchase is protected by our service policy.'
  assign cart_guarantee_icon = section.settings.cart_guarantee_icon
  assign cart_payment_icons = section.settings.cart_payment_icons | default: 'visa,master,american_express,paypal'

  # Wishlist Logic
  assign favorites_block = section.blocks | where: 'type', 'favorites' | first
  assign wishlist_block_count = 0
  if favorites_block
    assign wishlist_block_count = 1
    assign wishlist_details_gap = favorites_block.settings.wishlist_details_gap | default: 6
    assign wishlist_add_button_text = favorites_block.settings.wishlist_add_button_text | default: 'Add'
    assign wishlist_layout = favorites_block.settings.wishlist_layout | default: 'grid'
    assign wishlist_title_text = favorites_block.settings.wishlist_title_text | default: 'Your wishlist'
    assign wishlist_title_size = favorites_block.settings.wishlist_title_size | default: 20
    assign wishlist_title_color = favorites_block.settings.wishlist_title_color | default: '#0d0d0d'
    assign wishlist_title_margin_bottom = favorites_block.settings.wishlist_title_margin_bottom | default: 8
    assign wishlist_title_margin_top = favorites_block.settings.wishlist_title_margin_top | default: 0
    assign wishlist_description_text = favorites_block.settings.wishlist_description_text | default: 'Find the products you love here.'
    assign wishlist_description_size = favorites_block.settings.wishlist_description_size | default: 14
    assign wishlist_description_color = favorites_block.settings.wishlist_description_color | default: '#666666'
    assign wishlist_content_grid_gap = favorites_block.settings.wishlist_content_grid_gap | default: 12
    assign wishlist_items_margin_bottom = favorites_block.settings.wishlist_items_margin_bottom | default: 20
    assign wishlist_card_bg = favorites_block.settings.wishlist_card_bg | default: '#ffffff'
    assign wishlist_card_radius = favorites_block.settings.wishlist_card_radius | default: 14
    assign wishlist_card_padding = favorites_block.settings.wishlist_card_padding | default: 12
    assign wishlist_image_radius = favorites_block.settings.wishlist_image_radius | default: 8
