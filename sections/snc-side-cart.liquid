    if wishlist_card_border_enabled
      assign wishlist_card_border = '1px solid ' | append: wishlist_card_border_color
    else
      assign wishlist_card_border = 'none'
    endif
    if wishlist_card_shadow_enabled
      assign wishlist_card_shadow_value = wishlist_card_shadow
    else
      assign wishlist_card_shadow_value = 'none'
    endif
  else
    assign wishlist_details_gap = 6
    assign wishlist_add_button_text = 'Add'
    assign wishlist_layout = 'grid'
    assign wishlist_title_text = 'Your wishlist'
    assign wishlist_title_size = 20
    assign wishlist_title_color = '#0d0d0d'
    assign wishlist_title_margin_bottom = 8
    assign wishlist_title_margin_top = 0
    assign wishlist_description_text = 'Find the products you love here.'
    assign wishlist_description_size = 14
    assign wishlist_description_color = '#666666'
    assign wishlist_content_grid_gap = 12
    assign wishlist_items_margin_bottom = 20
    assign wishlist_card_bg = '#ffffff'
    assign wishlist_card_radius = 14
    assign wishlist_card_padding = 12
    assign wishlist_image_radius = 8
    assign wishlist_card_border = 'none'
    assign wishlist_card_shadow_value = 'none'
  endif

  assign wishlist_bg_enabled = settings.global_wishlist_bg_enabled
  assign wishlist_bg_color = settings.global_wishlist_bg_color | default: '#FFFFFF'
  assign wishlist_radius = settings.global_wishlist_radius | default: 0
  assign wishlist_padding = settings.global_wishlist_padding | default: 8
  assign wishlist_size = settings.global_wishlist_size | default: 40

  assign wishlist_icon_version = settings.global_wishlist_icon_version | default: 'dark'
  if wishlist_icon_version == 'light'
    assign global_icon_wishlist = settings.global_icon_wishlist_light
  else
    assign global_icon_wishlist = settings.global_icon_wishlist_dark
