{%- liquid
  assign cart_tab_label = section.settings.cart_tab_label | default: 'Cart'
  assign wishlist_tab_label = section.settings.wishlist_tab_label | default: 'Wishlist'
  assign cart_empty_image = section.settings.cart_empty_image
  assign cart_empty_width = section.settings.cart_empty_image_width | default: 185
  assign cart_border_radius = section.settings.cart_border_radius | default: 10
  assign cart_side_margin = section.settings.cart_side_margin | default: 10
  assign cart_item_image_radius = section.settings.cart_item_image_radius | default: 4
  assign cart_header_padding_vertical = section.settings.cart_header_padding_vertical | default: 20
  assign cart_header_padding_horizontal = section.settings.cart_header_padding_horizontal | default: 20
  assign cart_footer_padding_vertical = section.settings.cart_footer_padding_vertical | default: 20
  assign cart_footer_padding_horizontal = section.settings.cart_footer_padding_horizontal | default: 20
  assign cart_body_padding_vertical = section.settings.cart_body_padding_vertical | default: 20
  assign cart_body_padding_horizontal = section.settings.cart_body_padding_horizontal | default: 20
