    "snc_reviews_UwxYRj": {
      "type": "snc-reviews",
      "blocks": {
        "review_yJeLBQ": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/0c3407c1-e807-4045-a29c-5a37a365f871.jpg",
            "title": "Santiago, Miami FL",
            "text": "I’ve had the Meridian on my wrist for a few days now and I can honestly say it exceeded my expectations. The first thing I noticed was how clean and well-balanced the design is—it looks even better in person than it does online.\nIt’s super comfortable and sits perfectly on the wrist, especially with a dress shirt. I’ve already gotten a couple of compliments at work, which never really happens with my other watches.",
            "rating": 5
          }
        },
        "review_GMFDQD": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/Resized_20250627_163424.jpg",
            "title": "Lucien - Provence-Alpes-Côte d'Azur - France",
            "text": "C’est de loin la plus belle montre de ma collection actuelle. Tous mes amis passionnés d’horlogerie pensent que je l’ai payée très cher, et je l’adore.",
            "rating": 5
          }
        },
        "review_jFQBtD": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/1014F46B-F467-45C6-B745-12A655402EDC.jpg",
            "title": "Frankie G- Chelsea, NY",
            "text": "Most dive watches look the same but the Tsunami has its own DNA. I always have people asking me what I'm wearing which is a great conversation starter.",
            "rating": 5
          }
        },
        "review_yary87": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/D44CE9BD-EA4E-4DC4-9FD8-3B298CBBFF7F.heic",
            "title": "Chandler - New York, NY",
            "text": "This timepiece reminds me of my Tissot-PRX that i bought last year but it's ten times better. I appreciate how thin it is, it's simplicity, sleek profile and the way that it shines when i move my wrist. I'm always getting compliments so i love the attention that it gets. I just genuinely adore this watch. My only issue with them is that the watches are made in small batches so on two occasions, I've missed out on pieces that had caught my eye.",
            "rating": 5
          }
        },
        "review_mc6Ww9": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/image_81f19efe-3a80-4046-9f93-8df7b2f0e368.jpg",
            "title": "Armando - Monterrey, Mexico",
            "text": "Realmente amo mi nuevo reloj. Lo uso todos los días y actualmente estoy ahorrando para comprar otro reloj de estos chicos.",
            "rating": 5
          }
        },
        "review_zcHyhy": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/Facetune_23-07-2023-12-38-33-compressed.jpg",
            "title": "Steven - Morristown, NJ",
            "text": "Recently bought my watch, and I'm impressed by the quality of the materials used. It's evident that a lot of thought and effort went into making this piece. While not the cheapest, it surpasses other brands offering more features for the price. Highly satisfied with my purchase.",
            "rating": 5
          }
        }
      },
