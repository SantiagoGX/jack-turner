{%- comment -%}
  Renders social icons for the burger menu
  Accepts:
  - block: {Object} Block object (desktop_drawer or mobile_drawer)
{%- endcomment -%}
{%- liquid
  assign fb_url = block.settings.social_facebook_url | default: settings.social_facebook_link
  assign fb_icon = block.settings.social_facebook_icon
  assign ig_url = block.settings.social_instagram_url | default: settings.social_instagram_link
  assign ig_icon = block.settings.social_instagram_icon
  assign tt_url = block.settings.social_tiktok_url | default: settings.social_tiktok_link
  assign tt_icon = block.settings.social_tiktok_icon
-%}
{%- if fb_url != blank -%}
  <a href="{{ fb_url }}" target="_blank" rel="noopener noreferrer" class="custom-header--burger-social-link" aria-label="Facebook">
    {%- if fb_icon != blank -%}<img src="{{ fb_icon | image_url: width: 60 }}" alt="Facebook" class="custom-header--burger-social-icon-img" width="26" height="26">
    {%- else -%}<img src="{{ 'ic_baseline-facebook.svg' | asset_url }}" alt="Facebook" class="custom-header--burger-social-icon-img" width="26" height="26">{%- endif -%}
  </a>
{%- endif -%}
{%- if ig_url != blank -%}
  <a href="{{ ig_url }}" target="_blank" rel="noopener noreferrer" class="custom-header--burger-social-link" aria-label="Instagram">
    {%- if ig_icon != blank -%}<img src="{{ ig_icon | image_url: width: 60 }}" alt="Instagram" class="custom-header--burger-social-icon-img" width="26" height="26">
    {%- else -%}<img src="{{ 'mingcute_instagram-fill.svg' | asset_url }}" alt="Instagram" class="custom-header--burger-social-icon-img" width="26" height="26">{%- endif -%}
  </a>
{%- endif -%}
{%- if tt_url != blank -%}
  <a href="{{ tt_url }}" target="_blank" rel="noopener noreferrer" class="custom-header--burger-social-link" aria-label="TikTok">
    {%- if tt_icon != blank -%}<img src="{{ tt_icon | image_url: width: 60 }}" alt="TikTok" class="custom-header--burger-social-icon-img" width="26" height="26">
    {%- else -%}<img src="{{ 'lineicons_tiktok-alt.svg' | asset_url }}" alt="TikTok" class="custom-header--burger-social-icon-img" width="26" height="26">{%- endif -%}
  </a>
{%- endif -%}