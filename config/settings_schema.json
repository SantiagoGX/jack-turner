  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo_dark",
        "label": "Logo Obscuro",
        "info": "Para fondos claros"
      },
      {
        "type": "image_picker",
        "id": "logo_light",
        "label": "Logo Claro",
        "info": "Para fondos oscuros"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "unit": "px",
        "label": "Ancho del logo",
        "default": 135
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Texto del logo (Fallback)",
        "default": "KWARA XL"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Recommended: 32×32px or 64×64px .png or .ico file"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
